        <script>
            (function () {
                'use strict';

                const maximumFiles = 10;
                const maximumFileSize = 20 * 1024 * 1024;
                const allowedExtensions = ['pdf', 'doc', 'docx', 'jpg', 'jpeg', 'png', 'xls', 'xlsx'];
                let selectedQueryFiles = new DataTransfer();

                function fileKey(file) {
                    return [file.name, file.size, file.lastModified].join('|');
                }

                function safeText(value) {
                    return String(value || '')
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#039;');
                }

                function addQueryFiles(files) {
                    const existing = new Set(Array.from(selectedQueryFiles.files).map(fileKey));
                    const rejected = [];

                    Array.from(files || []).forEach(function (file) {
                        const extension = (file.name.split('.').pop() || '').toLowerCase();
                        const key = fileKey(file);

                        if (existing.has(key)) return;
                        if (!allowedExtensions.includes(extension)) {
                            rejected.push(file.name + ' is not a supported file type.');
                            return;
                        }
                        if (file.size > maximumFileSize) {
                            rejected.push(file.name + ' is larger than 20 MB.');
                            return;
                        }
                        if (selectedQueryFiles.files.length >= maximumFiles) {
                            rejected.push('Only 10 supporting documents can be selected.');
                            return;
                        }

                        selectedQueryFiles.items.add(file);
                        existing.add(key);
                    });

                    if (rejected.length) {
                        alert(Array.from(new Set(rejected)).join('\n'));
                    }
                }

                function renderQueryFiles() {
                    const input = document.getElementById('objectionEvidenceInput');
                    const list = document.getElementById('objectionFileList');
                    const count = document.getElementById('objectionFileCount');
                    const fill = document.getElementById('objectionFileFill');
                    const dropzone = document.getElementById('objectionDropzone');
                    if (!input || !list || !count || !fill || !dropzone) return;

                    input.files = selectedQueryFiles.files;
                    const total = selectedQueryFiles.files.length;

                    count.textContent = total + ' of ' + maximumFiles + ' files added';
                    fill.style.width = Math.min((total / maximumFiles) * 100, 100) + '%';
                    fill.classList.toggle('full', total >= maximumFiles);
                    dropzone.classList.toggle('full', total >= maximumFiles);
                    list.innerHTML = '';

                    Array.from(selectedQueryFiles.files).forEach(function (file, index) {
                        const item = document.createElement('div');
                        item.className = 'obj-ev-file';
                        item.innerHTML =
                            '<i class="fa-solid fa-file"></i>' +
                            '<span class="obj-ev-name">' + safeText(file.name) + '</span>' +
                            '<span class="obj-ev-size">' + (file.size / 1024 / 1024).toFixed(2) + ' MB</span>' +
                            '<button type="button" class="obj-ev-remove" data-remove-query-file="' + index + '" title="Remove file">' +
                            '<i class="fa-solid fa-xmark"></i></button>';
                        list.appendChild(item);
                    });
                }

                function initialiseQueryUpload() {
                    const input = document.getElementById('objectionEvidenceInput');
                    const browse = document.getElementById('objectionBrowseFiles');
                    const dropzone = document.getElementById('objectionDropzone');
                    const list = document.getElementById('objectionFileList');
                    if (!input || !browse || !dropzone || !list) return;

                    function openBrowser(event) {
                        if (event) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        input.click();
                    }

                    browse.addEventListener('click', openBrowser);
                    dropzone.addEventListener('click', openBrowser);
                    dropzone.addEventListener('keydown', function (event) {
                        if (event.key === 'Enter' || event.key === ' ') openBrowser(event);
                    });
                    dropzone.addEventListener('dragover', function (event) {
                        event.preventDefault();
                        dropzone.classList.add('dragover');
                    });
                    dropzone.addEventListener('dragleave', function () {
                        dropzone.classList.remove('dragover');
                    });
                    dropzone.addEventListener('drop', function (event) {
                        event.preventDefault();
                        dropzone.classList.remove('dragover');
                        addQueryFiles(event.dataTransfer && event.dataTransfer.files);
                        renderQueryFiles();
                    });
                    input.addEventListener('change', function () {
                        addQueryFiles(input.files);
                        renderQueryFiles();
                    });
                    list.addEventListener('click', function (event) {
                        const button = event.target.closest('[data-remove-query-file]');
                        if (!button) return;

                        const removeIndex = Number(button.dataset.removeQueryFile);
                        const replacement = new DataTransfer();
                        Array.from(selectedQueryFiles.files).forEach(function (file, index) {
                            if (index !== removeIndex) replacement.items.add(file);
                        });
                        selectedQueryFiles = replacement;
                        renderQueryFiles();
                    });

                    renderQueryFiles();
                }

                function initialiseAutomaticSignature() {
                    const canvas = document.getElementById('signature');
                    const signatureData = document.getElementById('SignatureDataUrl');
                    const clear = document.getElementById('Clear');
                    const status = document.getElementById('signatureStatus');
                    const submit = document.getElementById('submitForm');
                    if (!canvas || !signatureData || !clear || !status) return;

                    function canvasHasInk() {
                        const pixels = canvas.getContext('2d')
                            .getImageData(0, 0, canvas.width, canvas.height).data;
                        for (let index = 3; index < pixels.length; index += 4) {
                            if (pixels[index] !== 0) return true;
                        }
                        return false;
                    }

                    function captureSignature() {
                        window.requestAnimationFrame(function () {
                            if (!canvasHasInk()) return;
                            signatureData.value = canvas.toDataURL('image/png');
                            signatureData.dispatchEvent(new Event('change', { bubbles: true }));
                            status.textContent = 'Signature captured';
                            status.style.color = '#0f766e';
                            canvas.style.borderColor = '#006570';
                            if (submit) submit.disabled = false;
                        });
                    }

                    canvas.addEventListener('mouseup', captureSignature);
                    canvas.addEventListener('touchend', captureSignature);
                    canvas.addEventListener('pointerup', captureSignature);

                    clear.addEventListener('click', function () {
                        canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);
                        signatureData.value = '';
                        status.textContent = 'No signature drawn';
                        status.style.color = '#6b6b6b';
                        if (submit) submit.disabled = true;
                    });
                }

                document.addEventListener('DOMContentLoaded', function () {
                    initialiseQueryUpload();
                    initialiseAutomaticSignature();
                });
            })();
        </script>
