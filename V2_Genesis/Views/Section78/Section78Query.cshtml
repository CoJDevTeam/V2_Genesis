                        </div>
                    </div>

                    <!-- Right Column: CHANGES REQUESTED BY OWNER -->
                    <div style="flex: 1; min-width: 300px;">
                        <div style="padding: 20px; border: 3px solid #e6b000; border-radius: 12px; background: #fff9e6; box-shadow: 0 6px 20px rgba(230, 176, 0, 0.2);">
                            <h6 style="margin-top: 0; margin-bottom: 20px; color: white; background: #e6b000; padding: 12px 15px; border-radius: 8px; text-align: center; font-size: 16px; font-weight: 700; letter-spacing: 0.5px; box-shadow: 0 3px 10px rgba(230, 176, 0, 0.3);"><strong>6.2 CHANGES REQUESTED BY OWNER</strong></h6>

                            <span id="new_change_invalid" style="display: none; color: red; font-size: 12px;">Please fill at least one of the contact details fields.</span>

                            <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #d4a000; font-size: 13px; text-transform: uppercase; letter-spacing: 0.3px;">DESCRIPTION OF THE PROPERTY/UNIT</label>
                            <input style="width: 100%; padding: 12px 16px; margin-bottom: 15px; border: 2px solid #e6b000; border-radius: 8px; background: white; font-size: 14px; color: #333; transition: all 0.3s; box-shadow: 0 2px 8px rgba(230, 176, 0, 0.1);" id="NewPropDesc" class="form-control" maxlength="100" type="text" onpaste="return false;" ondrop="return false;" asp-for="New_Property_Description">

                            <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #d4a000; font-size: 13px; text-transform: uppercase; letter-spacing: 0.3px;">CATEGORY</label>
                                <select asp-for="New_Category" id="NewCat" style="width: 100%; padding: 12px 16px; margin-bottom: 15px; border: 2px solid #e6b000; border-radius: 8px; background: white; font-size: 14px; color: #333; transition: all 0.3s; box-shadow: 0 2px 8px rgba(230, 176, 0, 0.1); cursor: pointer;">
