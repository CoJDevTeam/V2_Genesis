                            <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #d4a000; font-size: 13px; text-transform: uppercase; letter-spacing: 0.3px;">PHYSICAL ADDRESS/DOOR NO./FLAT NO.</label>
                            <input style="width: 100%; padding: 12px 16px; margin-bottom: 15px; border: 2px solid #e6b000; border-radius: 8px; background: white; font-size: 14px; color: #333; transition: all 0.3s; box-shadow: 0 2px 8px rgba(230, 176, 0, 0.1);" id="NewAddress" class="form-control" maxlength="100" type="text" onpaste="return false;" ondrop="return false;" asp-for="New_Address">

