                <div class="obj-ev-track"><div class="obj-ev-fill" id="objectionFileFill"></div></div>
            </div>
            <div class="obj-ev-list" id="objectionFileList"></div>
            <div class="obj-ev-note">
                <i class="fa-solid fa-circle-info"></i>
                Supported: PDF, Word, Excel, JPG, PNG &nbsp;|&nbsp;
                Max 10 files &nbsp;|&nbsp; Max 20 MB per file
            </div>

            <div>
             
          <button type="button" class="btn_pU btn obj-nav-btn obj-nav-btn-prev"><strong>Previous</strong></button>
            <button type="button" class="btn_nU btn obj-nav-btn obj-nav-btn-next"><strong>Next</strong></button>
            </div>
