                    <textarea style="width: 100%; padding: 15px; border: 2px solid #e6b000; border-radius: 8px; background: white; font-size: 14px; color: #333; resize: vertical; box-shadow: 0 2px 8px rgba(230, 176, 0, 0.1);" class="form-control" id="textarea" maxlength="500" asp-for="Objection_Reasons" rows="4" cols="150"></textarea>
