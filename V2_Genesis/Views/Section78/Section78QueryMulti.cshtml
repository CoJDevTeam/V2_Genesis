<div id="section7" style="display:flex;justify-content: center;">
    <div class="div7 obj-form-card">
        <div style="width:100%; margin:20px 0; padding:10px 0; position:relative;">
            <h4 class="obj-section-title" id="s_head"><strong>Section 7: Declaration</strong></h4>
            <div class="obj-step-divider">
                <div class="line"></div><div class="dot"></div><div class="line"></div>
            </div>
        </div>

        <div class="obj-section-bar"><span class="obj-bar-num">7.1</span><span>Declaration &amp; @_processNameUpper Details</span></div>

        <div class="obj-legal-box">
            <h6>
                @if (_isReview)
                {
                    @:This review concerns the outcome of a previously lodged Section 78 query. Please ensure that all information and supporting documents relevant to the requested review have been provided.
                }
                else
                {
                    @:This query is lodged in terms of Section 78. Please ensure that all information and supporting documents required by the Municipal Valuer have been provided.
                }
            </h6>
        </div>

        <div class="obj-declaration-row declaration-text">
            <span>I / WE</span>
            <input id="sign_obj" maxlength="80" required asp-for="Signature_Name"
                   type="text" onpaste="return false;" ondrop="return false;" placeholder="Full name(s)" />
            <span>hereby declare that the information and particulars supplied are true and correct.</span>
        </div>

        @if (_isAdmin)
        {
            <div id="capturer" class="obj-capturer-card">
                <div class="obj-capturer-icon"><i class="fa-solid fa-id-badge"></i></div>
                <div style="flex:1;">
                    <div class="obj-capturer-label">Captured by Windows Authenticator</div>
                    <div class="obj-capturer-name">@(!string.IsNullOrWhiteSpace(_fullName) ? _fullName : "Admin User")</div>
                    @if (!string.IsNullOrWhiteSpace(_adminPosition))
                    {
                        <div class="obj-capturer-sap">@_adminPosition</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_windowsUser))
                    {
                        <div class="obj-capturer-sap">Windows: @_windowsUser</div>
                    }
                </div>
                <div class="obj-capturer-sap">SAP: @_sapNumeric</div>
                <input type="hidden" id="sapNo" asp-for="Capturer" value="@_sapNumeric" />
                <input type="hidden" name="AdminCapturedFullName" value="@_fullName" />
                <input type="hidden" name="AdminCapturedPosition" value="@_adminPosition" />
                <input type="hidden" name="AdminCapturedWindowsUser" value="@_windowsUser" />
                <input type="hidden" name="AdminCapturedSapFull" value="@_sapFull" />
            </div>
        }
        else
        {
            <input type="hidden" asp-for="Capturer" value="" />
        }

        <input hidden class="form-control" id="signDate" required type="datetime-local" asp-for="Declaration_Date">

        <div class="obj-signature-card obj-auto-signature">
            <div class="obj-auto-signature-title">
                <i class="fa-solid fa-pen-nib"></i>
                Draw signature below <span class="req">*</span>
                <span style="font-weight:400;text-transform:none;color:#888;">(mouse or finger)</span>
            </div>
            <div class="obj-signature-canvas-wrap">
                <canvas width="598" height="160" id="signature"></canvas>
                <div class="obj-signature-line"></div>
                <div class="obj-signature-hint">Sign here</div>
            </div>
            <div class="obj-signature-controls">
                <button type="button" id="Clear" class="btn obj-signature-clear">
                    <i class="fa-solid fa-rotate-left"></i> Clear
                </button>
                <span id="signatureStatus">No signature drawn</span>
            </div>

            @* Hidden compatibility hooks retained for the original Multi script. *@
            <img width="598" height="160" id="savetarget" hidden="hidden" alt="" />
            <button type="button" id="accept" class="btn" hidden="hidden" tabindex="-1">Accept signature</button>
            <input type="text" onpaste="return false;" ondrop="return false;"
                   id="SignatureDataUrl" asp-for="Signature_Picture" hidden="hidden">
        </div>

        <div style="margin-top:18px;">
            <button type="button" class="btn_p7 btn obj-nav-btn obj-nav-btn-prev"><strong>Previous</strong></button>
            <button type="submit" class="btn obj-nav-btn obj-nav-btn-submit" disabled id="submitForm"
                    onclick="return showInput()"><i class="fa-solid fa-paper-plane"></i> <strong>Submit @_processName</strong></button>
        </div>
    </div>
</div>
