                            <td style="padding: 15px; font-size: 14px; color: #006570; font-weight: 700; text-align: center; border-right: 2px solid #e6b000;">

                                                         B
                        </td>
                         <td style="padding: 15px; font-size: 14px; color: #333; font-weight: 500; border-right: 2px solid #e6b000;">
                           
                            included in a municipality after the last general valuation;
                        </td>
