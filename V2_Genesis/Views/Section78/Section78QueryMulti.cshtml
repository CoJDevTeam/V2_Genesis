@{ Layout = "~/Views/Shared/_Legend_Layout.cshtml"; }

@section Styles {
    <link href="~/css/views/objection-form.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/property-search.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/searchpropertycss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/objection-form-css.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/genesis-forms.css" rel="stylesheet" asp-append-version="true" />
    <style>
        /* Multipurpose supporting documents — same interaction as Attributes. */
        .obj-ev-intro { margin: 0 0 16px; color: #6b7280; font: 12.5px/1.6 'Poppins', sans-serif; }
        .obj-ev-label { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; color: #006570; font: 700 11.5px 'Poppins', sans-serif; letter-spacing: .4px; text-transform: uppercase; }
        .obj-ev-label i { color: #e6b000; }
        .obj-ev-optional { color: #9a9a9a; font-weight: 400; text-transform: none; }

        .obj-ev-dropzone {
            margin-bottom: 12px;
            padding: 36px 24px;
            border: 2.5px dashed #e6b000;
            border-radius: 12px;
            background: #fff8dc;
            text-align: center;
            cursor: pointer;
            transition: border-color .15s, background .15s;
        }

        .obj-ev-dropzone:hover,
        .obj-ev-dropzone.dragover { border-color: #006570; background: #eef8f8; }
        .obj-ev-dropzone.full { opacity: .55; pointer-events: none; }
        .obj-ev-icon { margin-bottom: 8px; color: #006570; font-size: 36px; }
        .obj-ev-title { margin-bottom: 4px; color: #006570; font: 700 15px 'Poppins', sans-serif; }
        .obj-ev-sub { margin-bottom: 14px; color: #888; font: 12.5px 'Poppins', sans-serif; }

        .obj-ev-browse {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 20px;
            border: 0;
            border-radius: 8px;
            background: #006570;
            color: #fff;
            cursor: pointer;
            font: 700 13px 'Poppins', sans-serif;
        }

        #multipurposeEvidenceInput,
        #files { display: none; }

        .obj-ev-counter { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; color: #888; font: 12px 'Poppins', sans-serif; }
        .obj-ev-track { flex: 1; height: 5px; border-radius: 3px; background: #e8e8e8; }
        .obj-ev-fill { width: 0; height: 100%; border-radius: 3px; background: #006570; transition: width .25s; }
        .obj-ev-fill.full { background: #dc2626; }
        .obj-ev-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }

        .obj-ev-file {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 14px;
            border: 1px solid rgba(54,98,109,.2);
            border-radius: 8px;
            background: #eaf4f5;
            font-family: 'Poppins', sans-serif;
        }

        .obj-ev-file > i { color: #006570; }
        .obj-ev-name { flex: 1; overflow: hidden; color: #1a1a1a; font-size: 13px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
        .obj-ev-size { flex-shrink: 0; color: #666; font-size: 11.5px; }
        .obj-ev-remove { padding: 2px 5px; border: 0; background: transparent; color: #dc2626; cursor: pointer; font-size: 15px; }
        .obj-ev-note { color: #888; font: 12px 'Poppins', sans-serif; }
        .obj-ev-note i { margin-right: 4px; color: #006570; }

        /* Attributes-style signature: drawing is captured automatically. */
        .obj-auto-signature { padding: 14px; }
        .obj-auto-signature-title { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; font: 700 11px 'Poppins', sans-serif; letter-spacing: .5px; text-transform: uppercase; }
        .obj-auto-signature-title i { color: #e6b000; }
        .obj-signature-canvas-wrap { position: relative; max-width: 600px; border: 2px solid #006570; border-radius: 8px; background: #fff; }
        #signature { display: block; width: 100%; height: 160px; border: 0 !important; border-radius: 6px; cursor: crosshair; touch-action: none; }
        .obj-signature-line { position: absolute; right: 20px; bottom: 40px; left: 20px; border-bottom: 1px dashed #d0d0d0; pointer-events: none; }
        .obj-signature-hint { position: absolute; bottom: 20px; left: 20px; color: #ccc; font: 11px 'Poppins', sans-serif; pointer-events: none; }
        .obj-signature-controls { display: flex; align-items: center; gap: 12px; margin-top: 10px; }
        .obj-signature-clear { padding: 6px 16px; border: 1px solid #d0d0d0; border-radius: 6px; background: #f7f7f7; cursor: pointer; font: 700 12px 'Poppins', sans-serif; }
        #signatureStatus { color: #6b6b6b; font: 12px 'Poppins', sans-serif; }
    </style>
}
@using System.Text.RegularExpressions
@using V2_Genesis.Models
@model Prop_View_Model

@{
    var messageID2 = TempData["CurrentFilter_Id"];
    var messagePD = TempData["CurrentFilter_PD"];
    var messageCD = TempData["CurrentFilter_CD"];
    var messageLSA = TempData["CurrentFilter_LSA"];
    var messageRA = TempData["CurrentFilter_RA"];
    var messageMV = TempData["CurrentFilter_MV"];
    var messageON = TempData["CurrentFilter_ON"];
    var messageTN = TempData["CurrentFilter_TN"];
    var messagePID = TempData["CurrentFilter_P_ID"];
    var messagePI = TempData["CurrentFilter_P_I"];
    var messageUK = TempData["CurrentFilter_UK"];
    var messageVK = TempData["CurrentFilter_VK"];
    var messageS = TempData["CurrentFilter_S"];
    var messageProp = TempData["CurrentFilter_Prop"];
    var propertyType = TempData["PropertyType"];
    var obj_Appeal = TempData["ObjectionNum"];
    
}

@{
    TempData.Keep("CurrentFilter_Id");
}

@{
    TempData.Keep("CurrentFilter_PD");
    TempData.Keep("CurrentFilter_CD");
    TempData.Keep("CurrentFilter_LSA");
    TempData.Keep("CurrentFilter_RA");
    TempData.Keep("CurrentFilter_MV");
    TempData.Keep("CurrentFilter_ON");
    TempData.Keep("CurrentFilter_TN");
    TempData.Keep("CurrentFilter_P_ID");
    TempData.Keep("CurrentFilter_P_I");
    TempData.Keep("CurrentFilter_UK");
    TempData.Keep("CurrentFilter_VK");
    TempData.Keep("CurrentFilter_S");
    TempData.Keep("CurrentFilter_Prop");
    var messageEX = messageRA;
    var messageSA = messageLSA;
    TempData.Keep("CurrentFilter_LSA");
    TempData.Keep("CurrentFilter_RA");
    TempData.Keep("CurrentFilter_MV");
    TempData.Keep("ObjectionNum");
    TempData.Keep("PropertyType");

    bool _isAdmin = ViewBag.IsAdmin is bool adminFlag && adminFlag;
    string _fullName = ViewBag.AdminFullName?.ToString()
                       ?? TempData.Peek("AdminFullName")?.ToString()
                       ?? "";
    string _adminPosition = ViewBag.AdminPosition?.ToString()
                            ?? TempData.Peek("AdminPosition")?.ToString()
                            ?? "";
    string _sapFull = ViewBag.SapFull?.ToString()
                      ?? TempData.Peek("SapFull")?.ToString()
                      ?? "";
    string _sapNumeric = ViewBag.SapNumeric?.ToString()
                         ?? TempData.Peek("SapNumber")?.ToString()
                         ?? "";
    string _windowsUser = ViewBag.AdminWindowsUser?.ToString()
                          ?? TempData.Peek("AdminWindowsUser")?.ToString()
                          ?? "";

    string _reviewMode = new[]
    {
        ViewBag.ReviewStat?.ToString(),
        TempData.Peek("ReviewStat")?.ToString(),
        Context.Request.Query["qtype"].ToString(),
        Context.Request.Query["reviewStat"].ToString()
    }.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? "Q";

    bool _isReview =
        string.Equals(_reviewMode, "R", StringComparison.OrdinalIgnoreCase)
        || string.Equals(_reviewMode, "Review", StringComparison.OrdinalIgnoreCase);

    string _processName = _isReview ? "Review" : "Query";
    string _processNameUpper = _processName.ToUpperInvariant();
    string _processNameLower = _processName.ToLowerInvariant();
    string _applicantName = $"{_processName} Applicant";
    string _applicantNameUpper = _applicantName.ToUpperInvariant();
    string partyUpper = _isReview
        ? "THE PERSON LODGING THE REVIEW"
        : "THE PERSON LODGING THE QUERY";
    string propertyActionText = _processNameUpper;

    TempData.Keep("ReviewStat");
    TempData.Keep("AdminFullName");
    TempData.Keep("AdminPosition");
    TempData.Keep("SapFull");
    TempData.Keep("SapNumber");
    TempData.Keep("AdminWindowsUser");

}








<div class="obj-hero">
    <div class="obj-hero-inner">
        <div class="obj-hero-left">
            <div class="obj-hero-logo">
                <img src="~/images/joburg_logo.png" alt="City of Johannesburg" />
            </div>

            <div class="obj-hero-text">
                <div class="obj-hero-org">
                    City of Johannesburg · Valuation Services
                </div>

                <h1 class="obj-hero-title">
                    Lodging of a Section 78
                    <span>@_processName</span>
                </h1>

                <div class="obj-hero-sub">
                    @if (_isReview)
                    {
                        @:Review of the outcome of a previously lodged Section 78 Query
                    }
                    else
                    {
                        @:Query about a matter reflected in the valuation record for the property
                    }
                </div>
            </div>
        </div>

        <div class="obj-hero-right">
            <div class="obj-hero-type-badge">
                <i class="fa-solid @(_isReview
                    ? "fa-magnifying-glass-chart"
                    : "fa-file-magnifying-glass")"></i>

                Section 78 @_processName Form
            </div>

            @if (!string.IsNullOrWhiteSpace(messagePD?.ToString()))
            {
                <div class="obj-hero-prop">
                    <strong>Property:</strong> @messagePD
                </div>
            }
        </div>
    </div>

    <div class="obj-form-head">
        <span class="obj-form-head-label">Form Type</span>
        <span class="obj-form-head-title" id="form_head">
            FORM D: MULTIPURPOSE · SECTION 78 @_processNameUpper
        </span>
    </div>
</div>

<form id="myForm" method="post" enctype="multipart/form-data" asp-controller="Section78" asp-action="Section78Query" style="margin-left: 0px">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="reviewStat"
           id="reviewStat"
           value="@(_isReview ? "R" : "Q")" />

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert"></div>


    <div style="display:flex;justify-content:center;">
        <div class="obj-form-card" style="margin-top:12px;">
            <div class="obj-form-banner">
                <span class="obj-form-chip">
                    <i class="fa-solid @(_isReview ? "fa-magnifying-glass-chart" : "fa-file-magnifying-glass")"></i>
                    Section 78 @_processName Form
                </span>
                <h1>LODGING OF A SECTION 78 @_processNameUpper RELATING TO THE PROPERTY DESCRIBED BELOW</h1>
                <h2>CITY OF JOHANNESBURG · VALUATION SERVICES</h2>
            </div>

            <div class="obj-prop-header-card">
                <div class="obj-prop-header-eyebrow">
                    <i class="fa-solid @(_isReview ? "fa-magnifying-glass-chart" : "fa-file-magnifying-glass")"></i>
                    Section 78 @_processName Form &nbsp;·&nbsp; Valuation Record
                </div>
                <h3 class="obj-prop-header-title">
                    Description of Property in Respect of which the <span>@_processName</span> is Made
                </h3>
                <p class="obj-prop-header-sub">Complete a separate form for each property</p>
                <div class="obj-prop-header-pill">
                    <div class="obj-prop-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <div>
                        <span class="obj-prop-label">Property</span>
                        <span class="obj-prop-value">@messagePD</span>
                    </div>
                    <input value="@messagePD" type="hidden" name="Property_Desc" id="Property_Desc" asp-for="Property_Desc" />
                </div>
            </div>
        </div>
    </div>
    @{ TempData.Keep("AppealStatus"); }
    @{
        TempData.Keep("CurrentFilter_PD");
    }
