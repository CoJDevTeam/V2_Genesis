@using V2_Genesis.Helpers
@using V2_Genesis.Services.Implementations
@using V2_Genesis.Services.Interfaces
@inject IObjectionService ObjectionRules
@model V2_Genesis.Models.ViewModels.Dashboard.RollDetailViewModel
@functions {
    bool IsLisPropertySource(string? propertyFrom) =>
        string.Equals(propertyFrom?.Trim(), "LIS", StringComparison.OrdinalIgnoreCase);

    bool IsOmissionPropertySource(string? propertyFrom)
    {
        var value = propertyFrom?.Trim() ?? string.Empty;
        return value.Equals("Omission", StringComparison.OrdinalIgnoreCase) ||
               value.Equals("Omitted", StringComparison.OrdinalIgnoreCase) ||
               value.StartsWith("Omission_", StringComparison.OrdinalIgnoreCase) ||
               value.StartsWith("Omitted_", StringComparison.OrdinalIgnoreCase);
    }

    string GetPropertySourceLabel(string? propertyFrom, string currentRollName)
    {
        var value = propertyFrom?.Trim() ?? string.Empty;
        var normalised = value.Replace("-", "_").ToUpperInvariant();

        if (IsLisPropertySource(value))
            return "LIS";

        if (IsOmissionPropertySource(value))
            return $"Omitted from {currentRollName}";

        if (normalised.Contains("SUP1")) return "Supplementary Valuation Roll 1";
        if (normalised.Contains("SUP2")) return "Supplementary Valuation Roll 2";
        if (normalised.Contains("SUP3")) return "Supplementary Valuation Roll 3";
        if (normalised.Contains("SUP4")) return "Supplementary Valuation Roll 4";

        if (normalised is "GV23" or "OBJECTION" or "VALUATION_ROLL")
            return "Valuation Roll";

        return string.IsNullOrWhiteSpace(value) ? currentRollName : value;
    }
}
@{
    // Roll dashboard partial shared by the Client and Admin dashboards.
    var rollKey =
        Model.Roll.Source.Replace("_", "");

    var isAdminDashboard =
        Context.Request.Path.StartsWithSegments(
            "/admin");

    /*
     * Preserve the current workspace:
     *
     * Client
     *   -> dedicated roll dashboard page
     *
     * Admin
     *   -> Admin dashboard with the same roll selected
     */
    var rollReturnUrl =
        isAdminDashboard
            ? Url.Action(
                "Index",
                "Admin",
                new
                {
                    openRoll = Model.Roll.Source
                })
                ?? "/Admin?openRoll="
                   + Uri.EscapeDataString(
                       Model.Roll.Source ?? "")
            : Url.Action(
                "RollDetail",
                "Dashboard",
                new
                {
                    rollSource = Model.Roll.Source
                })
                ?? "/dashboard/roll-detail/"
                   + Uri.EscapeDataString(
                       Model.Roll.Source ?? "");
}

<style>
    .cd-source-value {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
        gap: .3rem;
    }

    .cd-source-badge {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        padding: .2rem .55rem;
        border: 1px solid rgba(0, 95, 110, .18);
        border-radius: 999px;
        font-size: .7rem;
        font-weight: 800;
        line-height: 1.2;
        white-space: nowrap;
    }

    .cd-source-badge--roll { background: #e7f1f3; color: #123a40; }
    .cd-source-badge--lis { background: #dff4f7; color: #006b78; }
    .cd-source-badge--omitted { background: #fff1d2; color: #7b5200; }
    .cd-source-context { color: #71808a; font-size: .72rem; line-height: 1.25; }
    .cd-source-dash { font-weight: 800; }
</style>

<!-- ── Roll info — dates, objection status, Search Property ─────────
     The client must always be able to see whether the objection
     window for this roll is open or closed, and must not be able to
     start a new objection once it's closed (unlike Admin, which can
     browse a roll regardless of period status). ────────────────── -->
<div class="cd-detail-roll-info">
    <div class="cd-detail-roll-info-left">
        <div class="cd-detail-roll-icon">
            <i class="fa-solid @(Model.Roll.IsQuery ? "fa-magnifying-glass-chart" : Model.Roll.IsGv ? "fa-landmark" : "fa-scroll")"></i>
        </div>
        <div>
            <h2 class="cd-detail-roll-name">
    @(Model.Roll.IsQuery
        ? "Section 78 Query/Review"
        : Model.Roll.Name)
</h2>
            <span class="cd-detail-roll-short">@Model.Roll.Short &nbsp;&middot;&nbsp; @Model.Roll.Main_Roll</span>
        </div>
    </div>

    <div class="cd-detail-roll-info-right">
        @if (!Model.Roll.IsQuery && Model.Dates is not null)
        {
            <span class="cd-detail-roll-dates">
                <i class="fa-solid fa-calendar-range"></i>
                @Model.Dates.OpenDate.ToString("dd MMM yyyy") – @Model.Dates.VisibleUntil.ToString("dd MMM yyyy")
            </span>
            <span class="cd-roll-badge cd-badge-@Model.PeriodStatus">
                @(Model.PeriodStatus == "active" ? "Objection Open" :
                  Model.PeriodStatus == "upcoming" ? "Opening Soon" :
                  "Objection Closed")
            </span>
        }
        else
        {
            <span class="cd-roll-badge cd-badge-open">OPEN</span>
        }

        @if (Model.Roll.IsQuery || Model.CanLodgeObjectionForRoll)
        {
            <a href="/search/@Model.Roll.Source" class="cd-detail-search-btn">
                <i class="fa-solid fa-magnifying-glass"></i> Search Property
            </a>
        }
        else if (Model.CanSearchRoll)
        {
            @* Current roll after the objection period: view only. *@
            <a href="/search/@Model.Roll.Source" class="cd-detail-search-btn"
               title="The objection period has closed — you can still search and view property details">
                <i class="fa-solid fa-magnifying-glass"></i> Search &amp; View Property
            </a>
        }
        else
        {
            <span class="cd-detail-search-btn cd-detail-search-btn--disabled"
                  title="The objection period for this roll has closed">
                <i class="fa-solid fa-lock"></i> Objection Period Closed
            </span>
        }
    </div>
</div>

@if (!Model.Roll.IsQuery && !Model.CanLodgeObjectionForRoll && Model.Dates is not null)
{
    <div class="cd-detail-closed-notice">
        <i class="fa-solid fa-circle-info"></i>
        The objection period for <strong>@Model.Roll.Name</strong> closed on
        @Model.Dates.VisibleUntil.ToString("dd MMMM yyyy"). You can still view
        your existing linked properties, objections and appeals below, but new
        objections can no longer be lodged for this roll.
    </div>
}

