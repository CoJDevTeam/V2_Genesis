@model List<V2_Genesis.Models.PropertySearchResult>
@{
    var roll       = ViewBag.Roll as V2_Genesis.Models.GvList;
    var isLis      = ViewBag.IsLisSearch as bool? ?? false;
    var propFrom   = isLis ? "LIS" : (roll?.Source ?? "");

    string[] headers = {
        "TOWNSHIP", "ADDRESS", "ERF", "PTN", "RE",
        "CATEGORY", "EXTENT", "MARKET VALUE",
        "SCHEME NAME", "SCHEME NO.", "SCHEME YEAR",
        "LEASE (Y/N)", "UNIT NO.", "REMARKS"
    };


}


@if (isLis)
{
    <!-- LIS results banner -->
    <div class="lis-results-banner">
        <i class="fa-solid fa-database"></i>
        Results from the <strong>Land Information System (LIS)</strong>
        — @Model.Count propert@(Model.Count == 1 ? "y" : "ies") found
    </div>
}

<table id="psResultsTable" class="display table ps-table" style="width:100%">
    <thead>
        <tr>
            @foreach (var h in headers)
            {
                <th>@h</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @* LIS search: pass PropertyFrom=LIS so CheckProperty
                       knows this came from the Land Information System   *@

                     @{
                    // var viewUrl = $"/property/view?rollSource={roll?.Source?.Trim()}" +
                    //               $"&unitKey={item.UnitKey}" +
                    //               $"&valuationKey={item.ValuationKey}" +
                    //               $"&propertyFrom={propFrom?.Trim()}";

                   
    var rollSource = roll?.Source?.Trim() ?? "";
    var propertyFrom = propFrom?.Trim() ?? "";

    var viewUrl = Url.Action("ViewProperty", "PropertySearch", new
    {
        rollSource = rollSource,
        unitKey = item.UnitKey,
        valuationKey = item.ValuationKey,
        propertyFrom = propertyFrom
    });
}
                        

                    <a  class="ps-town-link" href="@viewUrl">
                  
                     
                        @item.TownNameDesc
                    </a>
                </td>
                <td>@(item.LisStreetAddress ?? "–")</td>
                <td>@item.Erf</td>
                <td>@item.Ptn</td>
                <td>@(item.Re ?? "–")</td>
                <td>@(item.CatDesc ?? "–")</td>
                <td>@(item.RateableArea ?? "–")</td>
                <td class="ps-market-val">@item.MarketValue</td>
                <td>@(item.SchemeName ?? "–")</td>
                <td>@(item.SchemeNumber ?? "–")</td>
                <td>@(item.SchemeYear ?? "–")</td>
                <td>@(item.Lease ?? "–")</td>
                <td>@(item.UnitNo > 0 ? item.UnitNo.ToString() : "–")</td>
                <td>@(string.Equals(item.Lease?.Trim(), "Y", StringComparison.OrdinalIgnoreCase) ? "Lease" : (item.Reason ?? "–"))</td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {

        const tableSelector = '#psResultsTable';

        if (!$(tableSelector).length) {
            return;
        }

        if ($.fn.DataTable.isDataTable(tableSelector)) {
            return;
        }

        $(tableSelector).DataTable({

            // =====================================================
            // RESPONSIVE MOBILE TABLE
            // Hidden columns are displayed under the + child row.
            // =====================================================
            responsive: {
                details: {
                    type: 'inline',
                    target: 'tr'
                }
            },

            scrollX: false,
            scrollCollapse: false,
            autoWidth: false,
            destroy: true,

            // =====================================================
            // DATATABLE LAYOUT
            // =====================================================
            dom:
                '<"ps-dt-top"lf>' +
                'rt' +
                '<"ps-dt-bottom"ip>',

            lengthMenu: [
                // Never show all rows: maximum 30 per page.
                [10, 20, 30],
                [10, 20, 30]
            ],

            pageLength: 10,

            // No Excel / PDF export: roll data is sold by the City.

            // =====================================================
            // LANGUAGE
            // =====================================================
            language: {
                search: '_INPUT_',
                searchPlaceholder: 'Search results…',

                lengthMenu:
                    'Show _MENU_ entries',

                info:
                    'Showing _START_ to _END_ of _TOTAL_',

                infoEmpty:
                    'No properties found',

                infoFiltered:
                    '(filtered from _MAX_ total)',

                emptyTable:
                    'No properties found'
            },

            // =====================================================
            // RESPONSIVE COLUMN PRIORITY
            //
            // 0  Township
            // 1  Address
            // 2  Erf
            // 3  PTN
            // 4  RE
            // 5  Category
            // 6  Extent
            // 7  Market Value
            // 8  Scheme Name
            // 9  Scheme No
            // 10 Scheme Year
            // 11 Lease
            // 12 Unit No
            // 13 Remarks
            // =====================================================
            columnDefs: [

                // Township must always remain visible.
                {
                    targets: 0,
                    className: 'all',
                    responsivePriority: 1
                },

                // Address must also remain visible.
                {
                    targets: 1,
                    className: 'all',
                    responsivePriority: 2
                },

                // ERF
                {
                    targets: 2,
                    responsivePriority: 3
                },

                // PTN
                {
                    targets: 3,
                    responsivePriority: 4
                },

                // Category
                {
                    targets: 5,
                    responsivePriority: 5
                },

                // Market Value
                {
                    targets: 7,
                    responsivePriority: 6
                },

                // RE
                {
                    targets: 4,
                    responsivePriority: 7
                },

                // Extent
                {
                    targets: 6,
                    responsivePriority: 8
                },

                // Unit
                {
                    targets: 12,
                    responsivePriority: 9
                },

                // Scheme Name
                {
                    targets: 8,
                    responsivePriority: 10
                },

                // Scheme Number
                {
                    targets: 9,
                    responsivePriority: 11
                },

                // Scheme Year
                {
                    targets: 10,
                    responsivePriority: 12
                },

                // Lease
                {
                    targets: 11,
                    responsivePriority: 13
                },

                // Remarks collapses first.
                {
                    targets: 13,
                    responsivePriority: 14
                }
            ],

            // =====================================================
            // REDRAW
            // =====================================================
            drawCallback: function () {

                formatMarketValues();

                const api = this.api();

                if (api.responsive) {
                    api.responsive.recalc();
                }
            },

            // =====================================================
            // INITIALISATION
            // =====================================================
            initComplete: function () {

                const api = this.api();

                formatMarketValues();

                api.columns.adjust();

                if (api.responsive) {
                    api.responsive.recalc();
                }

                // Update result count only.
                const count =
                    api.rows().count();

                const badge =
                    document.getElementById('psmCount');

                if (badge) {
                    badge.textContent =
                        count +
                        ' ' +
                        (
                            count === 1
                                ? 'property'
                                : 'properties'
                        );
                }

                // NO TOASTER.
            }
        });


        // =========================================================
        // HANDLE SCREEN SIZE CHANGES
        // Useful while testing in Edge DevTools.
        // =========================================================
        let resizeTimer = null;

        $(window).on(
            'resize.psResultsTable',
            function () {

                clearTimeout(resizeTimer);

                resizeTimer =
                    setTimeout(function () {

                        if (
                            !$.fn.DataTable
                                .isDataTable(tableSelector)
                        ) {
                            return;
                        }

                        const table =
                            $(tableSelector)
                                .DataTable();

                        table.columns.adjust();

                        if (table.responsive) {
                            table.responsive.recalc();
                        }

                    }, 150);
            }
        );
    });


    // =============================================================
    // MARKET VALUE FORMATTING
    // =============================================================
    function formatMarketValues() {

        document
            .querySelectorAll('.ps-market-val')
            .forEach(function (el) {

                const text =
                    (el.textContent || '')
                        .replace(/\s/g, '')
                        .replace(/R/gi, '')
                        .replace(/,/g, '')
                        .trim();

                const raw =
                    parseFloat(
                        text.replace(
                            /[^0-9.-]+/g,
                            ''
                        )
                    );

                if (isNaN(raw) || raw < 0) {
                    return;
                }

                el.textContent =
                    raw.toLocaleString(
                        'en-ZA',
                        {
                            style: 'currency',
                            currency: 'ZAR',
                            minimumFractionDigits: 0,
                            maximumFractionDigits: 0
                        }
                    );
            });
    }
</script>

<style>
.lis-results-banner {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 16px; margin-bottom: 12px;
    background: #f0fdf4; border: 1.5px solid #bbf7d0;
    border-radius: 8px; font-size: 13px; color: #15803d;
}
.lis-results-banner i { font-size: 15px; }
</style>
