﻿@* ═══════════════════════════════════════════════════════════════
   Views/Shared/_LisNoResults.cshtml
   Property not found on LIS → Lodge Omission modal
═══════════════════════════════════════════════════════════════ *@
@using V2_Genesis.Models.LIS
@{
    var rollSource = ViewBag.RollSource as string ?? "Objection_Supp3";
    var rollName = ViewBag.RollName as string ?? rollSource;
    var towns = V2_Genesis.Helpers.NaturalSort.Order(ViewBag.Towns as List<string>);
    var schemes = ViewBag.Schemes as List<string> ?? new List<string>();
    var sp = ViewBag.SearchParams as LisSearchParams ?? new LisSearchParams();

    var searchedTown = sp.SearchTownName?.Trim() ?? string.Empty;
    var matchedTown = towns.FirstOrDefault(t =>
        string.Equals(
            t?.Trim(),
            searchedTown,
            StringComparison.OrdinalIgnoreCase));

    bool likelyST = !string.IsNullOrWhiteSpace(sp.SearchScheme)
                  || !string.IsNullOrWhiteSpace(sp.SearchUnit);
    string defType = likelyST ? "ST" : "FH";

    string jsTown = System.Text.Json.JsonSerializer.Serialize(sp.SearchTownName ?? "");
    string jsStand = System.Text.Json.JsonSerializer.Serialize(sp.SearchStand ?? "");
    string jsScheme = System.Text.Json.JsonSerializer.Serialize(sp.SearchScheme ?? "");
    string jsUnit = System.Text.Json.JsonSerializer.Serialize(sp.SearchUnit ?? "");
    string jsAddr = System.Text.Json.JsonSerializer.Serialize(sp.SearchAddress ?? "");
}

<link href="~/css/views/ommission-view.css" rel="stylesheet" asp-append-version="true" />
<div class="nf-wrap">


    <div class="nf-hero">
        <div class="nf-hero-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
            <div class="nf-hero-x"><i class="fa-solid fa-xmark"></i></div>
        </div>
        <h3 class="nf-hero-title">Property Not Found</h3>
        <p class="nf-hero-sub">
            We searched both <strong>@rollName</strong> and the
            Land Information System — this property could not be located.
        </p>
    </div>


    <div class="nf-info-strip">
        <div class="nf-info-icon"><i class="fa-solid fa-lightbulb"></i></div>
        <div class="nf-info-text">
            <strong>This property may be an omission.</strong>
            An omission is a property that physically exists but was never added
            to the valuation roll. You can lodge an objection to have it included
            and correctly valued — no linking step required.
        </div>
    </div>


    <div class="nf-steps">
        <div class="nf-step nf-step-done">
            <div class="nf-step-num"><i class="fa-solid fa-check"></i></div>
            <span>Searched Roll</span>
        </div>
        <div class="nf-step-line nf-step-line-done"></div>
        <div class="nf-step nf-step-done">
            <div class="nf-step-num"><i class="fa-solid fa-check"></i></div>
            <span>Searched LIS</span>
        </div>
        <div class="nf-step-line"></div>
        <div class="nf-step nf-step-active">
            <div class="nf-step-num">3</div>
            <span>Confirm Details</span>
        </div>
        <div class="nf-step-line"></div>
        <div class="nf-step">
            <div class="nf-step-num">4</div>
            <span>Lodge Form</span>
        </div>
    </div>


    <div class="nf-actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button type="button" class="nf-btn-omit" onclick="openOmissionModal(this)">
                <i class="fa-solid fa-file-signature"></i>
                Lodge as Omission
                <span class="nf-btn-arrow"><i class="fa-solid fa-arrow-right"></i></span>
            </button>
        }
        else
        {
            @* Omissions are lodged from an account; bring the visitor back to
               this roll's search after sign-in. *@
            <a class="nf-btn-omit"
               href="/login?returnUrl=@Uri.EscapeDataString("/search/" + rollSource)">
                <i class="fa-solid fa-right-to-bracket"></i>
                Sign in to Lodge as Omission
                <span class="nf-btn-arrow"><i class="fa-solid fa-arrow-right"></i></span>
            </a>
        }
        <button type="button" class="nf-btn-refine" onclick="refineSearch()">
            <i class="fa-solid fa-rotate-left"></i>
            Refine Search
        </button>
    </div>

</div>


<div id="omitBackdrop" class="om-backdrop" onclick="closeOmissionModal()"></div>

<div id="omitModal" class="om-modal" role="dialog" aria-modal="true"
     aria-labelledby="omitModalTitle">


    <div class="om-header">
        <div class="om-header-left">
            <div class="om-header-icon">
                <i class="fa-solid fa-pen-to-square"></i>
            </div>
            <div>
                <h2 id="omitModalTitle" class="om-header-title">
                    Lodge Omission Objection
                </h2>
                <p class="om-header-sub">
                    Confirm your property details — pre-filled from your search
                </p>
            </div>
        </div>
        <button class="om-close" onclick="closeOmissionModal()"
                aria-label="Close modal">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>


    <div class="om-progress">
        <div class="om-progress-bar"></div>
    </div>

  
    <div class="om-body">
        <form method="post"
              action="/search/@rollSource/omission"
              id="omissionModalForm"
              novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="rollSource" value="@rollSource" />
            <input type="hidden" name="propType" id="omitPropType" value="@defType" />

            <div class="om-section">
                <div class="om-section-label">
                    <span class="om-section-num">A</span>
                    Select Property Type
                </div>
                <div class="om-type-row">
                    <label class="om-type-card @(defType == "FH" ? "om-selected" : "")"
                           id="lbl-FH" onclick="omitSwitch('FH')">
                        <input type="radio" name="propTypeRadio" value="FH"
                        @(defType == "FH" ? "checked" : "")
                               style="position:absolute;opacity:0;" />
                        <div class="om-type-icon">
                            <i class="fa-solid fa-house-chimney"></i>
                        </div>
                        <div class="om-type-text">
                            <strong>Full Title (Freehold)</strong>
                            <small>Stand / ERF based property</small>
                        </div>
                        <div class="om-type-check">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </label>

                    <label class="om-type-card @(defType == "ST" ? "om-selected" : "")"
                           id="lbl-ST" onclick="omitSwitch('ST')">
                        <input type="radio" name="propTypeRadio" value="ST"
                        @(defType == "ST" ? "checked" : "")
                               style="position:absolute;opacity:0;" />
                        <div class="om-type-icon">
                            <i class="fa-solid fa-building"></i>
                        </div>
                        <div class="om-type-text">
                            <strong>Sectional Title</strong>
                            <small>Scheme / Unit based property</small>
                        </div>
                        <div class="om-type-check">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </label>
                </div>
            </div>

          
            <div class="om-section">
                <div class="om-section-label">
                    <span class="om-section-num">B</span>
                    Property Location
                </div>
                <div class="om-field om-field-full">
                    <label class="om-label" for="omitTown">
                        <i class="fa-solid fa-map-pin"></i>
                        Township <span class="om-req">*</span>
                    </label>
                    <div class="om-select-wrap">
                        <select name="FH_Town" id="omitTown"
                                class="om-ctrl om-select coj-township-select" required>
                            <option value="">— Select Township —</option>

                            @* Keep the exact township used in the search even
                               when its text is not present in the dropdown list. *@
                            @if (!string.IsNullOrWhiteSpace(searchedTown) && matchedTown is null)
                            {
                                <option value="@searchedTown" selected>@searchedTown</option>
                            }

                            @foreach (var t in towns)
                            {
                                if (string.Equals(t, matchedTown, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@t" selected>@t</option>
                                }
                                else
                                {
                                    <option value="@t">@t</option>
                                }
                            }
                        </select>
                        <i class="fa-solid fa-chevron-down om-select-arrow"></i>
                    </div>
                </div>
            </div>


            <div id="omitFH" class="om-section"
                 style="display:@(defType == "FH" ? "block" : "none");">
                <div class="om-section-label">
                    <span class="om-section-num">C</span>
                    Freehold Property Details
                </div>
                <div class="om-grid">

                    <div class="om-field">
                        <label class="om-label" for="omitERF">
                            <i class="fa-solid fa-hashtag"></i>
                            ERF / Stand Number
                            @if (!string.IsNullOrWhiteSpace(sp.SearchStand))
                            {
                                <span class="om-prefilled-badge">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                    Pre-filled
                                </span>
                            }
                        </label>
                        <input type="text" name="FH_ERF" id="omitERF"
                               class="om-ctrl @(!string.IsNullOrWhiteSpace(sp.SearchStand) ? "om-prefilled" : "")"
                               placeholder="e.g. 1234" />
                        <p class="om-hint">Number used in your original search</p>
                    </div>

                    <div class="om-field">
                        <label class="om-label" for="omitPortion">
                            <i class="fa-solid fa-square"></i>
                            Portion
                        </label>
                        <input type="text" name="FH_Portion" id="omitPortion"
                               class="om-ctrl" placeholder="e.g. 0"
                               onkeypress="return omitNumKey(event)" />
                        <p class="om-hint">Enter 0 if no portion</p>
                    </div>

                    <div class="om-field">
                        <label class="om-label" for="omitRE">
                            <i class="fa-solid fa-ruler"></i>
                            RE <span class="om-req">*</span>
                        </label>
                        <div class="om-select-wrap">
                            <select name="FH_RE" id="omitRE" class="om-ctrl om-select" required>
                                <option value="" disabled selected>Select RE option</option>
                                <option value="RE">RE — Remaining Extent</option>
                                <option value="00">00 — No remainder</option>
                            </select>
                            <i class="fa-solid fa-chevron-down om-select-arrow"></i>
                        </div>
                    </div>

                    <div class="om-field">
                        <label class="om-label" for="omitFHRight">
                            <i class="fa-solid fa-file-signature"></i>
                            Property Right
                            <span class="om-opt">(optional)</span>
                        </label>
                        <div class="om-select-wrap">
                            <select name="FH_Right" id="omitFHRight"
                                    class="om-ctrl om-select">
                                <option value="">None</option>
                                <option value="Lease on ">Long-Term Lease</option>
                                <option value="Mining Right on ">Mining Rights</option>
                            </select>
                            <i class="fa-solid fa-chevron-down om-select-arrow"></i>
                        </div>
                    </div>

                    <div class="om-field om-field-full">
                        <label class="om-label" for="omitAddr">
                            <i class="fa-solid fa-road"></i>
                            Street Address
                            <span class="om-opt">(optional)</span>
                            @if (!string.IsNullOrWhiteSpace(sp.SearchAddress))
                            {
                                <span class="om-prefilled-badge">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                    Pre-filled
                                </span>
                            }
                        </label>
                        <input type="text" name="FH_Address" id="omitAddr"
                               class="om-ctrl @(!string.IsNullOrWhiteSpace(sp.SearchAddress) ? "om-prefilled" : "")"
                               placeholder="e.g. 123 Main Street" />
                    </div>

                </div>
            </div>

        
            <div id="omitST" class="om-section"
                 style="display:@(defType == "ST" ? "block" : "none");">
                <div class="om-section-label">
                    <span class="om-section-num">C</span>
                    Sectional Title Details
                </div>
                <div class="om-grid">

                    <div class="om-field om-field-full">
                        <label class="om-label" for="omitScheme">
                            <i class="fa-solid fa-building"></i>
                            Scheme Name <span class="om-req">*</span>
                            @if (!string.IsNullOrWhiteSpace(sp.SearchScheme))
                            {
                                <span class="om-prefilled-badge">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                    Pre-filled
                                </span>
                            }
                        </label>
                        @if (schemes.Any())
                        {
                            <div class="om-select-wrap">
                                <select name="ST_Scheme" id="omitScheme"
                                        class="om-ctrl om-select">
                                    <option value="">— Select Scheme —</option>
                                    @foreach (var s in schemes)
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                                <i class="fa-solid fa-chevron-down om-select-arrow"></i>
                            </div>
                        }
                        else
                        {
                            <input type="text" name="ST_Scheme" id="omitScheme"
                                   class="om-ctrl @(!string.IsNullOrWhiteSpace(sp.SearchScheme) ? "om-prefilled" : "")"
                                   placeholder="Scheme name" />
                        }
                    </div>

                    <div class="om-field">
                        <label class="om-label" for="omitSchemeNum">
                            <i class="fa-solid fa-hashtag"></i>
                            Scheme Number <span class="om-req">*</span>
                        </label>
                        <input type="text" name="ST_SchemeNumber" id="omitSchemeNum"
                               class="om-ctrl" placeholder="e.g. 1234"
                               onkeypress="return omitNumKey(event)" />
                    </div>

                    <div class="om-field">
                        <label class="om-label" for="omitSchemeYear">
                            <i class="fa-solid fa-calendar-alt"></i>
                            Scheme Year <span class="om-req">*</span>
                        </label>
                        <input type="text" name="ST_SchemeYear" id="omitSchemeYear"
                               class="om-ctrl" placeholder="e.g. 2018"
                               onkeypress="return omitNumKey(event)" />
                    </div>

                    <div class="om-field">
                        <label class="om-label" for="omitUnit">
                            <i class="fa-solid fa-door-open"></i>
                            Unit Number <span class="om-req">*</span>
                            @if (!string.IsNullOrWhiteSpace(sp.SearchUnit))
                            {
                                <span class="om-prefilled-badge">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                    Pre-filled
                                </span>
                            }
                        </label>
                        <input type="text" name="ST_Unit" id="omitUnit"
                               class="om-ctrl @(!string.IsNullOrWhiteSpace(sp.SearchUnit) ? "om-prefilled" : "")"
                               placeholder="e.g. 5"
                               onkeypress="return omitNumKey(event)" />
                    </div>

                    <div class="om-field">
                        <label class="om-label" for="omitSTRight">
                            <i class="fa-solid fa-file-signature"></i>
                            Property Right
                            <span class="om-opt">(optional)</span>
                        </label>
                        <div class="om-select-wrap">
                            <select name="ST_Right" id="omitSTRight"
                                    class="om-ctrl om-select">
                                <option value="">None</option>
                                <option value="Lease on ">Long-Term Lease</option>
                                <option value="Mining Right on ">Mining Rights</option>
                            </select>
                            <i class="fa-solid fa-chevron-down om-select-arrow"></i>
                        </div>
                    </div>

                </div>
            </div>

        
            <div class="om-notice">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>
                    Lodging an omission does not guarantee the property will be added
                    to the roll. The City will investigate and determine the appropriate
                    valuation. For assistance e-mail <a href="mailto:valuationenquiries@joburg.org.za"><strong>valuationenquiries@joburg.org.za</strong></a>.
                </span>
            </div>

        
            <div class="om-footer">
                <button type="button" class="om-btn-cancel"
                        onclick="closeOmissionModal()">
                    <i class="fa-solid fa-xmark"></i> Cancel
                </button>
                <button type="button" class="om-btn-cancel"
                        onclick="refineSearch()"
                        title="Close this and change the search">
                    <i class="fa-solid fa-rotate-left"></i> Refine Search
                </button>
                <button type="submit" class="om-btn-submit" id="omitSubmitBtn">
                    <i class="fa-solid fa-arrow-right"></i>
                    Continue to Objection Form
                </button>
            </div>

        </form>
    </div>
</div>

<script>
    // ════════════════════════════════════════════════════════════════
    //  _LisNoResults.cshtml — REPLACE the entire <script> block
    // ════════════════════════════════════════════════════════════════

    // This script runs again for every new search. Remove the omission
    // modal left behind by an earlier search (it was moved to <body>),
    // so the new search's values are always the ones shown.
    document.querySelectorAll('body > #omitModal, body > #omitBackdrop')
        .forEach(function (el) { el.parentNode.removeChild(el); });
    document.body.style.overflow = '';

    // ── Values from server (Razor-rendered) ─────────────────────────
    // "var" (not "let"): the script is run again on the next search and a
    // second "let" of the same name stopped the whole script, so the
    // omission form kept the FIRST search's township, stand and address.
    var _omitTown   = @Html.Raw(jsTown);
    var _omitStand  = @Html.Raw(jsStand);
    var _omitScheme = @Html.Raw(jsScheme);
    var _omitUnit   = @Html.Raw(jsUnit);
    var _omitAddr   = @Html.Raw(jsAddr);
    var _defType    = '@defType';

    // ── Open modal ───────────────────────────────────────────────────
    var _omitParentModal = null;
    var _omitParentDisplay = '';

    function openOmissionModal(trigger) {
        var modal = document.getElementById('omitModal');
        var backdrop = document.getElementById('omitBackdrop');
            backdrop.style.zIndex = '20000';
    modal.style.zIndex = '20001';

    modal.style.width = 'min(1100px, 96vw)';
    modal.style.maxWidth = '1100px';
    modal.style.maxHeight = '92vh';

        if (!modal || !backdrop) return;

        // Find the modal/container that currently contains the "Lodge Omission" button.
        // This is the first modal we must hide before showing the omission modal.
        _omitParentModal = trigger
            ? trigger.closest('.modal.show, .modal, .results-modal, .property-modal, .search-modal, [role="dialog"]')
            : null;

        // Do not treat the omission modal itself as the parent.
        if (_omitParentModal && _omitParentModal.id === 'omitModal') {
            _omitParentModal = null;
        }

        if (_omitParentModal) {
            _omitParentDisplay = _omitParentModal.style.display || '';

            _omitParentModal.classList.remove('show');
            _omitParentModal.style.display = 'none';
            _omitParentModal.setAttribute('aria-hidden', 'true');
        }

        // Move omission modal to body so it is not trapped inside the previous modal.
        if (backdrop.parentElement !== document.body) {
            document.body.appendChild(backdrop);
        }

        if (modal.parentElement !== document.body) {
            document.body.appendChild(modal);
        }

        prePopulate();
        omitSwitch(_defType);

        // Force omission modal to appear above all other modals/backdrops.
        backdrop.style.zIndex = '20000';
        modal.style.zIndex = '20001';

        backdrop.classList.add('show');
        modal.classList.add('show');
        modal.style.display = 'block';
        modal.removeAttribute('aria-hidden');

        document.body.style.overflow = 'hidden';
    }

    // ── Close modal ──────────────────────────────────────────────────
       function closeOmissionModal() {
        var backdrop = document.getElementById('omitBackdrop');
        var modal = document.getElementById('omitModal');

        if (backdrop) {
            backdrop.classList.remove('show');
            backdrop.style.zIndex = '';
        }

        if (modal) {
            modal.classList.remove('show');
            modal.style.display = 'none';
            modal.style.zIndex = '';
            modal.setAttribute('aria-hidden', 'true');
        }

        // Restore the first modal if user cancels/backs out.
        if (_omitParentModal) {
            _omitParentModal.style.display = _omitParentDisplay || 'block';
            _omitParentModal.classList.add('show');
            _omitParentModal.removeAttribute('aria-hidden');
        }

        document.body.style.overflow = '';
    }

    // ── Remove modal elements from <body> (called before container clear)
    function _cleanupOmitElements() {
        ['omitBackdrop', 'omitModal'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el && el.parentElement === document.body) {
                document.body.removeChild(el);
            }
        });
    }

    // ── Pre-populate fields from original search ─────────────────────
    function prePopulate() {
        // Town dropdown — case-insensitive match
        var town = document.getElementById('omitTown');
        if (town && _omitTown) {
            var searchedTown = _omitTown.trim().toLowerCase();
            for (var i = 0; i < town.options.length; i++) {
                if (town.options[i].value.trim().toLowerCase() === searchedTown) {
                    town.selectedIndex = i; break;
                }
            }
        }
        setVal('omitERF',  _omitStand);
        setVal('omitAddr', _omitAddr);
        setVal('omitUnit', _omitUnit);

        // Scheme — dropdown or text input
        var scheme = document.getElementById('omitScheme');
        if (scheme && _omitScheme) {
            if (scheme.tagName === 'SELECT') {
                for (var j = 0; j < scheme.options.length; j++) {
                    if (scheme.options[j].value.toLowerCase() === _omitScheme.toLowerCase()) {
                        scheme.selectedIndex = j; break;
                    }
                }
            } else {
                scheme.value = _omitScheme;
            }
        }
    }

    function setVal(id, val) {
        var el = document.getElementById(id);
        if (el && val) el.value = val;
    }

    // ── Switch between Freehold / Sectional Title ────────────────────
    function omitSwitch(type) {
        document.getElementById('omitPropType').value = type;
        var fh = document.getElementById('omitFH');
        var st = document.getElementById('omitST');
        if (!fh || !st) return;

        if (type === 'FH') {
            fh.style.display = 'block';
            st.style.display = 'none';
            document.getElementById('lbl-FH').classList.add('om-selected');
            document.getElementById('lbl-ST').classList.remove('om-selected');
            setReq(['omitRE'], true);
            setReq(['omitScheme','omitSchemeNum','omitSchemeYear','omitUnit'], false);
        } else {
            fh.style.display = 'none';
            st.style.display = 'block';
            document.getElementById('lbl-ST').classList.add('om-selected');
            document.getElementById('lbl-FH').classList.remove('om-selected');
            setReq(['omitScheme','omitSchemeNum','omitSchemeYear','omitUnit'], true);
            setReq(['omitRE'], false);
        }
    }

    function setReq(ids, req) {
        ids.forEach(function(id) {
            var el = document.getElementById(id);
            if (el) el.required = req;
        });
    }

    // ── Numeric-only key filter ──────────────────────────────────────
    function omitNumKey(e) {
        var c = e.which ?? e.keyCode;
        return !(c > 31 && (c < 48 || c > 57));
    }

    // ── Form validation on submit ────────────────────────────────────
    document.getElementById('omissionModalForm')
        ?.addEventListener('submit', function(e) {
        var type = document.getElementById('omitPropType').value;
        var town = document.getElementById('omitTown').value.trim();

        if (!town) {
            e.preventDefault();
            showErr('Please select a township.'); return;
        }

        if (type === 'FH') {
            var erf = document.getElementById('omitERF').value.trim();
            var re  = document.getElementById('omitRE').value;
            if (!erf) { e.preventDefault(); showErr('Please enter the ERF / Stand number.'); return; }
            if (!re)  { e.preventDefault(); showErr('Please select the RE option.'); return; }
        } else {
            var s  = document.getElementById('omitScheme').value.trim();
            var sn = document.getElementById('omitSchemeNum').value.trim();
            var sy = document.getElementById('omitSchemeYear').value.trim();
            var u  = document.getElementById('omitUnit').value.trim();
            if (!s || !sn || !sy || !u) {
                e.preventDefault();
                showErr('Please fill in all Scheme details: Name, Number, Year and Unit.');
                return;
            }
        }

        // Show loading state
        var btn = document.getElementById('omitSubmitBtn');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing…';
        btn.disabled = true;
    });

    // ── Validation error message ─────────────────────────────────────
    function showErr(msg) {
        var ex = document.getElementById('omitErr');
        if (ex) ex.remove();

        var d = document.createElement('div');
        d.id = 'omitErr';
        d.className = 'om-err';
        d.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> ' + msg;

        // ← FIX: scope to #omitModal so it works after modal moves to body
        var footer = document.querySelector('#omitModal .om-footer');
        if (footer) footer.insertAdjacentElement('beforebegin', d);

        setTimeout(function() { d.remove(); }, 5000);
    }

    // ── Refine search — back to the search form ──────────────────────
    // Closes the omission box and the results box, so the client can change
    // the township / stand / address / scheme / unit and search again.
    // (Before, it only re-showed the "No Properties Found" card inside the
    //  results box, with its LIS button hidden - a dead end.)
    function refineSearch() {
        closeOmissionModal();
        _cleanupOmitElements();

        if (typeof window.genesisRefineSearch === 'function') {
            window.genesisRefineSearch();
            return;
        }

        var container = document.getElementById('lisResultsContainer');
        if (container) container.innerHTML = '';
        if (typeof window.closeResultsModal === 'function') window.closeResultsModal();
    }

    // ── Init ─────────────────────────────────────────────────────────
    omitSwitch(_defType);

    // ← FIX: remove old listener before adding — prevents accumulation
    //   when injectWithScripts re-runs this script on second LIS search
    if (window._omitEscHandler) {
        document.removeEventListener('keydown', window._omitEscHandler);
    }
    window._omitEscHandler = function(e) {
        if (e.key === 'Escape') closeOmissionModal();
    };
    document.addEventListener('keydown', window._omitEscHandler);
</script>


