@using V2_Genesis.Models
@model Prop_View_Model

@{
   // Layout = "~/Views/Shared/_ClientLayout.cshtml";
     Layout = "~/Views/Shared/_Legend_Layout.cshtml";

    // ── Admin identity from ViewBag ──────────────────────────────
    // ── Admin identity from Windows Authenticator audit claims/session ──
    // Data pulling still uses AdministrationEnquiries@Joburg.org.za.
    // These values are ONLY for Captured By / audit trail.

    bool _isAdmin =
        (ViewBag.IsAdmin as bool? ?? false)
        || User.IsInRole("Admin")
        || User.FindFirst("AdminAppEmail")?.Value?.Equals(
            "AdministrationEnquiries@Joburg.org.za",
            StringComparison.OrdinalIgnoreCase) == true
        || Context.Session.GetString("AdminAppEmail")?.Equals(
            "AdministrationEnquiries@Joburg.org.za",
            StringComparison.OrdinalIgnoreCase) == true;

    string _fullName =
        User.FindFirst("FullName")?.Value
        ?? Context.Session.GetString("AdminFullName")
        ?? ViewBag.AdminFullName?.ToString()
        ?? "";

    string _adminPosition =
        User.FindFirst("Position")?.Value
        ?? Context.Session.GetString("AdminPosition")
        ?? ViewBag.AdminPosition?.ToString()
        ?? "";

    string _sapFull =
        User.FindFirst("SAPNumber")?.Value
        ?? Context.Session.GetString("AdminSapNumber")
        ?? ViewBag.SapFull?.ToString()
        ?? "";

    string _sapNumeric =
        User.FindFirst("SAPNumeric")?.Value
        ?? Context.Session.GetString("AdminSapNumeric")
        ?? ViewBag.SapNumeric?.ToString()
        ?? "";


    if (string.IsNullOrWhiteSpace(_sapNumeric) && !string.IsNullOrWhiteSpace(_sapFull))
    {
        _sapNumeric = _sapFull.Contains('\\')
            ? _sapFull.Split('\\').Last()
            : _sapFull;
    }

    string _windowsUser =
        User.FindFirst("WindowsUser")?.Value
        ?? Context.Session.GetString("AdminWindowsUser")
        ?? "";

    // ── SourceTable from ViewData ────────────────────────────────
    // //string sourceTable = (string)(ViewData["SourceTable"] ?? "");

    // ── All TempData reads use Peek — nothing is consumed ────────
    bool _isAppeal = TempData.Peek("AppealStatus")?.ToString() == "True";

    // User-facing terminology only. The existing Objector_* model and
    // database fields remain unchanged for compatibility.
    string partyUpper = _isAppeal ? "APPELLANT" : "OBJECTOR";
    string partyTitle = _isAppeal ? "Appellant" : "Objector";
    string partyLower = _isAppeal ? "appellant" : "objector";
    string actionUpper = _isAppeal ? "APPEAL" : "OBJECTION";
    string actionLower = _isAppeal ? "appeal" : "objection";
    string propertyActionText =
        _isAppeal ? "PROPERTY APPEALED AGAINST" : "PROPERTY OBJECTED TO";

    var messagePD = TempData.Peek("CurrentFilter_PD")?.ToString()
                     ?? TempData.Peek("CurrentFilter_Prop")?.ToString()
                     ?? "";

    var messageProp = TempData.Peek("CurrentFilter_Prop")?.ToString()
                      ?? TempData.Peek("CurrentFilter_PD")?.ToString()
                      ?? "";
   

    
    var propertyDescription = _isAppeal ? messageProp : messagePD;


  
    string sourceTable = ViewData["SourceTable"]?.ToString()
                         ?? TempData.Peek("SourceTable")?.ToString()
                         ?? TempData.Peek("PropertyFrom")?.ToString()
                         ?? "";
    string propertyFrom =
TempData.Peek("PropertyFrom")?.ToString()
?? ViewData["PropertyFrom"]?.ToString()
?? sourceTable
?? "";

    bool isLisProperty = propertyFrom.Equals("LIS", StringComparison.OrdinalIgnoreCase);

    bool isOmissionProperty =
        propertyFrom.Equals("Omission", StringComparison.OrdinalIgnoreCase)
        || TempData.Peek("OmissionStatus")?.ToString() == "True";


    string rollSource = TempData.Peek("RollSource")?.ToString() ?? "";

    TempData.Keep("RollSource");
    TempData.Keep("SourceTable");
    TempData.Keep("PropertyFrom");


    var messageID2 = TempData.Peek("CurrentFilter_Id")?.ToString() ?? "";
    var messageCD = TempData.Peek("CurrentFilter_CD")?.ToString() ?? "";
    var messageLSA = TempData.Peek("CurrentFilter_LSA")?.ToString() ?? "";
    var messageRA = TempData.Peek("CurrentFilter_RA")?.ToString() ?? "";
    var messageMV = TempData.Peek("CurrentFilter_MV")?.ToString() ?? "";

    // Multipurpose current roll values
    var messageCD2 = TempData.Peek("CurrentFilter_CD2")?.ToString() ?? "";
    var messageRA2 = TempData.Peek("CurrentFilter_RA2")?.ToString() ?? "";
    var messageMV2 = TempData.Peek("CurrentFilter_MV2")?.ToString() ?? "";

    var messageCD3 = TempData.Peek("CurrentFilter_CD3")?.ToString() ?? "";
    var messageRA3 = TempData.Peek("CurrentFilter_RA3")?.ToString() ?? "";
    var messageMV3 = TempData.Peek("CurrentFilter_MV3")?.ToString() ?? "";
    var rollDisplayName = TempData.Peek("RollDisplayName")?.ToString()
                      ?? "Valuation Roll";

    var particularsHeading =
        _isAppeal
            ? "PARTICULARS AS REFLECTED IN MUNICIPAL VALUERS DECISION"
            : $"PARTICULARS AS REFLECTED IN {rollDisplayName}".ToUpperInvariant();

    var oldMarketValueRaw = NormaliseMoneyForDb(messageMV);
    var oldMarketValueDisplay = FormatRand(messageMV);
   

var old2MarketValueRaw = NormaliseMoneyForDb(messageMV2);
var old2MarketValueDisplay = FormatRand(messageMV2);

var old3MarketValueRaw = NormaliseMoneyForDb(messageMV3);
var old3MarketValueDisplay = FormatRand(messageMV3);

    var omissionRequestedDescription = TempData.Peek("Omission_PropertyDesc")?.ToString() ?? "";
    var messageON = TempData.Peek("CurrentFilter_ON")?.ToString() ?? "";
    if (isOmissionProperty)
    {
        // There's no roll record for an omitted property, so the roll-based
        // fields are correctly blank — but the property description itself
        // should still show what the client originally reported when they
        // lodged the omission, not go blank along with everything else.
        messagePD = omissionRequestedDescription;
        messageProp = omissionRequestedDescription;
        messageCD = "";
        messageLSA = "";
        messageRA = "";
        messageMV = "";

        messageCD2 = "";
        messageRA2 = "";
        messageMV2 = "";

        messageCD3 = "";
        messageRA3 = "";
        messageMV3 = "";

        messageON = "";

        oldMarketValueRaw = "";
        oldMarketValueDisplay = "";

        old2MarketValueRaw = "";
        old2MarketValueDisplay = "";

        old3MarketValueRaw = "";
        old3MarketValueDisplay = "";

        // propertyDescription was computed above from the pre-fallback
        // messagePD/messageProp, so it needs the same correction here.
        propertyDescription = omissionRequestedDescription;
    }

    
    var messageTN = TempData.Peek("CurrentFilter_TN")?.ToString() ?? "";
    var messagePID = TempData.Peek("CurrentFilter_P_ID")?.ToString() ?? "";
    var messagePI = TempData.Peek("CurrentFilter_P_I")?.ToString() ?? "";
    var messageUK = TempData.Peek("CurrentFilter_UK")?.ToString() ?? "";
    var messageVK = TempData.Peek("CurrentFilter_VK")?.ToString() ?? "";
    var messageS = TempData.Peek("CurrentFilter_S")?.ToString() ?? "";
    var obj_Appeal = TempData.Peek("ObjectionNum")?.ToString() ?? "";

    // Derived aliases used in Section 2
    var messageEX = messageRA;
    var messageSA = messageLSA;

    // ── Persist admin identity in TempData for multi-step forms ──
    // (only set if not already present so repeat visits don't overwrite)
    if (_isAdmin)
    {
        // These are Windows Authenticator details for audit/capturer.
        TempData["SapNumber"] = _sapNumeric;
        TempData["AdminFullName"] = _fullName;
        TempData["AdminPosition"] = _adminPosition;
        TempData["SapFull"] = _sapFull;
        TempData["AdminWindowsUser"] = _windowsUser;

        TempData.Keep("SapNumber");
        TempData.Keep("AdminFullName");
        TempData.Keep("AdminPosition");
        TempData.Keep("SapFull");
        TempData.Keep("AdminWindowsUser");
    }

    // ── Keep ALL TempData keys for the next request ───────────────
    // (handles Previous navigation back through the form)
    var _keysToKeep = new[]
    {
        "AppealStatus",
      
    "RollSource",
    "SourceTable",
    "PropertyFrom",
    "OmissionStatus",
        "CurrentFilter_Id",
        "CurrentFilter_PD",   "CurrentFilter_Prop",
        "CurrentFilter_CD",   "CurrentFilter_LSA",
        "CurrentFilter_RA",   "CurrentFilter_MV",
        "CurrentFilter_ON",   "CurrentFilter_TN",
        "CurrentFilter_P_ID", "CurrentFilter_P_I",
        "CurrentFilter_UK",   "CurrentFilter_VK",
        "CurrentFilter_S",
        "ObjectionNum",
        "SapNumber",   "AdminFullName",
        "AdminPosition", "SapFull",

        "CurrentFilter_CD2",
"CurrentFilter_RA2",
"CurrentFilter_MV2",

"CurrentFilter_CD3",
"CurrentFilter_RA3",
"CurrentFilter_MV3",

"RollDisplayName",
"Omission_PropertyDesc",
"Omission_TownName",
"Omission_Address",
    };
    foreach (var _k in _keysToKeep)
        if (TempData.ContainsKey(_k)) TempData.Keep(_k);


}

@functions {
    private static string NormaliseMoneyForDb(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";

        var cleaned = new string(value.Where(char.IsDigit).ToArray());

        return string.IsNullOrWhiteSpace(cleaned)
            ? ""
            : cleaned;
    }

    private static string FormatRand(string? value)
    {
        var raw = NormaliseMoneyForDb(value);

        if (string.IsNullOrWhiteSpace(raw))
            return "";

        if (!decimal.TryParse(raw, out var amount))
            return value ?? "";

        return "R " + amount.ToString("#,0", System.Globalization.CultureInfo.InvariantCulture)
                            .Replace(",", " ");
    }

}
