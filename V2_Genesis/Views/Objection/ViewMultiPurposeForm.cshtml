                {
                    <h1>
                        LODGING OF AN APPEAL AGAINST A MATTER REFLECTED IN OR OMITTED FROM THE
                        <span>VALUATION ROLL / SUPPLEMENTARY VALUATION ROLL</span>
                    </h1>
                }
                else
                {
                    <h1>
                        LODGING OF AN OBJECTION AGAINST A MATTER REFLECTED IN OR OMITTED FROM THE
                        <span>VALUATION ROLL / SUPPLEMENTARY VALUATION ROLL</span>
                    </h1>
                }
