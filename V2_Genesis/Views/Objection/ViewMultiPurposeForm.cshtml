<form id="myForm"method="post"enctype="multipart/form-data"asp-controller="Objection" asp-action="SubmitObjectionForm"asp-route-PropertyFrom="@propertyFrom" style="margin-left: 0px">
    <div style="display:flex;justify-content:center;">
        <div class="obj-form-card" style="margin-top:12px;">

