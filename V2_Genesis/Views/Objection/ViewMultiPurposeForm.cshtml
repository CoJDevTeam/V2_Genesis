            <div class="obj-form-banner">
                <span class="obj-form-chip">
                    <i class="fa-solid @(_isAppeal ? "fa-gavel" : "fa-file-pen")"></i>
                    @(_isAppeal ? "Appeal Form" : "Objection Form")
                </span>
