    <div id="section7" style="display:flex;justify-content: center;">

        <div class="div7 obj-form-card">
            <div style="width: 100%; margin: 20px 0; padding: 10px 0; position: relative;">
                <h4 class="obj-section-title" id="s_head"><strong>Section 7: Declaration</strong></h4>
                <div class="obj-step-divider">
                    <div class="line"></div>
                    <div class="dot"></div>
                    <div class="line"></div>
                </div>
            </div>

            <div class="obj-section-bar"><span class="obj-bar-num">7.1</span><span>Declaration &amp; @(_isAppeal ? "Appeal" : "Objection") Details</span></div>

            <!-- ── Legal notice (Section 42(2)) ───────────────────────── -->
            <div class="obj-legal-box">
                <h6>
                    Attention is hereby drawn to Section 42(2) of the Act, which states that where any document, information or
                    particulars were not provided when required in terms of subsection 42(1) of the Act and the owner concerned
                    relies on such document, information or particulars in an appeal to an Appeal Board, the Appeal Board may make
                    an order as to costs in terms of Section 70 of the Act if the Appeal Board is of the view that the failure to so
                    have provided any such document, information or particulars has placed an unnecessary burden on the functions of
                    the Municipal Valuer or the Appeal Board.
                </h6>
            </div>

            <!-- ── "I/WE ... declare" ─────────────────────────────────── -->
            <div class="obj-declaration-row">
                <span>I / WE</span>
                <input id="sign_obj" maxlength="80" required asp-for="Signature_Name"
                       type="text" onpaste="return false;" ondrop="return false;"
                       placeholder="Full name(s)" />
                <span>hereby declare that the information and particulars supplied are true and correct.</span>
            </div>

            <!-- ── Capturer (admin only) ───────────────────────────────── -->
            @if (_isAdmin)
            {
                <div id="capturer" style="display:flex;align-items:center;gap:14px;
                    background: #006570;
                    border:1.5px solid rgba(230,176,0,.4);border-radius:10px;
                    padding:14px 18px;margin-bottom:18px;flex-wrap:wrap;">

                    <div style="width:42px;height:42px;border-radius:9px;flex-shrink:0;
                        background:rgba(230,176,0,.15);border:1.5px solid rgba(230,176,0,.4);
                        display:flex;align-items:center;justify-content:center;
                        color:#e6b000;font-size:18px;">
                        <i class="fa-solid fa-id-badge"></i>
                    </div>

                    <div style="flex:1;">
                        <div style="font-size:9.5px;font-weight:700;letter-spacing:1.5px;
                            color:rgba(255,255,255,.4);text-transform:uppercase;margin-bottom:1px;">
                            Captured by Windows Authenticator
                        </div>

                        <div style="font-size:15px;font-weight:800;color:#fff;line-height:1.2;">
                            @(!string.IsNullOrWhiteSpace(_fullName) ? _fullName : "Admin User")
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_adminPosition))
                        {
                            <div style="font-size:11.5px;color:rgba(230,176,0,.7);font-weight:600;margin-top:1px;">
                                @_adminPosition
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_sapFull))
                        {
                            <div style="font-size:11px;color:rgba(255,255,255,.35);margin-top:2px;font-family:monospace;">
                                @_sapFull
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_windowsUser))
                        {
                            <div style="font-size:10.5px;color:rgba(255,255,255,.3);margin-top:2px;font-family:monospace;">
                                Windows: @_windowsUser
                            </div>
                        }
                    </div>

                    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:3px;flex-shrink:0;">
                        <span style="font-size:9px;font-weight:700;letter-spacing:1.5px;
                            color:rgba(255,255,255,.3);text-transform:uppercase;">
                            SAP No.
                        </span>
                        <span style="font-size:14px;font-weight:800;color:#e6b000;font-family:monospace;">
                            @_sapNumeric
                        </span>
                    </div>

                    <input type="hidden" id="sapNo" asp-for="Capturer" value="@_sapNumeric" />
                    <input type="hidden" name="AdminCapturedFullName" value="@_fullName" />
                    <input type="hidden" name="AdminCapturedPosition" value="@_adminPosition" />
                    <input type="hidden" name="AdminCapturedWindowsUser" value="@_windowsUser" />
                    <input type="hidden" name="AdminCapturedSapFull" value="@_sapFull" />
                </div>
            }
            else
            {
                <input type="hidden" asp-for="Capturer" value="" />
            }

            <input hidden style="margin-top: -1px;" class="form-control border-2 rounded shadow-sm px-4 py-2"
                   id="signDate" required type="datetime-local" asp-for="Declaration_Date">

            <!-- ── Signature ───────────────────────────────────────────── -->
            <div class="obj-signature-card obj-auto-signature">
                <div class="obj-auto-signature-title">
                    <i class="fa-solid fa-pen-nib"></i>
                    Draw signature below <span class="req">*</span>
                    <span style="font-weight:400;text-transform:none;color:#888;">(mouse or finger)</span>
                </div>

                <div class="obj-signature-canvas-wrap">
                    <canvas width="598" height="160" id="signature"></canvas>
                    <div class="obj-signature-line"></div>
                    <div class="obj-signature-hint">Sign here</div>
                </div>

                <div class="obj-signature-controls">
                    <button type="button" id="Clear" class="obj-signature-clear">
                        <i class="fa-solid fa-rotate-left"></i> Clear
                    </button>
                    <span id="signatureStatus">No signature drawn</span>
                </div>

                <input type="text" onpaste="return false;" ondrop="return false;"
                       id="SignatureDataUrl" asp-for="Signature_Picture" hidden="hidden">
            </div>

            <!-- ── Navigation ──────────────────────────────────────────── -->
            <div style="margin-top:18px;">
                <button type="button" class="btn_p7 btn obj-nav-btn obj-nav-btn-prev"><strong>Previous</strong></button>
                <button type="submit" class="btn obj-nav-btn obj-nav-btn-submit" disabled id="submitForm" onclick="showInput()"><i class="fa-solid fa-paper-plane"></i> <strong>Submit</strong></button>


  
            </div>
        </div>

    </div>
    <div id="objLoaderOverlay" class="obj-loader-overlay">
        <div class="obj-loader-spinner"></div>
        <div class="obj-loader-text">
            <strong>Submitting your @(_isAppeal ? "Appeal" : "Objection")...</strong>
            Please wait while the Valuation Department receives your
            @(_isAppeal ? "appeal" : "objection"). Do not close or refresh
            this page.
        </div>
    </div>
</form>
  @section Scripts {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/signature_pad/1.5.3/signature_pad.min.js"></script>
        <script src="https://code.jquery.com/jquery-latest.min.js" type="text/javascript"></script>
        <script asp-append-version="true" src="~/js/objectionmulti.js" type="text/javascript"></script>
    <script asp-append-version="true" src="~/js/sa-id-validation.js"></script>
    <script asp-append-version="true" src="~/js/genesis-forms.js"></script>
    <script>
        // Requested Split 3 is not saved in the database. Keep what the client
        // typed so the Multipurpose acknowledgement page can show it
        // (same as the Section 78 Multipurpose form).
        (function () {
            var map = {
                NewCat3: 'obj_New4_Category',
                NewExtent3: 'obj_New4_Extent',
                NewMarketValue3: 'obj_New4_Market_Value'
            };

            function save() {
                Object.keys(map).forEach(function (id) {
                    var el = document.getElementById(id);
                    try { sessionStorage.setItem(map[id], el && el.value ? el.value : ''); }
                    catch (e) { }
                });
            }

            save(); // clears values from a previous submission
            ['input', 'change', 'submit'].forEach(function (name) {
                document.addEventListener(name, save, true);
            });
        })();
    </script>
        <script asp-append-version="true" src="~/js/form-consistency.js"></script>
        <script asp-append-version="true" src="~/js/genesis-form-guard.js"></script>
        <script asp-append-version="true" src="~/js/genesis-signature.js"></script>
         <script asp-append-version="true"src="~/js/section6-category-reset.js"></script>
         <script asp-append-version="true" src="~/js/section6-rules.js"></script>
        <script>
            (function () {
                'use strict';

                const maximumFiles = 10;
                const maximumFileSize = 20 * 1024 * 1024;
                const allowedExtensions = ['pdf', 'doc', 'docx', 'jpg', 'jpeg', 'png', 'xls', 'xlsx'];
                let selectedMultipurposeFiles = new DataTransfer();

                function fileKey(file) {
                    return [file.name, file.size, file.lastModified].join('|');
                }

                function safeText(value) {
                    return String(value || '')
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#039;');
                }

                function addMultipurposeFiles(files) {
                    const existing = new Set(Array.from(selectedMultipurposeFiles.files).map(fileKey));
                    const rejected = [];

                    Array.from(files || []).forEach(function (file) {
                        const extension = (file.name.split('.').pop() || '').toLowerCase();
                        const key = fileKey(file);

                        if (existing.has(key)) return;
                        if (!allowedExtensions.includes(extension)) {
                            rejected.push(file.name + ' is not a supported file type.');
                            return;
                        }
                        if (file.size > maximumFileSize) {
                            rejected.push(file.name + ' is larger than 20 MB.');
                            return;
                        }
                        if (selectedMultipurposeFiles.files.length >= maximumFiles) {
                            rejected.push('Only 10 supporting documents can be selected.');
                            return;
                        }

                        selectedMultipurposeFiles.items.add(file);
                        existing.add(key);
                    });

                    if (rejected.length) {
                        alert(Array.from(new Set(rejected)).join('\n'));
                    }
                }

                function renderMultipurposeFiles() {
                    const input = document.getElementById('multipurposeEvidenceInput');
                    const list = document.getElementById('multipurposeFileList');
                    const count = document.getElementById('multipurposeFileCount');
                    const fill = document.getElementById('multipurposeFileFill');
                    const dropzone = document.getElementById('multipurposeDropzone');
                    if (!input || !list) return;

                    input.files = selectedMultipurposeFiles.files;
                    const total = selectedMultipurposeFiles.files.length;

                    count.textContent = total + ' of ' + maximumFiles + ' files added';
                    fill.style.width = Math.min((total / maximumFiles) * 100, 100) + '%';
                    fill.classList.toggle('full', total >= maximumFiles);
                    dropzone.classList.toggle('full', total >= maximumFiles);
                    list.innerHTML = '';

                    Array.from(selectedMultipurposeFiles.files).forEach(function (file, index) {
                        const item = document.createElement('div');
                        item.className = 'obj-ev-file';
                        item.innerHTML =
                            '<i class="fa-solid fa-file"></i>' +
                            '<span class="obj-ev-name">' + safeText(file.name) + '</span>' +
                            '<span class="obj-ev-size">' + (file.size / 1024 / 1024).toFixed(2) + ' MB</span>' +
                            '<button type="button" class="obj-ev-remove" data-remove-multipurpose-file="' + index + '" title="Remove file">' +
                            '<i class="fa-solid fa-xmark"></i></button>';
                        list.appendChild(item);
                    });
                }

                function initialiseMultipurposeUpload() {
                    const input = document.getElementById('multipurposeEvidenceInput');
                    const browse = document.getElementById('multipurposeBrowseFiles');
                    const dropzone = document.getElementById('multipurposeDropzone');
                    const list = document.getElementById('multipurposeFileList');
                    if (!input || !browse || !dropzone || !list) return;

                    function openBrowser(event) {
                        if (event) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        input.click();
                    }

                    browse.addEventListener('click', openBrowser);
                    dropzone.addEventListener('click', openBrowser);
                    dropzone.addEventListener('keydown', function (event) {
                        if (event.key === 'Enter' || event.key === ' ') openBrowser(event);
                    });
                    dropzone.addEventListener('dragover', function (event) {
                        event.preventDefault();
                        dropzone.classList.add('dragover');
                    });
                    dropzone.addEventListener('dragleave', function () {
                        dropzone.classList.remove('dragover');
                    });
                    dropzone.addEventListener('drop', function (event) {
                        event.preventDefault();
                        dropzone.classList.remove('dragover');
                        addMultipurposeFiles(event.dataTransfer && event.dataTransfer.files);
                        renderMultipurposeFiles();
                    });
                    input.addEventListener('change', function () {
                        addMultipurposeFiles(input.files);
                        renderMultipurposeFiles();
                    });
                    list.addEventListener('click', function (event) {
                        const button = event.target.closest('[data-remove-multipurpose-file]');
                        if (!button) return;

                        const removeIndex = Number(button.dataset.removeMultipurposeFile);
                        const replacement = new DataTransfer();
                        Array.from(selectedMultipurposeFiles.files).forEach(function (file, index) {
                            if (index !== removeIndex) replacement.items.add(file);
                        });
                        selectedMultipurposeFiles = replacement;
                        renderMultipurposeFiles();
                    });

                    renderMultipurposeFiles();
                }

                function initialiseAutomaticSignature() {
                    const canvas = document.getElementById('signature');
                    const signatureData = document.getElementById('SignatureDataUrl');
                    const clear = document.getElementById('Clear');
                    const status = document.getElementById('signatureStatus');
                    const submit = document.getElementById('submitForm');
                    if (!canvas || !signatureData || !clear) return;

                    function canvasHasInk() {
                        const pixels = canvas.getContext('2d').getImageData(0, 0, canvas.width, canvas.height).data;
                        for (let index = 3; index < pixels.length; index += 4) {
                            if (pixels[index] !== 0) return true;
                        }
                        return false;
                    }

                    function captureSignature() {
                        window.requestAnimationFrame(function () {
                            if (!canvasHasInk()) return;
                            signatureData.value = canvas.toDataURL('image/png');
                            signatureData.dispatchEvent(new Event('change', { bubbles: true }));
                            status.textContent = 'Signature captured';
                            status.style.color = '#0f766e';
                            if (submit) submit.disabled = false;
                        });
                    }

                    canvas.addEventListener('mouseup', captureSignature);
                    canvas.addEventListener('touchend', captureSignature);
                    canvas.addEventListener('pointerup', captureSignature);

                    clear.addEventListener('click', function () {
                        canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);
                        signatureData.value = '';
                        status.textContent = 'No signature drawn';
                        status.style.color = '#6b6b6b';
                        if (submit) submit.disabled = true;
                    });
                }

                document.addEventListener('DOMContentLoaded', function () {
                    initialiseMultipurposeUpload();
                    initialiseAutomaticSignature();
                });
            })();
        </script>
        <script type="text/javascript">load();</script>
    
    }

