                    <div>
                        <span class="obj-prop-label">Property</span>
                        <span class="obj-prop-value">
                            @(TempData["AppealStatus"]?.ToString() == "True" ? messageProp : messagePD)
                        </span>
                    </div>
                    <input value="@(TempData["AppealStatus"]?.ToString() == "True" ? messageProp : messagePD)"
                           type="hidden" name="Property_Desc" id="Property_Desc" asp-for="Property_Desc" />
                    @{
                        TempData.Keep("AppealStatus");
