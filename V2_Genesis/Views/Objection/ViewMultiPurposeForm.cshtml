        .obj-ev-browse {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 20px;
            border: 0;
            border-radius: 8px;
            background: #006570;
            color: #fff;
            cursor: pointer;
            font: 700 13px 'Poppins', sans-serif;
        }

        #multipurposeEvidenceInput,
        #files { display: none; }

        .obj-ev-counter { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; color: #888; font: 12px 'Poppins', sans-serif; }
        .obj-ev-track { flex: 1; height: 5px; border-radius: 3px; background: #e8e8e8; }
        .obj-ev-fill { width: 0; height: 100%; border-radius: 3px; background: #006570; transition: width .25s; }
        .obj-ev-fill.full { background: #dc2626; }
        .obj-ev-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }

        .obj-ev-file {
            display: flex;
            align-items: center;
            gap: 10px;
