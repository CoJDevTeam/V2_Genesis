        <script>
                function toggleCompensationDetails(show) {
                    var box = document.getElementById('compensationDetails');
                    if (box) box.style.display = show ? 'block' : 'none';
                }

                // Show the payment details again when "Yes" is already chosen (e.g. after a page reload).
                document.addEventListener('DOMContentLoaded', function () {
                    var yes = document.querySelector('input[name="Compensation_Paid"][value="Yes"]');
                    toggleCompensationDetails(!!(yes && yes.checked));
                });
            </script>


