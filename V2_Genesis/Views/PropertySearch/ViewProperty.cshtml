@using System.Security.Claims
@model V2_Genesis.Models.Results.PropertyDetailViewModel
@{
    ViewData["Title"] = "Property Details";

    bool isAuth = User?.Identity?.IsAuthenticated == true;
    bool isUniversalSearch = Model?.IsUniversalSearch == true;
    Layout = isAuth
        ? "~/Views/Shared/_Legend_Layout.cshtml"
        : "~/Views/Shared/_Layout.cshtml";

    var items = Model?.Items ?? new List<V2_Genesis.Models.Results.PropertyDetailResult>();
    var d = Model?.Main ?? items.FirstOrDefault();
    var valuationItems = items
    .GroupBy(x => new
    {
        Cat = x.CatDesc?.Trim()?.ToUpperInvariant() ?? "",
        Ext = x.RateableArea?.Trim() ?? "",
        Mv = new string((x.MarketValue ?? "").Where(char.IsDigit).ToArray()),
        Wef = x.WefDate?.Trim() ?? "",
        UnitKey = x.UnitKey?.Trim() ?? "",
        ValuationKey = x.ValuationKey?.Trim() ?? ""
    })
    .Select(g => g.First())
    .ToList();
    var roll = Model?.Roll;

    bool isAttributes = Model?.IsAttributes == true ||
        string.Equals(Context?.Request?.Query["rollSource"].FirstOrDefault(), "Attributes", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Context?.Request?.Query["propertyFrom"].FirstOrDefault(), "Attributes", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Context?.Session?.GetString("RollSource"), "Attributes", StringComparison.OrdinalIgnoreCase);

    bool isQuery =
    string.Equals(
        Context?.Request?.Query["rollSource"].FirstOrDefault(),
        "Query",
        StringComparison.OrdinalIgnoreCase)
    ||
    string.Equals(
        Context?.Request?.Query["rollSource"].FirstOrDefault(),
        "Objection_Query",
        StringComparison.OrdinalIgnoreCase)
    ||
    string.Equals(
        Context?.Request?.Query["propertyFrom"].FirstOrDefault(),
        "Query",
        StringComparison.OrdinalIgnoreCase)
    ||
    string.Equals(
        Context?.Request?.Query["propertyFrom"].FirstOrDefault(),
        "Objection_Query",
        StringComparison.OrdinalIgnoreCase)
    ||
    string.Equals(
        Context?.Session?.GetString("RollSource"),
        "Query",
        StringComparison.OrdinalIgnoreCase)
    ||
    string.Equals(
        Context?.Session?.GetString("RollSource"),
        "Objection_Query",
        StringComparison.OrdinalIgnoreCase);
    bool isLis = Model?.IsLis == true ||
string.Equals(Context?.Request?.Query["propertyFrom"].FirstOrDefault(), "LIS", StringComparison.OrdinalIgnoreCase) ||
string.Equals(Context?.Session?.GetString("PropertyFrom"), "LIS", StringComparison.OrdinalIgnoreCase);

    string rollName = isAttributes
     ? "Attributes Property Information"
     : isLis
         ? "Land Information System Property Information"
         : roll?.Name ?? "Property Information";

    string rollShort = isAttributes
        ? "Attributes"
        : isLis
            ? "LIS"
            : roll?.Short ?? "";

    string rollSource = isAttributes
        ? "Attributes"
        : roll?.Source ?? "";
    string sourceTableCode = roll?.SourceTableCode ?? "";
    string returnUrl = $"{Context?.Request?.Path}{Context?.Request?.QueryString}";

    var currentEmail = User.FindFirstValue(ClaimTypes.Name) ?? "";
    bool isAdmin = !string.IsNullOrEmpty(currentEmail) && (
        currentEmail.Equals("AdministrationEnquiries@Joburg.org.za", StringComparison.OrdinalIgnoreCase) ||
        System.Text.RegularExpressions.Regex.IsMatch(currentEmail,
            @"^val\.admin(1[0-9]?|[1-9])@joburg\.org\.za$",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase));
}

@section Styles {
    <link href="~/css/views/property-detail.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/property-search.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/searchpropertycss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/viewpropertysearch.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/attribute-link-verification.css" rel="stylesheet" asp-append-version="true" />
}



@if (d is null)
{
    <div class="ppd-page">
        <div class="ppd-not-found">
            <i class="fa-solid fa-circle-exclamation"></i>
            <h2>Property Not Found</h2>
            <p>The requested property details could not be loaded. Please go back and try again.</p>
            <a href="javascript:history.back()" class="ppd-btn ppd-btn-outline">
                <i class="fa-solid fa-arrow-left"></i> Go Back
            </a>
        </div>
    </div>
    return;
}

<div class="ppd-page">

    <div class="ppd-hero">
        <div class="ppd-hero-inner">
            <div class="ppd-hero-icon">
                <i class="fa-solid fa-building"></i>
            </div>
            <div class="ppd-hero-text">
                <div class="ppd-hero-eyebrow">City of Johannesburg · Valuation Services</div>
                <h1 class="ppd-hero-title">
                    Property Details — <span>@(d.PropertyDesc ?? rollName)</span>
                </h1>
                <p class="ppd-hero-sub">
                    @rollName &nbsp;·&nbsp; @(d.TownNameDesc ?? "") &nbsp;·&nbsp;
                    @(valuationItems.Count) categor@(valuationItems.Count == 1 ? "y" : "ies")
                </p>
            </div>
            <div class="ppd-hero-right">
                <div class="ppd-roll-chip">
                    <i class="fa-solid fa-scroll"></i>
                    @rollShort
                </div>
                <a href="javascript:history.back()" class="ppd-back-btn">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
            </div>
        </div>
    </div>

  
    <div class="ppd-body">

        @if (!isAttributes && !isQuery && !isLis && !isAdmin &&
             Model?.VisibleUntil is DateTime vpClosedAt &&
             DateTime.Now > vpClosedAt)
        {
            <div class="ppd-period-banner" role="status"
                 style="display:flex;gap:12px;align-items:flex-start;background:#fef2f2;border:1px solid #dc2626;border-left:4px solid #dc2626;border-radius:10px;padding:14px 16px;margin-bottom:18px;color:#b91c1c;font-size:14px;font-weight:500;">
                <i class="fa-solid fa-calendar-xmark" style="color:#dc2626;font-size:18px;margin-top:2px;"></i>
                <div>
                    <strong style="color:#991b1b;">The objection period for @(string.IsNullOrWhiteSpace(rollShort) ? "this roll" : rollShort) closed on @vpClosedAt.ToString("d MMMM yyyy 'at' HH:mm", System.Globalization.CultureInfo.GetCultureInfo("en-ZA")).</strong><br />
                    You can still view the property details, but the property can no longer be linked and an objection can no longer be lodged.
                </div>
            </div>
        }


        <div class="ppd-card">
            <div class="ppd-card-hdr">
                <i class="fa-solid fa-map-marker-alt"></i>
                Basic Information
                <span class="ppd-card-badge">Main Details</span>
            </div>
            <div class="ppd-card-body">

                <div class="ppd-row">
                    <span class="ppd-label"><i class="fa-solid fa-info-circle"></i> Property Description</span>
                    <input class="ppd-val" disabled value="@d.PropertyDesc" />
                </div>

                <div class="ppd-row">
                    <span class="ppd-label"><i class="fa-solid fa-city"></i> Township</span>
                    <input class="ppd-val" disabled value="@d.TownNameDesc" />
                </div>

                <div class="ppd-row">
                    <span class="ppd-label"><i class="fa-solid fa-home"></i> Stand / Portion / Re</span>
                    <div class="ppd-val-group">
                        <div class="ppd-val-sub">
                            <span class="ppd-sub-label">Stand</span>
                            <input class="ppd-val" disabled value="@d.Erf" />
                        </div>
                        <div class="ppd-val-sub">
                            <span class="ppd-sub-label">Portion</span>
                            <input class="ppd-val" disabled value="@d.Ptn" />
                        </div>
                        <div class="ppd-val-sub">
                            <span class="ppd-sub-label">Re</span>
                            <input class="ppd-val" disabled value="@(d.Re ?? "–")" />
                        </div>
                    </div>
                </div>

                <div class="ppd-row">
                    <span class="ppd-label"><i class="fa-solid fa-map-pin"></i> Address</span>
                    <input class="ppd-val" disabled value="@(d.LisStreetAddress ?? "–")" />
                </div>

                <div class="ppd-row">
                    <span class="ppd-label"><i class="fa-solid fa-file-contract"></i> Lease</span>
                    <input class="ppd-val" disabled value="@(d.LeaseDesc ?? "–")" />
                </div>

                @if (!isUniversalSearch)
                {
                    <div class="ppd-row">
                        <span class="ppd-label"><i class="fa-solid fa-user"></i> Owner</span>
                        @* POPIA: the owner's name is not shown to anyone on this page. *@
                        <input class="ppd-val" disabled value="" placeholder="Hidden to protect personal information (POPIA)" />
                    </div>
                }

            </div>
        </div>

    
        <div class="ppd-toggle-btn" id="toggle-valuation">
            <div class="ppd-toggle-hdr" onclick="toggleSection('valuation-body','valuation-chev')">
                <div class="ppd-toggle-hdr-left">
                    <i class="fa-solid fa-chart-line"></i>
                    Property Categories &amp; Valuations
                    <span class="ppd-toggle-count">
                        @valuationItems.Count @(valuationItems.Count == 1 ? "item" : "items")
                    </span>
                </div>
                <i class="fa-solid fa-chevron-down ppd-chevron" id="valuation-chev"
                   style="transform:rotate(180deg);"></i>
            </div>
            <div class="ppd-collapse-body open" id="valuation-body">
                <div class="ppd-collapse-inner">
                    @for (int i = 0; i < valuationItems.Count; i++)
                    {
                        var item = valuationItems[i];
                        if (i > 0)
                        {
                            <div class="ppd-divider"></div>
                        }
                        <div class="ppd-inner-card">
                            <div class="ppd-row">
                                <span class="ppd-label"><i class="fa-solid fa-tag"></i> Category</span>
                                <input class="ppd-val" disabled value="@(item.CatDesc ?? "–")" />
                            </div>
                            <div class="ppd-row">
                                <span class="ppd-label"><i class="fa-solid fa-chart-bar"></i> Valuation</span>
                                <div class="ppd-val-group">
                                    <div class="ppd-val-sub">
                                        <span class="ppd-sub-label"><i class="fa-solid fa-ruler-combined"></i> Extent</span>
                                        <input class="ppd-val pd-rateable" disabled value="@(item.RateableArea ?? "–")" />
                                    </div>
                                    <div class="ppd-val-sub">
                                        <span class="ppd-sub-label"><i class="fa-solid fa-calendar"></i> Effective Date</span>
                                        <input class="ppd-val" disabled value="@(string.IsNullOrWhiteSpace(item.WefDate) ? "–" : V2_Genesis.Helpers.WefDateFormatter.Format(item.WefDate))" />
                                    </div>
                                    <div class="ppd-val-sub">
                                        <span class="ppd-sub-label"><i class="fa-solid fa-money-bill-wave"></i> Market Value</span>
                                        <input class="ppd-val ppd-mv pd-market-val" disabled value="@(item.MarketValue ?? "–")" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="ppd-toggle-btn" id="toggle-additional">
            <div class="ppd-toggle-hdr" onclick="toggleSection('additional-body','additional-chev')">
                <div class="ppd-toggle-hdr-left">
                    <i class="fa-solid fa-clipboard-list"></i>
                    Additional Details
                </div>
                <i class="fa-solid fa-chevron-down ppd-chevron" id="additional-chev"></i>
            </div>
            <div class="ppd-collapse-body" id="additional-body">
                <div class="ppd-collapse-inner">
                    <div class="ppd-inner-card">
                        <div class="ppd-row">
                            <span class="ppd-label"><i class="fa-solid fa-comment"></i> Remarks</span>
                            <input class="ppd-val" disabled value="@(d.Reason ?? "–")" />
                        </div>
                        <div class="ppd-row">
                            <span class="ppd-label"><i class="fa-solid fa-calendar-day"></i> Valuation Date</span>
                            <input class="ppd-val" disabled value="@(string.IsNullOrWhiteSpace(d.ValuationDate) ? "–" : V2_Genesis.Helpers.WefDateFormatter.Format(d.ValuationDate))" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

       
        <div class="ppd-toggle-btn" id="toggle-scheme">
            <div class="ppd-toggle-hdr" onclick="toggleSection('scheme-body','scheme-chev')">
                <div class="ppd-toggle-hdr-left">
                    <i class="fa-solid fa-building"></i>
                    Scheme Details
                </div>
                <i class="fa-solid fa-chevron-down ppd-chevron" id="scheme-chev"></i>
            </div>
            <div class="ppd-collapse-body" id="scheme-body">
                <div class="ppd-collapse-inner">
                    <div class="ppd-inner-card">
                        <div class="ppd-row">
                            <span class="ppd-label"><i class="fa-solid fa-sitemap"></i> Scheme Name</span>
                            <input class="ppd-val" disabled value="@(d.SchemeName ?? "–")" />
                        </div>
                        <div class="ppd-row">
                            <span class="ppd-label"><i class="fa-solid fa-info-circle"></i> Scheme Details</span>
                            <div class="ppd-val-group">
                                <div class="ppd-val-sub">
                                    <span class="ppd-sub-label">Scheme No.</span>
                                    <input class="ppd-val" disabled value="@(d.SchemeNumber ?? "–")" />
                                </div>
                                <div class="ppd-val-sub">
                                    <span class="ppd-sub-label">Scheme Year</span>
                                    <input class="ppd-val" disabled value="@(d.SchemeYear ?? "–")" />
                                </div>
                                <div class="ppd-val-sub">
                                    <span class="ppd-sub-label">Unit No.</span>
                                    <input class="ppd-val" disabled value="@(d.UnitNo > 0 ? d.UnitNo.ToString() : "–")" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

      
        <div class="ppd-actions">
            @if (isUniversalSearch && isAuth)
            {
                <div class="ppd-anon-action-notice">
                    <i class="fa-solid fa-eye"></i>
                    This is a public, read-only property view.
                </div>
                <button type="button" class="ppd-btn ppd-btn-outline" onclick="history.back()">
                    <i class="fa-solid fa-arrow-left"></i> Back to Global Search
                </button>
            }
            else if (!isAuth && !isAttributes)
            {
                // Signed-out visitor: may view, but must sign in to link.
                // The link is remembered and completed straight after sign-in.
                var anonCanLink =
                    !string.IsNullOrWhiteSpace(rollSource)
                    && (isQuery || Model.IsWithinObjectionPeriod || isLis);

                if (anonCanLink)
                {
                    var anonLinkKey = isQuery
                        ? d.Id
                        : isLis
                            ? (!string.IsNullOrWhiteSpace(d.PropertyId)
                                ? d.PropertyId
                                : !string.IsNullOrWhiteSpace(d.UnitKey)
                                    ? d.UnitKey
                                    : d.ValuationKey)
                            : d.Id;

                    var anonLinkQuery = new Dictionary<string, string?>
                    {
                        ["rollSource"] = rollSource,
                        ["key"] = anonLinkKey,
                        ["sourceTable"] = sourceTableCode,
                        ["propertyFrom"] = isQuery ? null : (isLis ? "LIS" : sourceTableCode),
                        ["unitKey"] = d.UnitKey,
                        ["valuationKey"] = d.ValuationKey?.ToString(),
                        ["propertyId"] = d.PropertyId,
                        ["desc"] = d.PropertyDesc
                    };

                    var anonLinkUrl = "/property/link-after-login" +
                        Microsoft.AspNetCore.Http.QueryString.Create(
                            anonLinkQuery
                                .Where(x => !string.IsNullOrWhiteSpace(x.Value))
                                .Select(x => new KeyValuePair<string, string?>(x.Key, x.Value)))
                            .ToUriComponent();

                    <div class="ppd-anon-action-notice">
                        <i class="fa-solid fa-lock"></i>
                        To link this property@(isQuery ? " and lodge a Section 78 Query" : ", lodge an objection and access Section 49"),
                        please sign in. We will remember this property and link it for you as soon as you are signed in.
                    </div>
                    <a href="@anonLinkUrl" class="ppd-btn ppd-btn-primary">
                        <i class="fa-solid fa-link"></i> Sign In &amp; Link Property
                    </a>
                    <a href="@(anonLinkUrl + "&register=true")" class="ppd-btn ppd-btn-outline">
                        <i class="fa-solid fa-user-plus"></i> Register &amp; Link
                    </a>
                    <button type="button" class="ppd-btn ppd-btn-outline" onclick="history.back()">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </button>
                }
                else
                {
                    <div class="ppd-period-ended">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        The objection period@(string.IsNullOrWhiteSpace(rollShort) ? "" : " for ")<strong>@rollShort</strong> has passed.
                        You can still view the property details, but it can no longer be linked.
                    </div>
                    <button type="button" class="ppd-btn ppd-btn-outline" onclick="history.back()">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </button>
                }
            }
            else if (!isAuth)
            {
                <div class="ppd-anon-action-notice">
                    <i class="fa-solid fa-lock"></i>
                    Sign in to link this property@(isAttributes ? "" : ", lodge an objection and access Section 49").
                </div>
                <a href="/login?returnUrl=@Uri.EscapeDataString(returnUrl)"
                       class="ppd-btn ppd-btn-primary">
                    <i class="fa-solid fa-right-to-bracket"></i> Sign In
                </a>
                <a href="/register" class="ppd-btn ppd-btn-outline">
                    <i class="fa-solid fa-user-plus"></i> Register
                </a>
                <button class="ppd-btn ppd-btn-outline" onclick="history.back()">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </button>
            }
            else if (isAttributes)
            {
                <button class="ppd-btn ppd-btn-outline" onclick="history.back()">
                    <i class="fa-solid fa-arrow-left"></i> Back to Search
                </button>
                <form method="post" action="/attributes/link" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idProperty" value="@(d.UnitKey ?? d.ValuationKey.ToString())" />
                    <input type="hidden" name="propertyFrom" value="Attributes" />
                    <button type="button"
                            class="ppd-btn ppd-btn-primary"
                            data-attr-secure-link
                            data-unit-key="@(d.UnitKey ?? d.ValuationKey?.ToString())">
                        <i class="fa-solid fa-link"></i>
                        Link to My Attributes
                    </button>
                </form>
            }
            else if (rollSource.Contains("Query", StringComparison.OrdinalIgnoreCase))
            {
                <button class="ppd-btn ppd-btn-outline" onclick="history.back()">
                    <i class="fa-solid fa-arrow-left"></i> Cancel
                </button>
                <a class="ppd-btn ppd-btn-primary"
                       href="/property/save?rollSource=@rollSource&key=@d.Id&sourceTable=@sourceTableCode&unitKey=@d.UnitKey&valuationKey=@d.ValuationKey&propertyId=@d.PropertyId">
                    <i class="fa-solid fa-link"></i> Link Property
                </a>
            }
            else if (isAdmin)
            {
                <button class="ppd-btn ppd-btn-outline" onclick="history.back()">
                    <i class="fa-solid fa-arrow-left"></i> Cancel
                </button>

                @if (!string.IsNullOrWhiteSpace(rollSource))
                {
                                            
                    var linkKey = isLis
                        ? (!string.IsNullOrWhiteSpace(d.PropertyId)
                            ? d.PropertyId
                            : !string.IsNullOrWhiteSpace(d.UnitKey)
                                ? d.UnitKey
                                : d.ValuationKey)
                        : d.Id.ToString();

                    var linkPropertyFrom = isLis ? "LIS" : sourceTableCode;

                        
                    <a class="ppd-btn ppd-btn-primary"
                           href="/property/save?rollSource=@rollSource&key=@linkKey&sourceTable=@sourceTableCode&propertyFrom=@linkPropertyFrom&unitKey=@d.UnitKey&valuationKey=@d.ValuationKey&propertyId=@d.PropertyId">
                        <i class="fa-solid fa-link"></i> Link Property
                    </a>
                    @*  <a class="ppd-btn ppd-btn-primary"
                           href="/property/save?rollSource=@rollSource&key=@d.Id&sourceTable=@sourceTableCode&propertyFrom=@(isLis ? "LIS" : rollSource)">
                        <i class="fa-solid fa-link"></i> Link Property
                    </a> *@

                    @if (!isLis && !string.IsNullOrWhiteSpace(sourceTableCode))
                    {
                        <a class="ppd-btn ppd-btn-secondary"
                               href="/notice/section49?rollSource=@rollSource&unitKey=@d.UnitKey&valuationKey=@d.ValuationKey">
                            <i class="fa-solid fa-eye"></i> View Section 49
                        </a>

                        <a class="ppd-btn ppd-btn-outline"
                               href="/notice/section49/download?rollSource=@rollSource&unitKey=@d.UnitKey&valuationKey=@d.ValuationKey">
                            <i class="fa-solid fa-download"></i> Download Section 49
                        </a>
                    }
                }
            }
            else if (Model.IsWithinObjectionPeriod || isLis)
            {
                <button class="ppd-btn ppd-btn-outline" onclick="history.back()">
                    <i class="fa-solid fa-arrow-left"></i> Cancel
                </button>

                @if (!string.IsNullOrWhiteSpace(rollSource))
                {
                    var linkKey = isLis
                              ? (!string.IsNullOrWhiteSpace(d.PropertyId)
                                  ? d.PropertyId
                                  : !string.IsNullOrWhiteSpace(d.UnitKey)
                                      ? d.UnitKey
                                      : d.ValuationKey)
                              : d.Id.ToString();

                    var linkPropertyFrom = isLis ? "LIS" : sourceTableCode;

                        
                    <a class="ppd-btn ppd-btn-primary"
                           href="/property/save?rollSource=@rollSource&key=@linkKey&sourceTable=@sourceTableCode&propertyFrom=@linkPropertyFrom&unitKey=@d.UnitKey&valuationKey=@d.ValuationKey&propertyId=@d.PropertyId">
                        <i class="fa-solid fa-link"></i> Link Property
                    </a>
                    @*    <a class="ppd-btn ppd-btn-primary"
                           href="/property/save?rollSource=@rollSource&key=@d.Id&sourceTable=@sourceTableCode&propertyFrom=@(isLis ? "LIS" : rollSource)">
                        <i class="fa-solid fa-link"></i> Link Property
                    </a> *@

                    @if (!isLis && !string.IsNullOrWhiteSpace(sourceTableCode))
                    {
                        <a class="ppd-btn ppd-btn-secondary"
                               href="/notice/section49?rollSource=@rollSource&unitKey=@d.UnitKey&valuationKey=@d.ValuationKey">
                            <i class="fa-solid fa-eye"></i> View Section 49
                        </a>

                        <a class="ppd-btn ppd-btn-outline"
                               href="/notice/section49/download?rollSource=@rollSource&unitKey=@d.UnitKey&valuationKey=@d.ValuationKey">
                            <i class="fa-solid fa-download"></i> Download Section 49
                        </a>
                    }
                }
            }
            else
            {
                <div class="ppd-period-ended">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    The objection period for <strong>@rollShort</strong> has passed.
                    You can still view the property details, but it can no longer be linked.
                </div>
                <button class="ppd-btn ppd-btn-outline" onclick="history.back()">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </button>
            }
        </div>

    </div>
</div>
@if (isAuth && isAttributes)
{
    <partial name="_AttributeLinkVerificationModal" />
}

@section Scripts {
    <script>
        function toggleSection(bodyId, chevId) {
            const body = document.getElementById(bodyId);
            const chev = document.getElementById(chevId);
            const isOpen = body.classList.toggle('open');
            chev.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
            if (isOpen)
                setTimeout(() => body.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 320);
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.pd-market-val').forEach(function (el) {
                const raw = parseFloat(el.value.replace(/[^0-9.-]+/g, ''));
                if (!isNaN(raw) && raw > 0)
                    el.value = raw.toLocaleString('en-ZA', {
                        style: 'currency', currency: 'ZAR',
                        minimumFractionDigits: 0, maximumFractionDigits: 0
                    });
            });

            document.querySelectorAll('.pd-rateable').forEach(function (el) {
                const raw = el.value.trim();
                if (raw && raw !== '–')
                    el.value = raw.replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
            });
        });
    </script>
    <script src="~/js/attribute-link-verification.js" asp-append-version="true"></script>
}