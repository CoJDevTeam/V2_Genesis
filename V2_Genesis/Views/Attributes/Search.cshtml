﻿@using V2_Genesis.Models
@{
    ViewData["Title"] = "Search Property — Attributes";
    //Layout = "~/Views/Shared/_ClientLayout.cshtml";
    Layout = "~/Views/Shared/_Legend_Layout.cshtml";

    var townships = V2_Genesis.Helpers.NaturalSort.Order(ViewBag.Townships as List<string>);
    var schemes = ViewBag.Schemes as List<string> ?? new();
    var results = ViewBag.Results as List<PropertySearchResult>;
    var count = ViewBag.ResultCount as int? ?? 0;
    var p = ViewBag.SearchParams as PropertySearchParams;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" />
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/atrributes-search.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/attribute-link-verification.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet"href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css" />
}

<div class="as-page">
    <div class="as-inner">

        <!-- ── Page heading ───────────────────────────────────────── -->
        <div class="as-heading">
            <div class="as-heading-icon">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <div>
                <h1 class="as-title">Search Property</h1>
                <p class="as-subtitle">
                    Find and link your property to submit attribute information
                </p>
            </div>
            <a href="/attributes/about" class="as-about-link">
                <i class="fa-solid fa-circle-info"></i>
                What are Attributes?
            </a>
        </div>

        <!-- ── Search card ────────────────────────────────────────── -->
        <div class="as-card">
            <div class="as-card-header">
                <i class="fa-solid fa-database"></i>
                Property Search
                <span class="as-card-sub">
                    Enter at least one field to search
                </span>
            </div>

            <form method="post" action="/attributes/search">
                @Html.AntiForgeryToken()

                @if (ViewBag.Error is not null)
                {
                    <div class="as-error-banner">
                        <i class="fa-solid fa-circle-xmark"></i>
                        @ViewBag.Error
                    </div>
                }

                <div class="as-form-grid">

                    <!-- Township -->
                    <div class="as-field as-field-wide">
                        <label class="as-label" for="SearchTownName">
                            <i class="fa-solid fa-map-pin"></i> Township
                        </label>
                        <select id="SearchTownName"
                                name="SearchTownName"
                                class="as-input coj-township-select">
                            <option value="">— Select Township —</option>
                            @foreach (var t in townships)
                            {
                                var sel = p?.TownName == t ? "selected" : null;

                                <option value="@t" selected="@sel">@t</option>
                            }

                           
                        </select>
                    </div>

                    <!-- Stand / ERF -->
                    <div class="as-field">
                        <label class="as-label" for="SearchStand">
                            <i class="fa-solid fa-hashtag"></i> ERF / Stand No.
                        </label>
                        <input type="text"
                               id="SearchStand"
                               name="SearchStand"
                               class="as-input"
                               placeholder="e.g. 1234"
                               value="@(p?.Stand ?? "")" />
                    </div>

                    <!-- Street Address -->
                    <div class="as-field">
                        <label class="as-label" for="SearchAddress">
                            <i class="fa-solid fa-road"></i> Street Address
                        </label>
                        <input type="text"
                               id="SearchAddress"
                               name="SearchAddress"
                               class="as-input"
                               placeholder="e.g. 123 Main Street"
                               value="@(p?.Address ?? "")" />
                    </div>

                    <!-- Scheme -->
                    <div class="as-field">
                        <label class="as-label" for="SearchScheme">
                            <i class="fa-solid fa-building"></i> Scheme Name
                        </label>
                        <select id="SearchScheme"
                                name="SearchScheme"
                                class="as-input">
                            <option value="">— Select Scheme (optional) —</option>

                          
                            @foreach (var s in schemes)
                            {
                                var sel = p?.TownName == s ? "selected" : null;

                                <option value="@s" selected="@sel">@s</option>
                            }
                        </select>
                    </div>

                    <!-- Unit No -->
                    <div class="as-field">
                        <label class="as-label" for="SearchUnit">
                            <i class="fa-solid fa-door-open"></i> Unit No.
                        </label>
                        <input type="text"
                               id="SearchUnit"
                               name="SearchUnit"
                               class="as-input"
                               placeholder="e.g. 5"
                               value="@(p?.Unit ?? "")" />
                    </div>

                    <!-- Search button -->
                    <div class="as-field as-field-btn">
                        <button type="submit" class="as-search-btn">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            Search Property
                        </button>
                    </div>

                </div>
            </form>
        </div>

        <!-- ── Results ────────────────────────────────────────────── -->
        @if (results is not null)
        {
            <div class="as-results-wrap">
                <div class="as-results-header">
                    <span class="as-results-count">
                        <i class="fa-solid fa-list"></i>
                        @count propert@(count == 1 ? "y" : "ies") found
                    </span>
                </div>

                @if (!results.Any())
                {
                    <div class="as-no-results">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <h3>No Properties Found</h3>
                        <p>
                            Try adjusting your search — remove some filters
                            or search by township only.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table id="attrResultsTable"
                               class="display table as-table">
                            <thead>
                                <tr>
                                    <th>TOWNSHIP</th>
                                    <th>ADDRESS</th>
                                    <th>ERF</th>
                                    <th>PTN</th>
                                    <th>CATEGORY</th>
                                    <th>EXTENT</th>
                                    <th>MARKET VALUE</th>
                                    <th>SCHEME</th>
                                    <th>UNIT</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in results)
                                {
                                    <tr>
                                        <td>@(item.TownNameDesc ?? "–")</td>
                                        <td>@(item.LisStreetAddress ?? "–")</td>
                                        <td>@item.Erf</td>
                                        <td>@item.Ptn</td>
                                        <td>@(item.CatDesc ?? "–")</td>
                                        <td>@(item.RateableArea ?? "–")</td>
                                        <td class="as-value">@item.MarketValue</td>
                                        <td>@(item.SchemeName ?? "–")</td>
                                        <td>@(item.UnitNo > 0 ? item.UnitNo.ToString() : "–")</td>
                                        <td>
                                            <div class="as-row-actions">
                                                @* View full detail *@
                                                @{
                                                    var viewUrl =
       $"/property/view?rollSource=Attributes" +
       $"&unitKey={item.UnitKey}" +
       $"&valuationKey={item.ValuationKey}" +
       $"&propertyFrom=Attributes";
                                                }
                                                <a href="@viewUrl"
                                                       class="as-btn as-btn-view">
                                                    <i class="fa-solid fa-eye"></i>
                                                    View
                                                </a>

                                                @if (ViewBag.IsAuth as bool? == true)
                                                {
                                                    <form method="post" action="/attributes/link" style="display:inline;">
                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden" name="idProperty" value="@item.UnitKey" />
                                                        <input type="hidden" name="propertyFrom" value="Attributes" />

                                                        <button type="button"
                                                                class="as-btn as-btn-link"
                                                                data-attr-secure-link
                                                                data-unit-key="@item.UnitKey"
                                                            @(string.IsNullOrWhiteSpace(item.UnitKey) ? "disabled" : null)>
                                                            <i class="fa-solid fa-link"></i> Link
                                                        </button>


                                                    </form>
                                                }
                                                else
                                                {
                                                    <a href="/account/login?returnUrl=/attributes/search"
                                                           class="as-btn as-btn-view">
                                                        <i class="fa-solid fa-lock"></i> Sign In to Link
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

    </div>
</div>
@if (ViewBag.IsAuth as bool? == true)
{
    <partial name="_AttributeLinkVerificationModal" />
}

@section Scripts {

    <!-- ============================================================
         DATATABLES CORE
         ============================================================ -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <!-- ============================================================
         DATATABLES RESPONSIVE
         Required for the mobile + expandable row
         ============================================================ -->
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <!-- ============================================================
         ATTRIBUTE ACCOUNT / STATEMENT PIN VERIFICATION
         ============================================================ -->
    <script src="~/js/attribute-link-verification.js"
            asp-append-version="true"></script>

    <script>
        $(document).ready(function () {

        // ========================================================
        // ATTRIBUTE PROPERTY SEARCH RESULTS
        // ========================================================
        const tableSelector = '#attrResultsTable';

        if (!$(tableSelector).length) {
        return;
        }

        // Prevent duplicate DataTable initialisation.
        if ($.fn.DataTable.isDataTable(tableSelector)) {
        return;
        }

        $(tableSelector).DataTable({

        // ====================================================
        // MOBILE RESPONSIVE MODE
        //
        // Hidden columns collapse under the + control.
        // The whole page must NOT scroll horizontally.
        // ====================================================
        responsive: {
        details: {
        type: 'inline',
        target: 'tr'
        }
        },

        scrollX: false,
        scrollCollapse: false,
        autoWidth: false,
        destroy: true,

        // ====================================================
        // DATATABLE LAYOUT
        // ====================================================
        dom:
        '<"as-dt-top"lf>' +
        'rt' +
        '<"as-dt-bottom"ip>',

        lengthMenu: [
                // Never show all rows: maximum 30 per page.
                [10, 20, 30],
                [10, 20, 30]
            ],

        pageLength: 10,

        // ====================================================
        // LANGUAGE
        // ====================================================
        language: {
        search: '_INPUT_',
        searchPlaceholder: 'Filter results…',

        lengthMenu: 'Show _MENU_ entries',

        emptyTable: 'No properties found',

        info: 'Showing _START_ to _END_ of _TOTAL_',

        infoEmpty: 'No properties found',

        infoFiltered: '(filtered from _MAX_ total)'
        },

        // ====================================================
        // COLUMN RESPONSIVENESS
        //
        // Column indexes:
        //
        // 0 Township
        // 1 Address
        // 2 ERF
        // 3 PTN
        // 4 Category
        // 5 Extent
        // 6 Market Value
        // 7 Scheme
        // 8 Unit
        // 9 Actions
        // ====================================================
        columnDefs: [

        // Township - always visible
        {
        targets: 0,
        className: 'all',
        responsivePriority: 1
        },

        // ERF - always visible
        {
        targets: 2,
        className: 'all',
        responsivePriority: 2
        },

        // Actions - always visible
        {
        targets: 9,
        className: 'all',
        responsivePriority: 3,
        orderable: false,
        searchable: false
        },

        // Address
        {
        targets: 1,
        responsivePriority: 4
        },

        // PTN
        {
        targets: 3,
        responsivePriority: 5
        },

        // Category
        {
        targets: 4,
        responsivePriority: 6
        },

        // Market Value
        {
        targets: 6,
        responsivePriority: 7
        },

        // Unit
        {
        targets: 8,
        responsivePriority: 8
        },

        // Extent
        {
        targets: 5,
        responsivePriority: 9
        },

        // Scheme
        {
        targets: 7,
        responsivePriority: 10
        }
        ],
        // ====================================================
        // DRAW
        // Reformat Market Value whenever DataTables redraws.
        // ====================================================
        drawCallback: function () {

        formatAttrValues();

        // Recalculate responsive layout.
        if (this.api().responsive) {
        this.api().responsive.recalc();
        }
        },

        // ====================================================
        // INITIAL LOAD
        // ====================================================
        initComplete: function () {

        const api = this.api();

        formatAttrValues();

        // Make sure responsive columns are calculated
        // using the actual container width.
        api.columns.adjust();

        if (api.responsive) {
        api.responsive.recalc();
        }
        }
        });


        // ========================================================
        // WINDOW RESIZE
        //
        // Important when moving between:
        // Desktop -> Tablet -> Mobile in Edge DevTools.
        // ========================================================
        let resizeTimer = null;

        $(window).on('resize.attrResultsTable', function () {

        clearTimeout(resizeTimer);

        resizeTimer = setTimeout(function () {

        if (!$.fn.DataTable.isDataTable(tableSelector)) {
        return;
        }

        const table =
        $(tableSelector).DataTable();

        table.columns.adjust();

        if (table.responsive) {
        table.responsive.recalc();
        }

        }, 150);
        });
        });


        // ============================================================
        // FORMAT ATTRIBUTE MARKET VALUES
        // ============================================================
        function formatAttrValues() {

        document
        .querySelectorAll('.as-value')
        .forEach(function (el) {

        // Prevent formatting an already-formatted value
        // incorrectly.
        const rawText =
        (el.textContent || '')
        .replace(/\s/g, '')
        .replace(/R/gi, '')
        .replace(/,/g, '')
        .trim();

        const raw =
        parseFloat(
        rawText.replace(/[^0-9.-]+/g, '')
        );

        if (isNaN(raw) || raw < 0) {
        return;
        }

        el.textContent =
        raw.toLocaleString(
        'en-ZA',
        {
        style: 'currency',
        currency: 'ZAR',
        minimumFractionDigits: 0,
        maximumFractionDigits: 0
        }
        );
        });
        }
    </script>
}
