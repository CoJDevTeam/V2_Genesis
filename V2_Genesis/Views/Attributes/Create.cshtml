        @* ════════════════════════════════════════════════
   SECTION 2 — CONTACT INFO (same on all forms)
   Hidden on online form:
   ID Number, Date of Birth, Gender, Marital Status,
   Citizenship, Fax Number, Interviewed, Maiden Name
════════════════════════════════════════════════ *@
        <div class="attr-card">
            <div class="attr-title">
                <i class="fa-solid fa-address-book" style="color:var(--at-gold);margin-right:8px;"></i>
                Section 2: Contact Information
            </div>

            <div class="attr-divider">
                <div class="line"></div>
                <div class="dot"></div>
                <div class="line"></div>
            </div>

            @{
                var isRepresentativeSubmission =
                    ViewBag.RepRequired == true ||
                    Model.RepresentativeDetails?.IsRepresentative == true;
            }
            @for (int i = 0; i < Model.ContactInfos.Count; i++)
            {
                <div class="attr-section-title">
                    <span class="num">@(i + 1)</span>
                    <span>Contact Details</span>
                </div>

                @* POPIA: the owner's details from the roll (name, ID number,
                   addresses, phone numbers) are kept on the server and are not
                   in this page. They are added back when the form is submitted. *@
                <input asp-for="ContactInfos[i].ContactType" type="hidden" />
                <input asp-for="ContactInfos[i].IsCompany" type="hidden" />
                <input asp-for="ContactInfos[i].Interviewed" type="hidden" />
                <input asp-for="ContactInfos[i].Comments" type="hidden" />

                @if (isRepresentativeSubmission && i == 0)
                {
                    <div class="attr-contact-privacy-note">
                        <i class="fa-solid fa-shield-halved"></i>
                        To protect the owner's personal information (POPIA), the owner's contact details on
                        record are not shown. The City will use them to keep the owner informed. Your own
                        contact details are the ones you entered as the representative.
                    </div>
                    continue;
                }

                <div class="attr-contact-privacy-note">
                    <i class="fa-solid fa-shield-halved"></i>
                    To protect personal information (POPIA), the details on record are not shown.
                    Enter the e-mail address and cell number the City should use to contact you about this submission.
                </div>

                <table class="attr-table contact-table" data-contact-index="@i">
                    <tr>
                        <td class="attr-label">Email <span class="req">*</span></td>
                        <td>
                            <input type="hidden"
                                   asp-for="ContactInfos[i].Email"
                                   class="masked-contact-real"
                                   data-mask-kind="email"
                                   data-index="@i" />

                            <input type="email"
                                   class="attr-input masked-contact-display attr-email-primary"
                                   data-mask-kind="email"
                                   data-index="@i"
                                   data-email-index="@i"
                                   autocomplete="email"
                                   maxlength="255"
                                   required
                                   placeholder="email@example.co.za" />

                            <span asp-validation-for="ContactInfos[i].Email"
                                  class="attr-field-error"></span>
                        </td>

                        <td class="attr-label">Confirm Email <span class="req">*</span></td>
                        <td>
                            <input type="email"
                                   class="attr-input attr-email-confirm"
                                   id="confirmEmail-@i"
                                   data-email-index="@i"
                                   autocomplete="off"
                                   maxlength="255"
                                   required
                                   placeholder="Re-enter email address" />

