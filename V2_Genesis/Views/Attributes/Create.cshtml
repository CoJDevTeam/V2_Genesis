                                        <input type="hidden" name="DrcVacantLands[@i].MaxRatePerSQM" />
                                        <input type="hidden" name="DrcVacantLands[@i].Rate" />
                                        <input type="hidden" name="DrcVacantLands[@i].VacantLandCost" />
                                        <td><button type="button" class="dyn-del-btn" onclick="delRow(this)"><i class="fa-solid fa-xmark"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="dyn-add-bar">
                        <button type="button" class="dyn-add-btn" onclick="addRow('body-drc-vacant', drcVacantTemplate)">
                            <i class="fa-solid fa-plus"></i> Add Land Entry
                        </button>
                    </div>
                </div>
            }

            @* ════════════════════════════════════════════════
       SECTION 5 — COMMENT
         ════════════════════════════════════════════════ *@
            <div class="attr-card">
                <div class="attr-title">
                    <i class="fa-solid fa-comment" style="color:var(--at-gold);margin-right:8px;"></i>
                    Section 4: Additional Comments
                </div>
                <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>
                <textarea asp-for="ClientComment" class="attr-textarea" rows="4"
                          placeholder="Please provide any additional information relevant to this property..."></textarea>
            </div>

            @* ════════════════════════════════════════════════
       SECTION 6 — EVIDENCE FILES
         ════════════════════════════════════════════════ *@
            <div class="attr-card ev-card">
                <div class="attr-title">
                    <i class="fa-solid fa-paperclip" style="color:var(--at-gold);margin-right:8px;"></i>
                    Section 5: Supporting Documents
                    <span class="ev-summary-badge" id="evSummaryBadge">0 files ready</span>
                </div>
                <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>

                <p class="ev-section-intro">
                    Attach anything that supports the information you've given above — for
                    example a title deed, building plan, recent photos, or a municipal
                    account. This isn't compulsory, but it can help the valuer understand
                    your property faster.
                </p>

                @if (ViewBag.RepRequired == true)
                {
                    <div class="ev-rep-notice">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <div>
                            <strong>Authorisation letter required</strong> — you told us
                            you're submitting as a representative, so we need the signed
                            letter from the registered owner authorising you to act on
                            their behalf.
                        </div>
                    </div>

                    <div class="ev-rep-upload" id="evRepUpload">
                        <div class="ev-rep-label">
                            <i class="fa-solid fa-file-signature"></i>
                            Authorisation letter
                            <span style="color:#e53e3e;">*</span>
                        </div>

                        <input asp-for="Files.RepLetter"
                               type="file"
                               id="evRepLetterInput"
                               class="ev-rep-input"
                               accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                               required />

                        <div class="ev-rep-file-status" id="evRepFileStatus">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            No file selected yet
                        </div>
                    </div>
                }

                <div class="ev-section-label">
                    <i class="fa-solid fa-folder-open"></i>
                    Other supporting documents <span class="ev-optional-tag">(optional)</span>
                </div>

                <div class="ev-type-panel">
                    <label for="evEvidenceType" class="ev-type-label">
                        Evidence Type <span class="req">*</span>
                    </label>

                    <select id="evEvidenceType" class="attr-select">
                        <option value="">-- Select evidence type --</option>
                        <option value="Property Photograph">Property Photograph</option>
                        <option value="Building Plan">Building Plan</option>
                        <option value="Valuation Report">Valuation Report</option>
                        <option value="Lease / Rental Information">Lease / Rental Information</option>
                        <option value="Financial Information">Financial Information</option>
                        <option value="Excel Schedule">Excel Schedule</option>
                        <option value="Supporting Document">Supporting Document</option>
                        <option value="Other">Other</option>
                    </select>

                    <div class="ev-type-help">
                        Select what you are uploading first, then add the file(s).
                        The selected evidence type will be shown next to every file added in that batch.
                    </div>
                </div>

                <div class="ev-dropzone" id="evDropzone" tabindex="0" role="button"
                     aria-label="Upload supporting evidence">
                    <div class="ev-dropzone-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
                    <div class="ev-dropzone-title">Drag files here to upload</div>
                    <div class="ev-dropzone-sub">
                        Allowed file types only: PDF (.pdf), Excel (.xls, .xlsx),
                        Images (.jpg, .jpeg, .png)
                    </div>
                    <button type="button" class="ev-browse-btn" id="evBrowseFiles">
                        <i class="fa-solid fa-folder-open"></i> Browse Files
                    </button>
                </div>

                <input type="file"
                       id="evFileInput"
                       name="Files.EvidenceFiles"
                       multiple
                       accept=".pdf,.xls,.xlsx,.jpg,.jpeg,.png" />

                @* Posted in the same order as Files.EvidenceFiles.
               This does not require a model change; the controller can read
               Request.Form["EvidenceTypes"] when storing document metadata. *@
                <div id="evEvidenceTypesHolder"></div>

                <div class="ev-counter">
                    <span id="evCountText">0 of 10 files added</span>
                    <div class="ev-counter-bar"><div class="ev-counter-fill" id="evCountFill"></div></div>
                </div>

                <div class="ev-file-list" id="evFileList"></div>

                <div class="ev-note">
                    <i class="fa-solid fa-circle-info"></i>
                    Allowed: PDF (.pdf), Excel (.xls, .xlsx), JPG/JPEG/PNG images
                    &nbsp;|&nbsp; Max 10 files &nbsp;|&nbsp; Max 20 MB per file
                </div>
            </div>

            @* ════════════════════════════════════════════════
       SECTION 7 — DECLARATION & SIGNATURE
         ════════════════════════════════════════════════ *@
            <div class="attr-card">
                <div class="attr-title">
                    <i class="fa-solid fa-signature" style="color:var(--at-gold);margin-right:8px;"></i>
                    Section 6: Declaration &amp; Signature
                </div>
                <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>

                <div class="attr-legal-box">
                    <p>I declare that the information submitted is true and correct to the best of my knowledge. I understand that submitting this information does not mean it is automatically accepted and that it is subject to review by the City of Johannesburg valuation team.</p>
                </div>

                <input asp-for="Declaration.SignaturePicture" type="hidden" id="signatureData" />

                <table class="attr-table">
                    <tr>
                        <td class="attr-label">I Accept <span style="color:#e53e3e;">*</span></td>
                        <td colspan="3">
                            <label style="display:flex;align-items:center;gap:10px;font-size:13px;cursor:pointer;font-family:'Poppins',sans-serif;">
                                <input asp-for="Declaration.DeclarationAccepted" type="checkbox" id="declAccepted"
                                       style="width:18px;height:18px;accent-color:#e6b000;" required />
                                I confirm that I have read, understood and accept this declaration.
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="attr-label">Capacity</td>
                        <td colspan="3">
                            <input class="attr-input" value="@declarationCapacityLabel" readonly
                                   style="background:var(--at-teal-pale);font-weight:700;color:var(--at-gold);" />
                        </td>
                    </tr>
                    <tr>
                        <td class="attr-label">Full Name <span style="color:#e53e3e;">*</span></td>
                        <td>
                            <input asp-for="Declaration.SignatureName" class="attr-input"
                                   placeholder="Type your full name" required />
                            <span asp-validation-for="Declaration.SignatureName" style="color:#e53e3e;font-size:12px;"></span>
                        </td>
                        <td class="attr-label">Date</td>
                        <td><input id="declDate" class="attr-input" readonly style="background:var(--at-teal-pale);" /></td>
                    </tr>
                </table>

                @if (isAdminCapture)
                {
                    <div id="capturer" style="display:flex;align-items:center;gap:14px;
                        background: #006570;
                        border:1.5px solid rgba(230,176,0,.4);border-radius:10px;
                        padding:14px 18px;margin:18px 14px;flex-wrap:wrap;">

                        <div style="width:42px;height:42px;border-radius:9px;flex-shrink:0;
                            background:rgba(230,176,0,.15);border:1.5px solid rgba(230,176,0,.4);
                            display:flex;align-items:center;justify-content:center;
                            color:#e6b000;font-size:18px;">
                            <i class="fa-solid fa-id-badge"></i>
                        </div>

                        <div style="flex:1;min-width:220px;">
                            <div style="font-size:9.5px;font-weight:700;letter-spacing:1.5px;
                                color:rgba(255,255,255,.4);text-transform:uppercase;margin-bottom:1px;">
                                Captured by Windows Authenticator
                            </div>

                            <div style="font-size:15px;font-weight:800;color:#fff;line-height:1.2;">
                                @adminFullName
                            </div>

                            @if (!string.IsNullOrWhiteSpace(adminPosition))
                            {
                                <div style="font-size:11.5px;color:rgba(230,176,0,.8);font-weight:600;margin-top:2px;">
                                    @adminPosition
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(adminWindowsUser))
                            {
                                <div style="font-size:10.5px;color:rgba(255,255,255,.4);margin-top:3px;
                                    font-family:monospace;overflow-wrap:anywhere;">
                                    Windows: @adminWindowsUser
                                </div>
                            }
                        </div>

                        <div style="display:flex;flex-direction:column;align-items:flex-end;
                            gap:3px;flex-shrink:0;">
                            <span style="font-size:9px;font-weight:700;letter-spacing:1.5px;
                                color:rgba(255,255,255,.35);text-transform:uppercase;">
                                SAP No.
                            </span>
                            <span style="font-size:14px;font-weight:800;color:#e6b000;font-family:monospace;">
                                @(!string.IsNullOrWhiteSpace(adminSapNumeric) ? adminSapNumeric : "Not available")
                            </span>
                        </div>
                    </div>

                    <div style="margin:-8px 14px 12px;font-size:11px;color:#64748b;
                        display:flex;align-items:flex-start;gap:7px;">
                        <i class="fa-solid fa-circle-info" style="color:#e6b000;margin-top:2px;"></i>
                        <span>
                            The Admin is assisting with capturing only. Client communication will use
                            the email and contact details supplied in this form.
                        </span>
                    </div>
                }

                <div style="padding:14px;">
                    <div style="font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.5px;
                        color:#1a1a1a;margin-bottom:10px;display:flex;align-items:center;gap:8px;
                        font-family:'Poppins',sans-serif;">
                        <i class="fa-solid fa-pen-nib" style="color:var(--at-gold);"></i>
                        Draw Signature Below <span style="color:#e53e3e;font-weight:400;">*</span>
                        <span style="font-weight:400;text-transform:none;font-size:11px;color:#888;margin-left:4px;">(mouse or finger)</span>
                    </div>
                    <div class="attr-sig-canvas-wrap">
                        <canvas id="sigCanvas" width="598" height="160" style="width:100%;height:160px;"></canvas>
                        <div class="attr-sig-line"></div>
                        <div class="attr-sig-hint">Sign here</div>
                    </div>
                    <div class="attr-sig-controls">
                        <button type="button" id="sigClearBtn" onclick="clearSignature()"
                                style="padding:6px 16px;border-radius:6px;background:#f7f7f7;
                            border:1px solid #d0d0d0;font-size:12px;font-weight:700;
                            cursor:pointer;font-family:inherit;">
                            <i class="fa-solid fa-rotate-left"></i> Clear
                        </button>
                        <span id="sigStatus" style="font-size:12px;color:#6b6b6b;font-family:'Poppins',sans-serif;">No signature drawn</span>
                    </div>
                </div>
            </div>

            @* ── Submit actions ── *@
            <div class="attr-actions">
                <a asp-action="Create" asp-controller="Attributes"
                       asp-route-formType="@Model.FormType"
                       class="btn-attr-secondary"
                       id="resetAttributeForm">
                    <i class="fa-solid fa-rotate-left"></i> Reset Form
                </a>
                <button type="submit" class="btn-attr-primary">
                    <i class="fa-solid fa-paper-plane"></i> Submit Attribute Information
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script asp-append-version="true" src="~/js/attribute-create.js"></script>
}
