@using Microsoft.AspNetCore.Http
@model V2_Genesis.Models.ViewModels.Attributes.AttributeSubmissionViewModel
@{
    ViewData["Title"] = "Attribute Property Submission";
    //Layout = "~/Views/Shared/_ClientLayout.cshtml";
    Layout = "~/Views/Shared/_Legend_Layout.cshtml";

    // Roll category -> the name in the category list (Rates Policy 2026/27),
    // e.g. "Public Service Infrastructure - Private" -> "Private Service
    // Infrastructure", "Farming" -> "Agricultural", so the dropdown preselects it.
    if (Model.ValuationDetails is not null)
    {
        Model.ValuationDetails.ValuationCategoryOnRoll =
            V2_Genesis.Helpers.RollCategories.Normalize(Model.ValuationDetails.ValuationCategoryOnRoll)
            ?? Model.ValuationDetails.ValuationCategoryOnRoll;
        Model.ValuationDetails.ActualUse =
            V2_Genesis.Helpers.RollCategories.Normalize(Model.ValuationDetails.ActualUse)
            ?? Model.ValuationDetails.ActualUse;
    }
    bool isRes = Model.FormType == "Residential";
    bool isSt = Model.FormType == "ResidentialST";
    bool isBus = Model.FormType == "BusinessCommercial";
    bool isDrc = Model.FormType == "DRCMethod";

    string formLabel = Model.FormType switch
    {
        "Residential" => "Residential",
        "ResidentialST" => "Residential — Sectional Title",
        "BusinessCommercial" => "Non-Residential / Business and Commercial",
        "DRCMethod" => "DRC Method",
        _ => "Attribute Submission"
    };
    string formIcon = Model.FormType switch
    {
        "Residential" => "fa-house",
        "ResidentialST" => "fa-building",
        "BusinessCommercial" => "fa-store",
        "DRCMethod" => "fa-calculator",
        _ => "fa-clipboard-list"
    };

    string declarationCapacity = ViewBag.Declaration?.ToString() ?? "Owner";
    string declarationCapacityLabel = declarationCapacity.Equals("Owner", StringComparison.OrdinalIgnoreCase)
        ? "Individual"
        : declarationCapacity;

    // Admins use the shared AdministrationEnquiries account for the capture
    // journey, while their real Windows/UserManagement identity is retained
    // in claims/session. These values are display-only; the POST action remains
    // responsible for obtaining the trusted SAP capturer value server-side.
    bool isAdminCapture =
        (ViewBag.IsAdmin as bool? ?? false)
        || User.IsInRole("Admin")
        || User.FindFirst("AdminAppEmail")?.Value?.Equals(
            "AdministrationEnquiries@Joburg.org.za",
            StringComparison.OrdinalIgnoreCase) == true
        || Context.Session.GetString("AdminAppEmail")?.Equals(
            "AdministrationEnquiries@Joburg.org.za",
            StringComparison.OrdinalIgnoreCase) == true
        || User.FindFirst("LoginType")?.Value?.Equals(
            "AdminWindows",
            StringComparison.OrdinalIgnoreCase) == true
        || !string.IsNullOrWhiteSpace(User.FindFirst("SAPNumber")?.Value);

    string adminFullName =
        User.FindFirst("FullName")?.Value
        ?? Context.Session.GetString("AdminFullName")
        ?? ViewBag.AdminFullName?.ToString()
        ?? "Admin User";

    string adminPosition =
        User.FindFirst("Position")?.Value
        ?? Context.Session.GetString("AdminPosition")
        ?? ViewBag.AdminPosition?.ToString()
        ?? string.Empty;

    string adminSapFull =
        User.FindFirst("SAPNumber")?.Value
        ?? Context.Session.GetString("AdminSapNumber")
        ?? ViewBag.SapFull?.ToString()
        ?? string.Empty;

    string adminSapNumeric =
        User.FindFirst("SAPNumeric")?.Value
        ?? Context.Session.GetString("AdminSapNumeric")
        ?? ViewBag.SapNumeric?.ToString()
        ?? string.Empty;

    if (string.IsNullOrWhiteSpace(adminSapNumeric)
        && !string.IsNullOrWhiteSpace(adminSapFull))
    {
        adminSapNumeric = new string(adminSapFull.Where(char.IsDigit).ToArray());
    }

    string adminWindowsUser =
        User.FindFirst("WindowsUser")?.Value
        ?? Context.Session.GetString("AdminWindowsUser")
        ?? ViewBag.AdminWindowsUser?.ToString()
        ?? string.Empty;
}

<link href="~/css/views/attribute-create.css" rel="stylesheet" asp-append-version="true" />




@* ── HERO ────────────────────────────────────────────────────────── *@
