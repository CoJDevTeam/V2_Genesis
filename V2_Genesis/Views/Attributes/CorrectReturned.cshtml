@using System.ComponentModel
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using System.Collections
@model V2_Genesis.Models.ViewModels.Attributes.ReturnedAttributeCorrectionViewModel
@{
    ViewData["Title"] = "Correct Attribute Submission";
   // Layout = "~/Views/Shared/_ClientLayout.cshtml";
    Layout = "~/Views/Shared/_Legend_Layout.cshtml";

    string formLabel = Model.FormType switch
    {
        "Residential" => "Residential",
        "ResidentialST" => "Residential — Sectional Title",
        "BusinessCommercial" => "Non-Residential / Business and Commercial",
        "DRCMethod" => "DRC Method",
        _ => "Attribute Submission"
    };

    string formIcon = Model.FormType switch
    {
        "Residential" => "fa-house",
        "ResidentialST" => "fa-building",
        "BusinessCommercial" => "fa-store",
        "DRCMethod" => "fa-calculator",
        _ => "fa-clipboard-list"
    };

    var excluded = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "AttrId", "AttrNo", "FormType", "PropertyId", "PremiseId", "UnitKey",
        "ValuationKey", "Sector", "RollType", "RollDescription", "SignaturePicture"
    };

    IEnumerable<PropertyInfo> EditableProperties(object source) => source.GetType()
        .GetProperties(BindingFlags.Instance | BindingFlags.Public)
        .Where(property => property.CanRead && property.CanWrite
                           && property.GetIndexParameters().Length == 0
                           && !excluded.Contains(property.Name)
                           && (property.PropertyType == typeof(string)
                               || property.PropertyType == typeof(bool)
                               || property.PropertyType == typeof(bool?)
                               || property.PropertyType == typeof(int)
                               || property.PropertyType == typeof(int?)
                               || property.PropertyType == typeof(decimal)
                               || property.PropertyType == typeof(decimal?)
                               || property.PropertyType == typeof(DateTime)
                               || property.PropertyType == typeof(DateTime?)));

    string Label(PropertyInfo property)
    {
        if (property.Name.Equals("LastName", StringComparison.OrdinalIgnoreCase))
            return "Surname";

        return property.GetCustomAttribute<DisplayAttribute>()?.GetName()
            ?? property.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName
            ?? System.Text.RegularExpressions.Regex
                .Replace(property.Name, "([a-z0-9])([A-Z])", "$1 $2")
                .Replace("_", " ");
    }

    string InputType(PropertyInfo property)
    {
        var type = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
        if (type == typeof(decimal) || type == typeof(int)) return "number";
        if (type == typeof(DateTime)) return "date";
        if (property.Name.Contains("Email", StringComparison.OrdinalIgnoreCase)) return "email";
        if (property.Name.Contains("Phone", StringComparison.OrdinalIgnoreCase)
            || property.Name.Contains("Cell", StringComparison.OrdinalIgnoreCase)) return "tel";
        return "text";
    }

    bool IsLongText(PropertyInfo property) =>
        property.Name.Contains("Address", StringComparison.OrdinalIgnoreCase)
        || property.Name.Contains("Comment", StringComparison.OrdinalIgnoreCase)
        || property.Name.Contains("Text", StringComparison.OrdinalIgnoreCase)
        || property.Name.Contains("Sources", StringComparison.OrdinalIgnoreCase)
        || property.Name.Contains("Financials", StringComparison.OrdinalIgnoreCase);

    List<(string Value, string Text)>? DropdownOptions(string prefix, string propertyName)
    {
        // Keep correction controls aligned with the choices on Attributes/Create.cshtml.
        if (prefix == "ValuationDetails"
            && propertyName is ("ValuationCategoryOnRoll" or "ActualUse"))
        {
            return V2_Genesis.Helpers.RollCategories.All.Select(c => (c, c)).ToList();
        }

        if (prefix == "ValuationDetails"
            && propertyName == "AlternateUsages")
        {
            return new()
            {
                ("Resi-Business", "Resi-Business"),
                ("Resi-Agri", "Resi-Agri"),
                ("Business-Industrial", "Business-Industrial"),
                ("Residential-Public Service", "Residential-Public Service"),
                ("Other Mixed Use", "Other Mixed Use")
            };
        }

        if (prefix == "SecondaryAttributes" && propertyName == "Storeys")
        {
            return new()
            {
                ("1", "1"),
                ("2", "2"),
                ("3", "3"),
                ("4", "4")
            };
        }

        if (prefix == "SecondaryAttributes" && propertyName == "Security")
        {
            return new()
            {
                ("High", "High"),
                ("Medium", "Medium"),
                ("Low", "Low"),
                ("None", "None")
            };
        }

        if (prefix == "SecondaryAttributes" && propertyName == "Noise")
        {
            return new()
            {
                ("Freeway", "Freeway"),
                ("Major Road", "Major Road"),
                ("Side Street", "Side Street"),
                ("Cul-de-sac", "Cul-de-sac"),
                ("Entertainment", "Entertainment")
            };
        }

        if (prefix == "SecondaryAttributes" && propertyName == "Topography")
        {
            return new()
            {
                ("Level", "Level"),
                ("Average", "Average"),
                ("Slope", "Slope"),
                ("Steep", "Steep")
            };
        }

        if (prefix == "SecondaryAttributes"
            && propertyName is ("Quality" or "Condition"))
        {
            // Residential Create page options.
            return new()
            {
                ("Excellent", "Excellent"),
                ("Good", "Good"),
                ("Average", "Average"),
                ("Poor", "Poor")
            };
        }

        if (prefix == "SecondaryAttributes" && propertyName == "STCondition")
        {
            // The Create page posts the numeric ST condition code.
            return new()
            {
                ("1", "Excellent"),
                ("2", "Good"),
                ("3", "Average"),
                ("4", "Fair"),
                ("5", "Poor")
            };
        }

        if ((prefix.StartsWith("BusinessBuildings[", StringComparison.Ordinal)
             || prefix.StartsWith("DrcBuildings[", StringComparison.Ordinal)
             || prefix.StartsWith("DrcImprovements[", StringComparison.Ordinal))
            && propertyName is ("Quality" or "Condition"))
        {
            // Business / DRC Create page options.
            return new()
            {
                ("Excellent", "Excellent"),
                ("Good", "Good"),
                ("Average", "Average"),
                ("Fair", "Fair"),
                ("Poor", "Poor")
            };
        }

        return null;
    }

    bool CanClientEdit(string prefix, string propertyName)
    {
        if (prefix == "PropertyDetails" || prefix == "Access"
            || prefix == "Calculations" || prefix == "DrcMarketValueDemolition")
            return false;

        if (prefix == "ValuationDetails")
            return propertyName is not ("OwnersTitleDeeds" or "OwnersFinancials");

        if (prefix.StartsWith("ContactInfos", StringComparison.Ordinal))
            return propertyName is not ("MaidenName" or "IDNumber" or "DateOfBirth"
                or "Gender" or "MaritalStatus" or "Citizenship" or "FaxNo"
                or "Interviewed" or "Comments");

        if (prefix == "PrimaryAttributes") return propertyName != "AdjustmentFactor";

        if (prefix.StartsWith("BusinessBuildings", StringComparison.Ordinal))
            return propertyName is "BuildingNr" or "Quality" or "Condition"
                or "YearBuilt" or "Storeys" or "GBA";

        if (prefix.StartsWith("BusinessSections", StringComparison.Ordinal))
            return propertyName is "BuildingNr" or "Usage" or "GBA" or "NLA" or "Rental";

        if (prefix == "BusinessGeneral") return propertyName == "UnutilisedLandExtent";

        if (prefix.StartsWith("DrcBuildings", StringComparison.Ordinal))
            return propertyName is "BuildingDescription" or "Quality"
                or "GrossBuildingArea" or "Condition";

        if (prefix.StartsWith("DrcImprovements", StringComparison.Ordinal))
            return propertyName is "ImprovementDescription" or "Quality"
                or "AreaUnit" or "Condition";

        if (prefix.StartsWith("DrcVacantLands", StringComparison.Ordinal))
            return propertyName is "Region" or "Area";

        if (prefix == "Declaration")
            return propertyName is "DeclarationAccepted" or "SignatureName";

        return true;
    }

    string FormatValue(object? value) => value switch
    {
        null => string.Empty,
        DateTime date => date.ToString("yyyy-MM-dd"),
        bool flag => flag ? "true" : "false",
        decimal number => number.ToString(System.Globalization.CultureInfo.InvariantCulture),
        _ => Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty
    };



    string NormaliseFieldCode(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        var result = new System.Text.StringBuilder();
        for (var i = 0; i < value.Length; i++)
        {
            var ch = value[i];
            if (!char.IsLetterOrDigit(ch))
            {
                if (result.Length > 0 && result[^1] != '_') result.Append('_');
                continue;
            }
            if (char.IsUpper(ch) && i > 0 && char.IsLower(value[i - 1]) && result[^1] != '_')
                result.Append('_');
            result.Append(char.ToUpperInvariant(ch));
        }
        return result.ToString().Trim('_');
    }

    string FieldCodeFor(string prefix, string propertyName)
    {
        var propertyCode = NormaliseFieldCode(propertyName);
        var rowMatch = System.Text.RegularExpressions.Regex.Match(prefix, @"^(?<name>[^\[]+)\[(?<index>\d+)\]$");
        if (!rowMatch.Success) return propertyCode;

        var rowNo = int.Parse(rowMatch.Groups["index"].Value) + 1;
        var rowPrefix = rowMatch.Groups["name"].Value switch
        {
            "BusinessBuildings" or "DrcBuildings" => "BUILDING",
            "BusinessSections" => "SECTION",
            "DrcImprovements" => "IMPROVEMENT",
            "DrcVacantLands" => "LAND",
            "ContactInfos" => "CONTACT",
            _ => NormaliseFieldCode(rowMatch.Groups["name"].Value)
        };

        return $"{rowPrefix}_{rowNo}_{propertyCode}";
    }

    V2_Genesis.Models.ViewModels.Attributes.ReturnedAttributeCorrectionFieldVm? CorrectionFor(
        string sectionCode,
        string prefix,
        string propertyName)
    {
        var fieldCode = FieldCodeFor(prefix, propertyName);
        return Model.Fields.FirstOrDefault(x =>
            string.Equals(NormaliseFieldCode(x.SectionCode), NormaliseFieldCode(sectionCode), StringComparison.OrdinalIgnoreCase)
            && string.Equals(NormaliseFieldCode(x.FieldCode), fieldCode, StringComparison.OrdinalIgnoreCase));
    }

    List<(string Prefix, object Data)> SourcesFor(string code)
    {
        var submission = Model.Submission;
        return code.ToUpperInvariant() switch
        {
            "PROPERTY_DETAILS" => new() { ("PropertyDetails", submission.PropertyDetails) },
            "VALUATION_DETAILS" => new() { ("ValuationDetails", submission.ValuationDetails) },
            "CONTACT_INFORMATION" => submission.ContactInfos
                .Select((item, index) => ($"ContactInfos[{index}]", (object)item)).ToList(),
            "ACCESS" or "ACCESS_INFORMATION" => new() { ("Access", submission.Access) },
            "PRIMARY_ATTRIBUTES" => new() { ("PrimaryAttributes", submission.PrimaryAttributes) },
            "SECONDARY_ATTRIBUTES" => new() { ("SecondaryAttributes", submission.SecondaryAttributes) },
            "BUSINESS_BUILDINGS" => submission.BusinessBuildings
                .Select((item, index) => ($"BusinessBuildings[{index}]", (object)item)).ToList(),
            "BUSINESS_SECTIONS" => submission.BusinessSections
                .Select((item, index) => ($"BusinessSections[{index}]", (object)item)).ToList(),
            "BUSINESS_GENERAL" => new() { ("BusinessGeneral", submission.BusinessGeneral) },
            "DRC_BUILDINGS" => submission.DrcBuildings
                .Select((item, index) => ($"DrcBuildings[{index}]", (object)item)).ToList(),
            "DRC_IMPROVEMENTS" => submission.DrcImprovements
                .Select((item, index) => ($"DrcImprovements[{index}]", (object)item)).ToList(),
            "DRC_VACANT_LAND" => submission.DrcVacantLands
                .Select((item, index) => ($"DrcVacantLands[{index}]", (object)item)).ToList(),
            "DRC_MARKET_VALUE" => new() { ("DrcMarketValueDemolition", submission.DrcMarketValueDemolition) },
            "CALCULATIONS" => new() { ("Calculations", submission.Calculations) },
            "DECLARATION" => new() { ("Declaration", submission.Declaration) },
            _ => new()
        };
    }
}

<link href="~/css/views/attribute-create.css" rel="stylesheet" asp-append-version="true" />

<div class="attr-hero">
    <div class="attr-hero-inner">
        <div class="attr-hero-left">
            <div class="attr-hero-logo">
                <img src="~/images/joburg_logo.png" alt="City of Johannesburg" />
            </div>
            <div>
                <div class="attr-hero-org">City of Johannesburg · Valuation Services</div>
                <div class="attr-hero-eyebrow">
                    <span></span>
                    Property Attributes · Returned by Valuer
                </div>
                <h1 class="attr-hero-title">
                    Property Attribute <em>Correction</em>
                </h1>
                <p class="attr-hero-sub">
                    <i class="fa-solid fa-@formIcon" style="font-size:11px;"></i>
                    @Html.Raw(formLabel)
                    <span class="attr-hero-sub-dot"></span>
                    Update only the fields selected by the valuer
                </p>
            </div>
        </div>
        <div class="attr-hero-right">
            <span class="attr-hero-badge">
                <i class="fa-solid fa-rotate-right"></i>
                @Model.AttrNo
            </span>
            @if (!string.IsNullOrWhiteSpace(Model.PropertyDescription))
            {
                <div class="attr-hero-prop">
                    <div class="attr-hero-prop-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <div>
                        <span class="attr-hero-prop-label">Property</span>
                        <span class="attr-hero-prop-value">@Model.PropertyDescription</span>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="attr-form-head">
        <span class="attr-form-head-label">Reference</span>
        <span class="attr-form-head-title">@Model.AttrNo · @Html.Raw(formLabel) · Correct and resubmit</span>
    </div>
</div>

<div class="attr-page">
    <form asp-controller="Attributes"
          asp-action="CorrectReturned"
          asp-route-attrId="@Model.AttrId"
          method="post"
          data-submission-loader
          data-submission-title="Resubmitting your Attribute correction..."
          data-submission-message="Please wait while the corrected Attribute submission is being saved and returned for review. Do not close or refresh this page.">
        @Html.AntiForgeryToken()

        <input asp-for="AttrId" type="hidden" />
        <input asp-for="AttrNo" type="hidden" />
        <input asp-for="FormType" type="hidden" />
        <input asp-for="Submission.FormType" type="hidden" />
        <input asp-for="Submission.AttrId" type="hidden" />
        <input asp-for="Submission.AttrNo" type="hidden" />

        <div asp-validation-summary="All" class="attr-validation-list"></div>

        @{
            var property = Model.Submission.PropertyDetails;
            string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "Not supplied" : value;
            string ShowNumber(object? value) => value == null ? "Not supplied" : Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture) ?? "Not supplied";
        }

        <div class="attr-card">
            <div class="attr-title">
                <i class="fa-solid fa-map-pin" style="color:var(--at-gold);margin-right:8px;"></i>
                Section 1: Property Details
            </div>
            <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>

            @if (!string.IsNullOrWhiteSpace(Model.PropertyDescription))
            {
                <div class="attr-prop-banner">
                    <div class="attr-prop-banner-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <div>
                        <span class="attr-prop-banner-label">Property Description</span>
                        <span class="attr-prop-banner-value">@Model.PropertyDescription</span>
                    </div>
                </div>
            }

            <div class="attr-section-title"><span class="num">1.1</span> Property Identification</div>
            <table class="attr-table">
                <tr>
                    <td class="attr-label">Reference Number</td>
                    <td><input class="attr-input" value="@Model.AttrNo" readonly /></td>
                    <td class="attr-label">Form Type</td>
                    <td><input class="attr-input" value="@formLabel" readonly /></td>
                </tr>
                <tr>
                    <td class="attr-label">H Area</td>
                    <td><input class="attr-input" value="@Show(property?.HArea)" readonly /></td>
                    <td class="attr-label">Data Controller</td>
                    <td><input class="attr-input" value="@Show(property?.DataController)" readonly /></td>
                </tr>
                <tr>
                    <td class="attr-label">Collection Block</td>
                    <td><input class="attr-input" value="@Show(property?.CollectionBlock)" readonly /></td>
                    <td class="attr-label">Data Collector</td>
                    <td><input class="attr-input" value="@Show(property?.DataCollector)" readonly /></td>
                </tr>
                <tr>
                    <td class="attr-label">SG Number</td>
                    <td><input class="attr-input" value="@Show(property?.SGNumber)" readonly /></td>
                    <td class="attr-label">Centroid</td>
                    <td><input class="attr-input" value="@Show(property?.Centroid)" readonly /></td>
                </tr>
                <tr>
                    <td class="attr-label">Erf</td>
                    <td><input class="attr-input" value="@Show(property?.Erf)" readonly /></td>
                    <td class="attr-label">Extent</td>
                    <td><input class="attr-input" value="@ShowNumber(property?.Extent)" readonly /></td>
                </tr>
                <tr>
                    <td class="attr-label">Sectional Title</td>
                    <td><input class="attr-input" value="@Show(property?.SectionalTitle)" readonly /></td>
                    <td class="attr-label">Land Use Financials</td>
                    <td><input class="attr-input" value="@Show(property?.LandUseFinancials)" readonly /></td>
                </tr>
                <tr>
                    <td class="attr-label">Municipality</td>
                    <td><input class="attr-input" value="@Show(property?.Municipality)" readonly /></td>
                    <td class="attr-label">Ward</td>
                    <td><input class="attr-input" value="@Show(property?.Ward)" readonly /></td>
                </tr>
                <tr>
                    <td class="attr-label">Township</td>
                    <td><input class="attr-input" value="@Show(property?.Township)" readonly /></td>
                    <td class="attr-label">Zoning</td>
                    <td><input class="attr-input" value="@Show(property?.Zoning)" readonly /></td>
                </tr>
                <tr>
                    <td class="attr-label">Sources</td>
                    <td><input class="attr-input" value="@Show(property?.Sources)" readonly /></td>
                    <td class="attr-label">Address</td>
                    <td><input class="attr-input" value="@Show(property?.Address)" readonly /></td>
                </tr>
            </table>
        </div>

        <div class="attr-card">
            <div class="attr-title"><i class="fa-solid fa-message" style="color:var(--at-gold);margin-right:8px;"></i> Valuer Correction Request</div>
            <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>
            <p><strong>Reason:</strong> @(string.IsNullOrWhiteSpace(Model.RevisionReason) ? "Correction requested by the valuer." : Model.RevisionReason)</p>
            @if (Model.RequestedAt.HasValue)
            {
                <p class="text-muted mb-0">Requested @Model.RequestedAt.Value.ToString("dd MMMM yyyy HH:mm") @(!string.IsNullOrWhiteSpace(Model.RequestedBy) ? $"by {Model.RequestedBy}" : "")</p>
            }
        </div>

        @foreach (var sec in Model.Sections)
        {
            var sources = SourcesFor(sec.Code);
            <div class="attr-card">
                <div class="attr-title"><i class="fa-solid fa-pen-to-square" style="color:var(--at-gold);margin-right:8px;"></i> @sec.Name</div>
                <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>
                @{
                    // The overall Valuer Correction Request is already displayed above.
                    // Only show a section comment when it is genuinely different from
                    // the overall return-to-client reason.
                    var showSectionComment =
                        !string.IsNullOrWhiteSpace(sec.Comment)
                        && !string.Equals(
                            sec.Comment.Trim(),
                            Model.RevisionReason?.Trim(),
                            StringComparison.OrdinalIgnoreCase);
                }

                @if (showSectionComment)
                {
                    <div class="alert alert-warning">
                        <strong>Section-specific valuer comment:</strong><br />
                        @sec.Comment
                    </div>
                }

                @if (sec.Code.Equals("EVIDENCE", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="alert alert-info">
                        Upload the corrected supporting evidence, then return to this page to resubmit.
                        <a href="/attributes/evidence?attrNo=@Model.AttrNo" target="_blank" class="btn btn-sm btn-dark ms-2">
                            <i class="fa-solid fa-paperclip"></i> Upload evidence
                        </a>
                    </div>
                }
                else if (sources.Count == 0)
                {
                    <div class="alert alert-info">This section is updated through its related form information.</div>
                }
                else
                {
                    @for (var sourceIndex = 0; sourceIndex < sources.Count; sourceIndex++)
                    {
                        var source = sources[sourceIndex];
                        if (sources.Count > 1)
                        {
                            <div class="attr-section-title"><span class="num">@(sourceIndex + 1)</span> Entry @(sourceIndex + 1)</div>
                        }
                        <div class="row g-3">
                            @foreach (var prop in EditableProperties(source.Data))
                            {
                                var correction = CorrectionFor(sec.Code, source.Prefix, prop.Name);
                                var name = $"Submission.{source.Prefix}.{prop.Name}";
                                var value = prop.GetValue(source.Data);
                                var formattedValue = FormatValue(value);
                                var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
                                var canEdit = CanClientEdit(source.Prefix, prop.Name);
                                var dropdownOptions = DropdownOptions(source.Prefix, prop.Name);

                                if (correction is null)
                                {
                                    @* Preserve every value that was NOT returned for correction.
                                       Some sections are saved as one object/list on POST, so omitting
                                       these values could otherwise overwrite unchanged client data. *@
                                    <input type="hidden"
                                           name="@name"
                                           value="@formattedValue" />
                                }
                                else
                                {
                                    <div class="col-12">
                                        <div class="attr-section-title">
                                            <span class="num"><i class="fa-solid fa-pen"></i></span>
                                            @correction.FieldLabel
                                        </div>

                                        <table class="attr-table">
                                            <tr>
                                                <td class="attr-label">City Value</td>
                                                <td>
                                                    <input class="attr-input"
                                                           value="@(string.IsNullOrWhiteSpace(correction.CityValue) ? "Not supplied" : correction.CityValue)"
                                                           readonly />
                                                </td>

                                                <td class="attr-label">Previously Submitted</td>
                                                <td>
                                                    <input class="attr-input"
                                                           value="@(string.IsNullOrWhiteSpace(correction.ClientValue) ? "Not supplied" : correction.ClientValue)"
                                                           readonly />
                                                </td>
                                            </tr>

                                            <tr>
                                                <td class="attr-label">Corrected Value</td>
                                                <td colspan="3">
                                                    @if (!canEdit)
                                                    {
                                                        <input type="hidden"
                                                               name="@name"
                                                               value="@formattedValue" />

                                                        <div class="form-control bg-light text-muted">
                                                            This field is read-only.
                                                        </div>
                                                    }
                                                    else if (dropdownOptions is not null)
                                                    {
                                                        <select class="attr-input attr-select"
                                                                id="@name"
                                                                name="@name">

                                                            @if (string.IsNullOrWhiteSpace(formattedValue))
                                                            {
                                                                <option value="" selected>-- Select --</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="">-- Select --</option>
                                                            }

                                                            @foreach (var option in dropdownOptions)
                                                            {
                                                                var selected =
                                                                    string.Equals(
                                                                        formattedValue,
                                                                        option.Value,
                                                                        StringComparison.OrdinalIgnoreCase)
                                                                    ||
                                                                    string.Equals(
                                                                        formattedValue,
                                                                        option.Text,
                                                                        StringComparison.OrdinalIgnoreCase);

                                                                if (selected)
                                                                {
                                                                    <option value="@option.Value" selected>@option.Text</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@option.Value">@option.Text</option>
                                                                }
                                                            }
                                                        </select>
                                                    }
                                                    else if (type == typeof(bool))
                                                    {
                                                        @* The create form captures these as Yes / No choices.
                                                           Keep the correction page compact while posting the same
                                                           true/false model value. *@
                                                        <select class="attr-input attr-select"
                                                                id="@name"
                                                                name="@name">
                                                            @if (string.Equals(formattedValue, "true", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <option value="true" selected>Yes</option>
                                                                <option value="false">No</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="true">Yes</option>
                                                                <option value="false" selected>No</option>
                                                            }
                                                        </select>
                                                    }
                                                    else if (IsLongText(prop))
                                                    {
                                                        <textarea class="attr-input"
                                                                  id="@name"
                                                                  name="@name"
                                                                  rows="3">@formattedValue</textarea>
                                                    }
                                                    else
                                                    {
                                                        <input class="attr-input"
                                                               id="@name"
                                                               name="@name"
                                                               type="@InputType(prop)"
                                                               step="@(InputType(prop) == "number" ? "any" : null)"
                                                               value="@formattedValue" />
                                                    }
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                }
                            }
                        </div>
                    }
                }
            </div>
        }

        <div class="attr-card">
            <div class="attr-title"><i class="fa-solid fa-comment-dots" style="color:var(--at-gold);margin-right:8px;"></i> Correction Summary</div>
            <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>
            <label asp-for="RevisionComment" class="form-label fw-bold">Explain what you corrected <span class="text-danger">*</span></label>
            <textarea asp-for="RevisionComment" class="attr-input" rows="4" maxlength="2000" required></textarea>
            <span asp-validation-for="RevisionComment" class="text-danger"></span>
        </div>

        <div class="attr-actions">
            <a href="/Dashboard?openRoll=attributes" class="btn-attr-secondary">
                <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
            </a>
            <button type="submit" class="btn-attr-primary">
                <i class="fa-solid fa-paper-plane"></i> Resubmit Corrected Information
            </button>
        </div>
    </form>
</div>
