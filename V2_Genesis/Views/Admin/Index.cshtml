@if (TempData["DuplicateLodgementError"] != null)
{
    <div class="duplicate-lodgement-alert"
         role="alert"
         aria-live="assertive">

        <div class="duplicate-alert-icon">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>

        <div class="duplicate-alert-content">

            <div class="duplicate-alert-heading">
                <span class="duplicate-alert-label">
                    Submission Blocked
                </span>

                <h3>
                    This submission already exists
                </h3>
            </div>

            <p class="duplicate-alert-message">
                @TempData["DuplicateLodgementError"]
            </p>


            @if (TempData["DuplicateReferenceNo"] != null ||
                 TempData["DuplicateStatus"] != null)
            {
                <div class="duplicate-alert-details">

                    @if (TempData["DuplicateReferenceNo"] != null)
                    {
                        <div class="duplicate-alert-detail">
                            <span>
                                Existing Reference
                            </span>

                            <strong>
                                @TempData["DuplicateReferenceNo"]
                            </strong>
                        </div>
                    }


                    @if (TempData["DuplicateStatus"] != null)
                    {
                        <div class="duplicate-alert-detail">
                            <span>
                                Current Status
                            </span>

                            <strong>
                                @TempData["DuplicateStatus"]
                            </strong>
                        </div>
                    }

                </div>
            }


            <div class="duplicate-alert-guidance">
                <i class="fa-solid fa-circle-info"></i>

                <span>
                    Please use the existing submission instead of
                    lodging another one. If you believe this is
                    incorrect, contact Valuation Services for assistance.
                </span>
            </div>

        </div>


        <button type="button"
                class="duplicate-alert-close"
                aria-label="Close duplicate submission warning"
                onclick="this.closest('.duplicate-lodgement-alert').remove()">

            <i class="fa-solid fa-xmark"></i>

        </button>

    </div>
}


@{
    // Keep these existing structures because the detail/table JavaScript below
    // still uses the family lookup. The data source remains exactly the same.
    var adminFamilies = Model.Rolls
        .Where(r => !r.IsQuery)
        .GroupBy(r => r.Main_Roll)
        .ToList();

    var adminQueryRolls = Model.Rolls
        .Where(r => r.IsQuery)
        .ToList();

    var adminFamilyLookup = adminFamilies.Select(fam =>
    {
        var head = fam.FirstOrDefault(r => r.IsGv) ?? fam.First();

        var membersOrdered = fam
            .OrderBy(r => r.Source == head.Source ? 0 : 1)
            .ThenBy(r => r.Source)
            .Select(r => new
            {
                source = r.Source,
                name = r.Name,
                shortName = r.Short
            })
            .ToList();

        return new
        {
            headSource = head.Source,
            members = membersOrdered
        };
    }).ToList();

    // ── Old-style Admin launcher ─────────────────────────────────────
    var adminSup4 = Model.Rolls.FirstOrDefault(x =>
        string.Equals(
            x.Source,
            "Objection_Supp4",
            StringComparison.OrdinalIgnoreCase));

    var adminQuery = Model.Rolls.FirstOrDefault(x =>
        x.IsQuery ||
        string.Equals(
            x.Source,
            "Objection_Query",
            StringComparison.OrdinalIgnoreCase));

    var adminPreviousSources = new[]
    {
        "Objection",
        "Objection_Supp1",
        "Objection_Supp2",
        "Objection_Supp3"
    };

    var adminPreviousRolls = Model.Rolls
        .Where(x =>
            adminPreviousSources.Contains(
                x.Source,
                StringComparer.OrdinalIgnoreCase))
        .OrderBy(x =>
            Array.FindIndex(
                adminPreviousSources,
                source => source.Equals(
                    x.Source,
                    StringComparison.OrdinalIgnoreCase)))
        .ToList();

    string AdminRollLabel(string source) => source switch
    {
        "Objection" => "General Valuation Roll 2023",
        "Objection_Supp1" => "Supplementary Roll 1",
        "Objection_Supp2" => "Supplementary Roll 2",
        "Objection_Supp3" => "Supplementary Roll 3",
        "Objection_Supp4" => "Supplementary Roll 4",
        _ => source
    };

    // ── Welcome hero + bell (same as the Client dashboard) ─────────
    var adminAnn = Model.Announcement;

    var adminDisplayName =
        !string.IsNullOrWhiteSpace(_adminFullName)
            ? _adminFullName
            : (Model.AdminEmail ?? "").Split('@')[0];

    var adminInitial =
        string.IsNullOrWhiteSpace(adminDisplayName)
            ? "A"
            : adminDisplayName.Substring(0, 1).ToUpperInvariant();

    var adminNoteUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    var adminNoteEmail =
        User.FindFirstValue(ClaimTypes.Email)
        ?? User.FindFirstValue(ClaimTypes.Name)
        ?? User.Identity?.Name
        ?? string.Empty;

    var adminUnreadCount =
        await NotificationService.GetUnreadCountAsync(
            adminNoteUserId, adminNoteEmail, true);

    var adminLatestNotifications =
        await NotificationService.GetLatestAsync(
            adminNoteUserId, adminNoteEmail, true, 10);

    // ── Admin team rule ─────────────────────────────────────────────
    // The objection period is always open for the admin team (late
    // objections CLO are captured internally). The appeal period
    // (Objection_MVD Appeal_Close_Date), the 48-hour evidence window, the
    // Section 51 closing date and the Section 78 review period apply to
    // everyone, also the admin team.
    string AdminClientPeriodText(string source)
    {
        var dates = Model.DatesFor(source);
        if (dates is null)
            return "no client dates set";

        var now = DateTime.Now;
        if (now < dates.OpenDate)
            return "opens " + dates.OpenDate.ToString("dd MMM yyyy");

        return now <= dates.VisibleUntil
            ? "open until " + dates.VisibleUntil.ToString("dd MMM yyyy HH:mm")
            : "closed on " + dates.VisibleUntil.ToString("dd MMM yyyy");
    }

    string AdminPublicPeriodStatus(string source)
    {
        var dates = Model.DatesFor(source);

        if (dates is null)
            return "ADMIN ACCESS";

        var now = DateTime.Now;

        if (now < dates.OpenDate)
            return "OPENING SOON";

        return now <= dates.VisibleUntil
            ? "OPEN"
            : "CLOSED";
    }
}

