<script>
    function toggleAdminLegacyArchive() {

        const body =
            document.getElementById(
                'admLegacyArchiveBody');

        const button =
            document.getElementById(
                'admLegacyArchiveToggle');

        const chevron =
            document.getElementById(
                'admLegacyArchiveChevron');

        if (!body || !button) {
            return;
        }

        const willOpen =
            body.hidden;

        body.hidden =
            !willOpen;

        button.setAttribute(
            'aria-expanded',
            willOpen ? 'true' : 'false');

        chevron?.classList.toggle(
            'is-open',
            willOpen);
    }

    function openAdminRollSource(source) {

        if (!source) {
            return;
        }

        const key =
            source.replace(/_/g, '');

        const familyTabs =
            document.getElementById(
                'cdFamilyTabs');

        if (familyTabs) {
            familyTabs.style.display = 'none';
            familyTabs.innerHTML = '';
        }

        const familyContext =
            document.getElementById(
                'cdFamilyContext');

        if (familyContext) {
            familyContext.style.display = 'none';
            familyContext.innerHTML = '';
        }

        if (typeof showAdminDetailArea === 'function') {
            showAdminDetailArea();
        }

        if (typeof showOnlyAdminSection === 'function') {
            showOnlyAdminSection(
                'adm-roll-' + key);
        }

        const body =
            document.getElementById(
                'rollbody-' + key);

        const chevron =
            document.getElementById(
                'chevron-' + key);

        const section =
            document.getElementById(
                'adm-roll-' + key);

        if (body) {
            body.classList.add('open');
        }

        if (chevron) {
            chevron.style.transform =
                'rotate(180deg)';
        }

        if (typeof initTablesInSection === 'function') {
            initTablesInSection(key);
        }

        section?.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
        });
    }

    document.addEventListener(
        'DOMContentLoaded',
        function () {

            const params =
                new URLSearchParams(
                    window.location.search);

            const openRoll =
                params.get('openRoll');

            if (!openRoll) {
                return;
            }

            const normalised =
                openRoll.toLowerCase();

            if (normalised === 'rebates') {

                const button =
                    document.querySelector(
                        'button[data-standalone-key="rebates"]');

                if (button &&
                    typeof openAdminStandalone === 'function') {

                    openAdminStandalone(button);
                }

                return;
            }

            if (normalised === 'attributes') {

                const button =
                    document.querySelector(
                        'button[data-standalone-key="attributes"]');

                if (button &&
                    typeof openAdminStandalone === 'function') {

                    openAdminStandalone(button);
                }

                return;
            }

            openAdminRollSource(
                openRoll);
        });
</script>

