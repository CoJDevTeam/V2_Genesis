                {
                    <span class="ann-days @adminAnn.DaysCss">
                        <i class="fa-solid fa-calendar-days"></i>
                        @adminAnn.DaysLeft @(adminAnn.DaysLeft == 1 ? "day" : "days") remaining
                    </span>
                }

            </div>
        </div>
    }

    <!-- ── Welcome hero — same as Client ───────────────────────── -->
    <div class="cd-hero">

        <div class="cd-welcome-inner">

            <div class="cd-welcome-left">

                <div class="cd-hero-avatar">
                    @adminInitial
                </div>

                <div>

