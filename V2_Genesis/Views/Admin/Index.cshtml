                     id="notificationPanel">

                    <div class="cd-notification-head">
                        <strong>Notifications</strong>
                        <span>@adminUnreadCount unread</span>
                    </div>

                    @if (!adminLatestNotifications.Any())
                    {
                        <div class="cd-notification-empty">
                            <i class="fa-solid fa-bell-slash"
                               style="font-size:24px;color:#ddd;display:block;margin-bottom:8px;"></i>
                            No notifications yet.
                        </div>
                    }
                    else
                    {
                        <div class="cd-notification-list">

                            @foreach (var note in adminLatestNotifications)
                            {
                                var noteType =
                                    string.IsNullOrWhiteSpace(note.NotificationType)
                                        ? "Info"
                                        : note.NotificationType;

                                <a class="cd-notification-item @(note.IsRead ? "" : "unread")"
                                   href="/notifications/@note.IDNotifications/open"
                                   title="Open @(note.Title ?? "notification")">

                                    <div class="cd-note-icon cd-note-@noteType.ToLower()">
                                        <i class="fa-solid @(noteType == "Success"
                                            ? "fa-circle-check"
                                            : noteType == "Warning"
                                                ? "fa-triangle-exclamation"
                                                : noteType == "Error"
                                                    ? "fa-circle-xmark"
                                                    : "fa-circle-info")"></i>
                                    </div>

                                    <div class="cd-note-body">
                                        <strong>@(note.Title ?? "Notification")</strong>
                                        <p>@note.Message</p>

                                        @if (!string.IsNullOrWhiteSpace(note.ReferenceNumber))
                                        {
                                            <span class="cd-note-ref">@note.ReferenceNumber</span>
                                        }

                                        <small>@note.CreatedDate.ToString("dd MMM yyyy HH:mm")</small>
                                    </div>

                                </a>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>

