                    <div class="cd-cta-chips">
                        <span class="cd-chip"><i class="fa-solid fa-person-cane"></i> Pensioner</span>
                        <span class="cd-chip"><i class="fa-solid fa-wheelchair"></i> Disability</span>
                        <span class="cd-chip"><i class="fa-solid fa-children"></i> Child-Headed</span>
                        <span class="cd-chip"><i class="fa-solid fa-hand-holding-heart"></i> PBO</span>
                    </div>
                </div>
            }
            else
            {
                
                <div style="padding:14px 22px; background:#f7f5f2;
                    border-bottom:1px solid #ede9e3;
                    display:flex; align-items:center;
                    justify-content:space-between; flex-wrap:wrap; gap:12px;">
                    <span style="font-size:13px; color:#645a50;">
                        <i class="fa-solid fa-circle-info" style="color:#89b7b2; margin-right:6px;"></i>
                        You have <strong>@rebateCount</strong>
                        rebate application@(rebateCount == 1 ? "" : "s") on record.
                    </span>
                    <a href="/Rebates/Index" class="cd-add-btn">
                        <i class="fa-solid fa-plus"></i> New Application
                    </a>
                </div>

                <div class="cd-widget">
                    <div class="cd-widget-toggle"
                         onclick="toggleWidget('rebates-applications')">
                        <div class="cd-widget-toggle-left">
                            <i class="fa-solid fa-file-pen"></i>
                            <h3>My Applications</h3>
                            <span class="cd-count-badge cd-count-orange">@rebateCount</span>
                        </div>
                        <i class="fa-solid fa-chevron-down cd-widget-chevron"
                           id="wchev-rebates-applications"></i>
                    </div>

                    <div class="cd-widget-body" id="widget-rebates-applications">
                        <div class="table-responsive">
                            <table class="cd-table table table-bordered table-hover"
                                  
                                   id="tbl-rebates-applications">
                                <thead>
                                    <tr>
                                        <th>Application No.</th>
                                        <th>Account Number</th>
                                        <th>Full Name</th>
                                        <th>Rebate Type</th>
                                        <th>Status</th>
                                        <th>Options</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Rebates)
                                    {
                                        <tr>
                                            <td><strong>@item.Rebate_No</strong></td>
                                            <td>@item.AccountNumber</td>
                                            <td>@item.FirstNames @item.Surname</td>
                                            <td>@item.Rebate_Type</td>
                                            <td>@Html.Raw(GetRebateStatusPill(item.Status))</td>
                                            <td>
                                                <div class="dropdown">
                                                    <button class="cd-action-btn dropdown-toggle"
                                                            data-bs-toggle="dropdown">
                                                        Actions
                                                    </button>
                                                    <ul class="dropdown-menu cd-action-menu">
                                                        <li>
                                                            <a class="dropdown-item"
                                                                   asp-controller="Rebates"
                                                                   asp-action="ViewData"
                                                                   asp-route-RebateType="@item.Rebate_Type"
                                                                   asp-route-RebateNo="@item.Rebate_No">
                                                                <i class="fa-solid fa-eye"></i>
                                                                View Form
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item"
                                                                   asp-controller="Rebates"
                                                                   asp-action="Download"
                                                                   asp-route-rebateNo="@item.Rebate_No">
                                                                <i class="fa-solid fa-file-pdf"
                                                                   style="color:#dc2626;"></i>
                                                                Download Acknowledgement
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            *@

        </div>
    </div>

    <!-- ── Attributes ───────────────────────────────────────────────── -->
    <div class="cd-roll-section legacy-roll-dashboard-partial" id="adm-roll-attributes">
        <div class="cd-roll-header cd-roll-attributes" onclick="toggleRoll('attributes')">
            <div class="cd-roll-header-left">
                <div class="cd-roll-icon"><i class="fa-solid fa-clipboard-list"></i></div>
                <div>
                    <h2 class="cd-roll-name">Property Attributes</h2>
                    <span class="cd-roll-short">Review and manage submitted property attributes</span>
                </div>
            </div>
            <div class="cd-roll-header-right">
                <span class="cd-roll-badge cd-badge-open">NEW</span>
                <i class="fa-solid fa-chevron-down cd-roll-chevron" id="chevron-attributes"></i>
            </div>
        </div>
        <div class="cd-roll-body" id="rollbody-attributes">
            @await Html.PartialAsync(
                "_AttributesDetailPartial",
                new V2_Genesis.Models.ViewModels.Dashboard.AttributesDetailViewModel
                {
                    AttrData = Model.AttributesData,
                    AttributesLinked = Model.AttributesLinked
                })

            @* Replaced by the shared client functionality above.
            <div class="cd-cta-card">
                <div class="cd-cta-icon cd-cta-icon-black">
                    <i class="fa-solid fa-clipboard-list"></i>
                </div>
                <div class="cd-cta-body">
                    <h3>Manage Property Attribute Submissions</h3>
                    <p>Review and process property attribute submissions from clients.</p>
                    <div class="cd-cta-actions">
                        <a href="/attributes/admin" class="cd-cta-btn cd-cta-btn-black">
                            <i class="fa-solid fa-list-check"></i> Review Submissions
                        </a>
                    </div>
                </div>
            </div>
            *@
        </div>
    </div>

</div>



@section Scripts {
    @* DataTables, Buttons, JSZip and pdfmake are loaded once by _Legend_Layout. *@
    <script>
        // Admin roll sections always stay open — clicking the header
        // never collapses the tables.
        function toggleRoll(key) {
            const body = document.getElementById('rollbody-' + key);
            if (!body) return;
            body.classList.add('open');
            initTablesInSection(key);
        }

        function toggleWidget(key) {
            const body    = document.getElementById('widget-' + key);
            const chevron = document.getElementById('wchev-' + key);
            if (!body) return;
            const isOpen = body.classList.toggle('open');
            if (chevron) chevron.style.transform = isOpen ? 'rotate(180deg)' : '';
            if (isOpen) {
                setTimeout(() => {
                    const tbl = body.querySelector('.cd-table');
                    if (tbl) initDataTable('#' + tbl.id);
                }, 100);
            }
        }

        function initTablesInSection(key) {
            document.querySelectorAll('#rollbody-' + key + ' .cd-table').forEach(t => {
                initDataTable('#' + t.id);
            });
        }

        // Same table behaviour as the Client detail pages:
        // full columns on desktop, first column + "+" details on phones.
        function isPhoneWidth() {
            return window.matchMedia('(max-width: 767.98px)').matches;
        }

        function initDataTable(selector) {
            const table = document.querySelector(selector);
            if (!table) return;

            const phone = isPhoneWidth();
            const mode = phone ? 'phone' : 'desktop';

            if ($.fn.DataTable.isDataTable(selector)) {
                if (table.dataset.dtMode === mode) {
                    $(selector).DataTable().columns.adjust();
                    return;
                }

                $(selector).DataTable().destroy();
                table.classList.remove('dtr-inline', 'collapsed');
                table.querySelectorAll('th, td').forEach(function (cell) {
                    cell.classList.remove('dtr-control', 'all', 'none');
                    cell.style.display = '';
                });
                table.querySelectorAll('tr.child').forEach(function (row) { row.remove(); });
                table.style.width = '';
            }

            table.dataset.dtMode = mode;

            $(selector).DataTable({
                responsive: phone
                    ? { details: { type: 'inline', target: 'td.dtr-control' } }
                    : false,
                autoWidth  : false,
                dom        : '<"cd-dt-top"lf>rt<"cd-dt-bottom"ip>',
                pageLength : 10,
                lengthMenu : [[5, 10, 25, 50, -1], [5, 10, 25, 50, 'All']],
                language: {
                    search: 'Search:',
                    searchPlaceholder: 'Search this table…',
                    lengthMenu: 'Show _MENU_ entries',
                    emptyTable: 'No records found.',
                    zeroRecords: 'No matching records found.'
                },
                columnDefs: phone
                    ? [
                        { targets: 0, className: 'dtr-control all', responsivePriority: 1 },
                        { targets: '_all', className: 'none' },
                        { targets: -1, orderable: false }
                    ]
                    : [
                        { targets: -1, orderable: false }
                    ]
            });
        }

        // Rebuild visible tables when the screen crosses the phone size.
        let admResizeTimer = null;
        window.addEventListener('resize', function () {
            clearTimeout(admResizeTimer);
            admResizeTimer = setTimeout(function () {
                document
                    .querySelectorAll('.cd-roll-body.open .cd-widget-body.open .cd-table, .cd-roll-body.open > .table-responsive .cd-table')
                    .forEach(function (t) { if (t.id) initDataTable('#' + t.id); });
            }, 150);
        });

        // ── Notification bell — same as Client ──────────────────────
        function initNotificationBell() {
            const bellBtn = document.getElementById('notificationBellBtn');
            const panel = document.getElementById('notificationPanel');

            bellBtn?.addEventListener('click', function (event) {
                event.stopPropagation();
                panel?.classList.toggle('open');
            });

            panel?.addEventListener('click', function (event) {
                event.stopPropagation();
            });

            document.addEventListener('click', function () {
                panel?.classList.remove('open');
            });
        }

        // ── Main tiles: family (GV23 + Sup1-4) and standalone
        //    (Query / Rebates / Attributes). Everything is already
        //    rendered inline — no AJAX involved, just show/hide what's
        //    already in the DOM, same as toggleRoll does for one section. ──
        function openAdminFamily(tileEl) {
            let members;
            try {
                members = JSON.parse(tileEl.dataset.members);
            } catch (e) {
                return;
            }

            const context = document.getElementById('cdFamilyContext');
            if (context && members.length) {
                context.style.display = 'flex';
                context.innerHTML =
                    '<i class="fa-solid fa-landmark"></i>' +
                    '<div><strong>' + members[0].name + '</strong>' +
                    '<span>' + members.length + ' roll' + (members.length === 1 ? '' : 's') + ' in this family &middot; pick one below</span></div>';
            }

            renderAdminFamilyTabs(members, tileEl.dataset.headSource);
            showAdminDetailArea();
            selectAdminFamilyTab(tileEl.dataset.headSource, members);
        }

        function renderAdminFamilyTabs(members, activeSource) {
            const wrap = document.getElementById('cdFamilyTabs');
            if (!wrap) return;

            wrap.dataset.members = JSON.stringify(members);
            wrap.style.display = 'flex';

            wrap.innerHTML = members.map(function (m) {
                const isActive = m.source === activeSource;
                return '<button type="button" class="cd-fam-tab' + (isActive ? ' active' : '') + '" ' +
                    'data-source="' + m.source + '" onclick="selectAdminFamilyTabFromEl(this)">' +
                    '<span class="cd-fam-tab-name">' + m.shortName + '</span>' +
                    (isActive ? '<span class="cd-fam-tab-current"><i class="fa-solid fa-circle-check"></i> Viewing</span>' : '') +
                    '</button>';
            }).join('');
        }

        function selectAdminFamilyTabFromEl(el) {
            const wrap = document.getElementById('cdFamilyTabs');
            let members = [];
            try {
                members = JSON.parse(wrap.dataset.members || '[]');
            } catch (e) {}
            selectAdminFamilyTab(el.dataset.source, members);
        }

        function selectAdminFamilyTab(source, members) {
            const wrap = document.getElementById('cdFamilyTabs');

            if (wrap) {
                wrap.querySelectorAll('.cd-fam-tab').forEach(function (tab) {
                    const isActive = tab.dataset.source === source;
                    tab.classList.toggle('active', isActive);

                    const marker = tab.querySelector('.cd-fam-tab-current');
                    if (isActive && !marker) {
                        const span = document.createElement('span');
                        span.className = 'cd-fam-tab-current';
                        span.innerHTML = '<i class="fa-solid fa-circle-check"></i> Viewing';
                        tab.appendChild(span);
                    } else if (!isActive && marker) {
                        marker.remove();
                    }
                });
            }

            const targetKey = source.replace(/_/g, '');

            // Only the selected family member's whole section (header +
            // body) stays visible — every other roll section in the
            // detail area is hidden, not just collapsed.
            showOnlyAdminSection('adm-roll-' + targetKey);

            members.forEach(function (m) {
                const key  = m.source.replace(/_/g, '');
                const body = document.getElementById('rollbody-' + key);
                const chevron = document.getElementById('chevron-' + key);

                if (!body) return;

                const shouldOpen = key === targetKey;
                body.classList.toggle('open', shouldOpen);
                if (chevron) chevron.style.transform = shouldOpen ? 'rotate(180deg)' : '';
            });

            initTablesInSection(targetKey);

            const section = document.getElementById('adm-roll-' + targetKey);
            if (section) {
                setTimeout(function () {
                    section.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 60);
            }
        }

        // ── Hide every roll section in the detail area except the one
        //    the client actually asked to see. ────────────────────────
        function showOnlyAdminSection(sectionId) {
            const detailArea = document.getElementById('cdDetailArea');
            if (!detailArea) return;

            detailArea.querySelectorAll('.cd-roll-section').forEach(function (section) {
                section.style.display = section.id === sectionId ? '' : 'none';
            });
        }

        function openAdminStandalone(tileEl) {
            const wrap = document.getElementById('cdFamilyTabs');
            if (wrap) {
                wrap.style.display = 'none';
                wrap.innerHTML = '';
            }

            const context = document.getElementById('cdFamilyContext');
            if (context) {
                context.style.display = 'none';
                context.innerHTML = '';
            }

            showAdminDetailArea();

            const key = tileEl.dataset.standaloneKey;
            const body = document.getElementById('rollbody-' + key);
            const chevron = document.getElementById('chevron-' + key);
            const section = document.getElementById('adm-roll-' + key);

            showOnlyAdminSection('adm-roll-' + key);

            if (body && !body.classList.contains('open')) {
                body.classList.add('open');
                if (chevron) chevron.style.transform = 'rotate(180deg)';
            }

            if (key) initTablesInSection(key);

            if (section) {
                setTimeout(function () {
                    section.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 60);
            }
        }

        function showAdminDetailArea() {
            const tileBody = document.getElementById('cdTileBody');
            const detailArea = document.getElementById('cdDetailArea');
            if (!tileBody || !detailArea) return;

            tileBody.style.display = 'none';
            detailArea.style.display = '';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function closeAdminDetail() {
            const tileBody = document.getElementById('cdTileBody');
            const detailArea = document.getElementById('cdDetailArea');
            if (!tileBody || !detailArea) return;

            detailArea.style.display = 'none';
            tileBody.style.display = '';
        }

        // Reopen the exact Admin workspace after returning from a shared action.
        function openAdminRollFromQueryString() {
            const params = new URLSearchParams(window.location.search);
            const openRoll = params.get('openRoll');

            if (!openRoll) return;

            const key = openRoll.toLowerCase();
            if (key !== 'rebates' && key !== 'attributes') return;

            const tile = document.querySelector(
                '.cd-tile[data-standalone-key="' + key + '"]'
            );

            if (tile) openAdminStandalone(tile);

            window.history.replaceState(
                {},
                document.title,
                window.location.pathname
            );
        }

        function logAction(action, rollSource, entityRef) {
            fetch('/admin/log-action', {
                method : 'POST',
                headers: {
                    'Content-Type'             : 'application/json',
                    'RequestVerificationToken' : document.querySelector(
                        'input[name="__RequestVerificationToken"]')?.value ?? ''
                },
                body: JSON.stringify({ action, rollSource, entityRef })
            }).catch(() => {});
        }

        document.addEventListener('DOMContentLoaded', function () {
            initNotificationBell();
            openAdminRollFromQueryString();

            // Auto-init first roll's tables
            document.querySelectorAll('.cd-roll-body.open').forEach(body => {
                const key = body.id.replace('rollbody-', '');
                initTablesInSection(key);
            });
            document.querySelectorAll('.cd-roll-body.open').forEach(body => {
                const key     = body.id.replace('rollbody-', '');
                const chevron = document.getElementById('chevron-' + key);
                if (chevron) chevron.style.transform = 'rotate(180deg)';
            });
        });
    </script>
}