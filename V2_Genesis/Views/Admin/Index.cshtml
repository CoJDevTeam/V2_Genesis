                        <span></span>
                        Administration
                        &nbsp;·&nbsp;
                        Valuation Services
                    </div>

                    <h1 class="cd-welcome-name">
                        Welcome back,&nbsp;<em>@adminDisplayName</em>
                        <span class="cd-welcome-wave">👋</span>
                    </h1>

                    <p class="cd-welcome-sub">
                        @if (!string.IsNullOrWhiteSpace(_adminPosition))
                        {
                            @_adminPosition
                            <span class="cd-welcome-dot"></span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_sapNumeric))
                        {
                            <text>SAP @_sapNumeric</text>
                            <span class="cd-welcome-dot"></span>
                        }
                        City of Johannesburg Valuation Portal
