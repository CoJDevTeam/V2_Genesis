@model V2_Genesis.Models.Results.AdminFormViewResult
@using System.Text.Json
@using System.Text.Json.Serialization

@{
    //Layout = "~/Views/Shared/_ClientLayout.cshtml";
    Layout = "~/Views/Shared/_Legend_Layout.cshtml";
    ViewData["Title"] = "Submitted Form View";

    var formItem = Model.Items.FirstOrDefault();

    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = null
    };

    var formJson = JsonSerializer.Serialize(formItem, jsonOptions);
    var section78Json = JsonSerializer.Serialize(Model.Section78, jsonOptions);
}
@section Styles{
<link href="~/css/views/admin-form-view.css" rel="stylesheet" asp-append-version="true" />
}


<div class="fv-hero">
    <div class="fv-hero-inner">

        <!-- Left: logo + title -->
        <div class="fv-hero-left">
            <div class="fv-hero-logo">
                <img src="~/images/joburg_logo.png" alt="City of Johannesburg" />
            </div>
            <div>
                <div class="fv-hero-org">City of Johannesburg · Property Branch: Valuation Services</div>
                <div class="fv-hero-eyebrow">
                    <span></span>
                    @(Model.IsQuery ? "Section 78 Query" : "Objection / Appeal") &nbsp;·&nbsp; Submitted Form View
                </div>
                <h1 class="fv-hero-title" id="fv-hero-form-title">
                    @(Model.IsQuery ? "Section 78 Query" : "Valuation")
                    <em id="fv-hero-form-type">Form</em>
                </h1>
                <p class="fv-hero-sub">
                    <i class="fa-solid fa-eye" style="color:rgba(255,255,255,.35);font-size:11px;"></i>
                    Read-only view
                    <span class="fv-hero-sub-dot"></span>
                    GV23 / Supplementary Valuation Roll
                    <span class="fv-hero-sub-dot"></span>
                    1 July 2023 – 30 June 2027
                </p>
            </div>
        </div>

        <!-- Right: form type badge + property pill -->
        <div class="fv-hero-right">
            <span class="fv-hero-badge" id="fv-hero-badge">
                <i class="fa-solid fa-file-pen"></i>
                <span id="fv-hero-badge-text">Objection Form</span>
            </span>
            <span class="fv-hero-badge read-only">
                <i class="fa-solid fa-lock"></i> Read Only
            </span>
            <div class="fv-hero-prop" id="fv-hero-prop" style="display:none;">
                <div class="fv-hero-prop-icon">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
                <div>
                    <span class="fv-hero-prop-label">Property</span>
                    <span class="fv-hero-prop-value" id="fv-hero-prop-value">—</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Reference pills row -->
    <div class="fv-hero-refs" id="fv-hero-refs">
        <span class="fv-hero-ref-pill" id="fv-ref-objno" style="display:none;">
            <i class="fa-solid fa-hashtag"></i>
            <span id="fv-ref-objno-label">Objection No.</span>
            <strong id="fv-ref-objno-val">—</strong>
        </span>
        <span class="fv-hero-ref-pill" id="fv-ref-owner" style="display:none;">
