<script>
    document.addEventListener("DOMContentLoaded", function () {
        var data = typeof adminFormData !== "undefined" ? adminFormData : null;
        if (!data) return;

        // Form type
        var isAppeal = data.AppealStat === "True" || data.AppealStat === true;
        var isQuery  = @(Model.IsQuery ? "true" : "false");

        var typeText = isQuery ? "Section 78 Query"
                     : isAppeal ? "Appeal Form"
                     : "Objection Form";

        var titleEm = isQuery ? "Query"
                    : isAppeal ? "<em style='color:#e6b000'>Appeal</em>"
                    : "<em style='color:#e6b000'>Objection</em>";

        var icon = isQuery ? "fa-magnifying-glass-chart"
                 : isAppeal ? "fa-gavel"
                 : "fa-file-pen";

        document.getElementById("fv-hero-badge-text").textContent = typeText;
        document.getElementById("fv-hero-form-type").innerHTML = titleEm;
        document.querySelector("#fv-hero-badge i").className = "fa-solid " + icon;

        // Property description
        var prop = data.PropertyDesc || data.Property_Desc || data.OldPropertyDescription || "";
        if (prop) {
            document.getElementById("fv-hero-prop-value").textContent = prop;
            document.getElementById("fv-hero-prop").style.display = "flex";
        }

        // Reference pills
        function showPill(id, val, labelId, label) {
            if (!val) return;
            var el = document.getElementById(id);
            if (el) {
                el.style.display = "flex";
                if (labelId && label) {
                    var lbl = document.getElementById(labelId);
                    if (lbl) lbl.textContent = label;
                }
                var valEl = document.getElementById(id + "-val");
                if (valEl) valEl.textContent = val;
            }
        }

        var objLabel = isQuery ? "Query No." : isAppeal ? "Appeal No." : "Objection No.";
        showPill("fv-ref-objno", data.ObjectionNo || data.Objection_No, "fv-ref-objno-label", objLabel);
        showPill("fv-ref-owner", data.OwnerName || data.Owner_Name, null, null);
        showPill("fv-ref-roll",  data.RollSource || data.RollDisplayName, null, null);

        var mv = data.OldMarketValue || data.Old_Market_Value || data.MarketValue || "";
        if (mv) {
            var num = parseFloat(mv.toString().replace(/[^0-9.]/g, ""));
            if (!isNaN(num) && num > 0) {
                mv = "R " + num.toLocaleString("en-ZA", { maximumFractionDigits: 0 });
            }
        }
        showPill("fv-ref-mv", mv, null, null);
        showPill("fv-ref-cat", data.OldCategory || data.Old_Category, null, null);
    });
</script>

