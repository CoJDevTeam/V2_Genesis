@{
    ViewData["Title"] = "Search Enquiry";
    Layout = "~/Views/Shared/_Legend_Layout.cshtml";
    var gvList = ViewBag.GvList as List<V2_Genesis.Models.GvList> ?? new();
    var towns = V2_Genesis.Helpers.NaturalSort.Order(ViewBag.Townships as List<string>);
    var schemes = ViewBag.Schemes as List<string> ?? new();
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" />
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/admin-search.css" rel="stylesheet" asp-append-version="true" />
}

<div class="adms-page">

    <div class="adms-hero">
        <div class="adms-hero-inner">
            <div class="adms-hero-icon">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <div>
                <h1>Search Enquiry</h1>
                <p>Find any objection, appeal, query, review or Attributes submission</p>
            </div>
            <a href="/admin" class="adms-hero-back">
                <i class="fa-solid fa-arrow-left"></i> Dashboard
            </a>
        </div>
    </div>

    <div class="adms-body">

        @if (TempData["SearchError"] is string searchError)
        {
            <div class="adms-err">
                <i class="fa-solid fa-circle-xmark"></i> @searchError
            </div>
        }

        <div class="adms-tab-bar">
            <button class="adms-tab active" id="tab-ref"
                    onclick="switchTab('ref')">
                <i class="fa-solid fa-hashtag"></i>
                By Reference Number
            </button>
            <button class="adms-tab" id="tab-prop"
                    onclick="switchTab('prop')">
                <i class="fa-solid fa-map-location-dot"></i>
                By Property Description
            </button>
        </div>

        <div class="adms-pane active" id="pane-ref">
            <div class="adms-card">
                <div class="adms-card-head">
                    <i class="fa-solid fa-hashtag" style="color:#e6b000;"></i>
                    <h3>Search by Reference Number</h3>
                    <p>Objection No / Appeal No / Query No / Review No / Attribute No</p>
                </div>
                <div class="adms-card-body">
                    <form method="post" action="/admin/search/ref"
                          id="refSearchForm"
                          onsubmit="handleSubmit(event,this,'refBtn')">
                        @Html.AntiForgeryToken()

                        <div class="adms-roll-strip">
                            <label><i class="fa-solid fa-layer-group"></i> Roll:</label>
                            <select name="rollSource" class="adms-roll-select">
                                <option value="">All Rolls</option>
                                @foreach (var r in gvList.Where(r => !r.IsQuery && r.Source != "Objection_Supp5"))
                                {
                                    <option value="@r.Source">@r.Short — @r.Name</option>
                                }
                            </select>
                        </div>

                        <div class="adms-field adms-field-full" style="margin-bottom:16px;">
                            <label class="adms-label" for="refNo">
                                <i class="fa-solid fa-file-pen"></i>
                                Reference Number
                            </label>
                            <input type="text" name="refNo" id="refNo"
                                   class="adms-input"
                                   placeholder="e.g. GV23-1234 | APP-GV23-1234 | GV23-QUE-123 | ATTR-GV23-19"
                                   autocomplete="off" />
                            <p style="font-size:11px;color:#9aa3af;margin:4px 0 0;">
                                The system identifies Objections, Appeals, Queries, Reviews and Attributes automatically.
                            </p>
                        </div>

                        <button type="submit" class="adms-submit" id="refBtn">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            Search by Reference
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="adms-pane" id="pane-prop">
            <div class="adms-card">
                <div class="adms-card-head">
                    <i class="fa-solid fa-map-location-dot" style="color:#e6b000;"></i>
                    <h3>Search by Property Description</h3>
                    <p>Township · ERF · Address · Scheme · Unit</p>
                </div>
                <div class="adms-card-body">
                    <form method="post" action="/admin/search/property"
                          onsubmit="handleSubmit(event,this,'propBtn')">
                        @Html.AntiForgeryToken()

                        <div class="adms-roll-strip">
                            <label><i class="fa-solid fa-layer-group"></i> Roll:</label>
                            <select name="rollSource" class="adms-roll-select">
                                <option value="">All Rolls</option>
                                @foreach (var r in gvList.Where(r => !r.IsQuery && r.Source != "Objection_Supp5"))
                                {
                                    <option value="@r.Source">@r.Short — @r.Name</option>
                                }
                            </select>
                        </div>

                        <div class="adms-grid">
                            <div class="adms-field adms-field-full">
                                <label class="adms-label" for="TownName">
                                    <i class="fa-solid fa-map-pin"></i> Township
                                </label>
                                <select name="TownName" id="TownName" class="adms-input coj-township-select" required>
                                    <option value="">— Select Township (required) —</option>
                                    @foreach (var t in towns)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>

                            <div class="adms-field">
                                <label class="adms-label" for="Stand">
                                    <i class="fa-solid fa-hashtag"></i> ERF / Stand No.
                                </label>
                                <input type="text" name="Stand" id="Stand"
                                       class="adms-input" placeholder="e.g. 1234" />
                            </div>

                            <div class="adms-field">
                                <label class="adms-label" for="Address">
                                    <i class="fa-solid fa-road"></i> Street Address
                                </label>
                                <input type="text" name="Address" id="Address"
                                       class="adms-input" placeholder="e.g. 123 Main Street" />
                            </div>

                            <div class="adms-field">
                                <label class="adms-label" for="Scheme">
                                    <i class="fa-solid fa-building"></i> Scheme Name
                                </label>
                                <select name="Scheme" id="Scheme" class="adms-input">
                                    <option value="">— Select Scheme (optional) —</option>
                                    @foreach (var s in schemes)
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                            </div>

                            <div class="adms-field">
                                <label class="adms-label" for="Unit">
                                    <i class="fa-solid fa-door-open"></i> Unit No.
                                </label>
                                <input type="text" name="Unit" id="Unit"
                                       class="adms-input" placeholder="e.g. 5" />
                            </div>
                        </div>

                        <button type="submit" class="adms-submit" id="propBtn">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            Search by Property
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script>
        function switchTab(tab) {
        ['ref','prop'].forEach(function(t) {
        document.getElementById('tab-'  + t).classList.toggle('active', t === tab);
        document.getElementById('pane-' + t).classList.toggle('active', t === tab);
        });
        }

        function handleSubmit(e, form, btnId) {
        var inputs = form.querySelectorAll('input[type="text"], select');
        var hasValue = false;
        inputs.forEach(function(el) {
        if (el.name !== 'rollSource' && el.name !== '__RequestVerificationToken'
        && el.value.trim()) hasValue = true;
        });
        if (!hasValue) {
        e.preventDefault();
        showErr(form, 'Please enter at least one search field.');
        return;
        }
        var btn = document.getElementById(btnId);
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Searching…';
        btn.disabled = true;
        }

        // Opened from a notification: /admin/search?reference=X&rollSource=Y
        // Fill in the reference and run the search straight away so the
        // admin lands on the record the notification is about.
        document.addEventListener('DOMContentLoaded', function () {
        var params = new URLSearchParams(window.location.search);
        var reference = (params.get('reference') || '').trim();
        if (!reference) return;

        var form = document.getElementById('refSearchForm');
        var input = document.getElementById('refNo');
        if (!form || !input) return;

        switchTab('ref');
        input.value = reference;

        var roll = params.get('rollSource');
        var select = form.querySelector('select[name="rollSource"]');
        if (roll && select &&
        Array.prototype.some.call(select.options, function (o) { return o.value === roll; })) {
        select.value = roll;
        }

        // Don't re-run the search if the admin comes back to this page.
        window.history.replaceState({}, document.title, window.location.pathname);

        var btn = document.getElementById('refBtn');
        if (btn) {
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Searching…';
        btn.disabled = true;
        }

        form.submit();
        });

        function showErr(form, msg) {
        var ex = form.querySelector('.adms-err');
        if (ex) ex.remove();
        var d = document.createElement('div');
        d.className = 'adms-err';
        d.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> ' + msg;
        form.insertBefore(d, form.firstChild);
        setTimeout(function() { d.remove(); }, 5000);
        }
    </script>
}