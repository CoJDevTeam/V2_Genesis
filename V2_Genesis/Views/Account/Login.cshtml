@model V2_Genesis.Models.ViewModels.Account.LoginViewModel
@using Microsoft.AspNetCore.Mvc.ModelBinding
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
    var siteKey = ViewBag.RecaptchaSiteKey as string ?? "";
    var pendingLink = ViewBag.PendingLink as V2_Genesis.Helpers.PendingPropertyLink;
}

<link href="~/account/login.css" rel="stylesheet" asp-append-version="true" />

<div class="login-page">
    <div class="login-wrap">

        <!-- ═══ LEFT PANEL ═══ -->
        <div class="login-left">
            <div class="login-brand">
                <div class="login-brand-mark">
                    <img src="~/images/joburg_logo.png"
                         class="reg-brand-logo"
                         alt="City of Johannesburg Logo" />
                </div>
                <div>
                    <div class="login-brand-name">City of Johannesburg Valuation </div>
                    <div class="login-brand-sub">Portal</div>
                </div>
            </div>

            <h1 class="login-headline">
                Your property,<br /><span>your rights.</span>
            </h1>
            <p class="login-desc">
                The official City of Johannesburg Valuation Portal. Access the General Valuation Roll,
                lodge objections, appeals, track submissions and manage your property information —
                securely and transparently.
            </p>

            <div class="login-features">
                <div class="login-feat"><i class="fa-solid fa-shield-halved"></i> Secure &amp; Authenticated</div>
                <div class="login-feat"><i class="fa-solid fa-magnifying-glass"></i> Search the Valuation Roll</div>
                <div class="login-feat"><i class="fa-solid fa-file-pen"></i> Submit Property Attributes</div>
                <div class="login-feat"><i class="fa-solid fa-chart-line"></i> Track All Your Cases</div>
            </div>

            <div class="login-badge">
                <span class="login-badge-dot"></span>
                GVR2023
            </div>
        </div>

        <!-- ═══ RIGHT PANEL ═══ -->
        <div class="login-right">
            <div class="login-form-card">
                <h2 class="login-title">Welcome back</h2>
                <p class="login-subtitle">Sign in to your portal account</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="val-summary">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        @Html.ValidationSummary(false, null, new { @class = "mb-0" })
                    </div>
                }

                @if (TempData["ResetSuccess"] != null)
                {
                    <div class="alert alert-success">
                        <i class="fa-solid fa-circle-check"></i>
                        Your password has been reset. You can now sign in with your new password.
                    </div>
                }

                @if (pendingLink is not null)
                {
                    <div class="login-pending-link" role="status"
                         style="display:flex;gap:10px;align-items:flex-start;background:#fff8e1;border:1px solid #e6b000;border-left:4px solid #e6b000;border-radius:10px;padding:12px 14px;margin-bottom:16px;font-size:13px;color:#1e3a40;">
                        <i class="fa-solid fa-link" style="color:#b58900;margin-top:3px;"></i>
                        <div>
                            <strong>Finish linking your property</strong><br />
                            Sign in and we will link
                            <strong>@(pendingLink.PropertyDescription ?? "the property you selected")</strong>
                            @if (!string.IsNullOrWhiteSpace(pendingLink.RollName))
                            {
                                <text>(@pendingLink.RollName)</text>
                            }
                            to your account straight away.
                            <div style="margin-top:6px;">
                                <a href="/property/pending-link/dismiss?returnUrl=/login"
                                   style="color:#5a5a5a;font-size:12px;">Not now – forget this property</a>
                            </div>
                        </div>
                    </div>
                }

                <form asp-action="Login" asp-controller="Account" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <!-- Email -->
                    <div class="f-group">
                        <label class="f-label" asp-for="Email">Email Address <em>*</em></label>
                        <div class="f-wrap">
                            <i class="fa-solid fa-envelope f-icon"></i>
                            <input asp-for="Email" class="f-input" type="email"
                                   placeholder="yourname@email.com"
                                   autocomplete="email" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="f-err"></span>
                    </div>

                    <!-- Password -->
                    <div class="f-group">
                        <div class="login-pw-row">
                            <label class="f-label" asp-for="Password">Password <em>*</em></label>
                            <a href="/forgot-password" class="login-forgot">Forgot password?</a>
                        </div>
                        <div class="f-wrap">
                            <i class="fa-solid fa-lock f-icon"></i>
                            <input asp-for="Password" id="loginPw" class="f-input"
                                   type="password" placeholder="Your password"
                                   autocomplete="current-password"
                                   style="padding-right:2.6rem" />
                            <button type="button" class="f-eye" onclick="togglePw('loginPw',this)">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="f-err"></span>
                    </div>

                    <!-- Remember me -->
                    <label class="chk-wrap" style="margin-bottom:20px;">
                        <input asp-for="RememberMe" type="checkbox" />
                        <span class="chk-label">Keep me signed in for 8 hours</span>
                    </label>

                    <!-- reCAPTCHA v2 -->
                   @*  <div class="recaptcha-wrap">
                        <div class="g-recaptcha" data-sitekey="@siteKey"></div>
                    </div>
 *@

                    <div class="recaptcha-wrap">
                        <div id="recaptchaContainer"></div>
                    </div>
                    <div id="recaptchaError" class="f-err" role="alert" style="display:none;margin:-6px 0 14px;"></div>
                    <button type="submit" class="login-submit">
                        <i class="fa-solid fa-right-to-bracket"></i> Sign In
                    </button>
                </form>

                <div class="login-register-link">
                    Don't have an account?
                    <a href="/register@(string.IsNullOrWhiteSpace(ViewBag.ReturnUrl as string) ? "" : "?returnUrl=" + Uri.EscapeDataString((string)ViewBag.ReturnUrl))">Register here</a>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function togglePw(id, btn) {
            const inp = document.getElementById(id);
            const ico = btn.querySelector('i');

            inp.type = inp.type === 'password' ? 'text' : 'password';
            ico.className = inp.type === 'password'
                ? 'fa-solid fa-eye'
                : 'fa-solid fa-eye-slash';
        }

        let recaptchaWidgetId = null;

        function showCaptchaError(msg) {
            const box = document.getElementById('recaptchaError');
            if (!box) return;
            box.textContent = msg || '';
            box.style.display = msg ? 'block' : 'none';
        }

        window.onRecaptchaLoad = function () {
            const container = document.getElementById('recaptchaContainer');
            if (!container) return;

            const isSmall = window.matchMedia('(max-width: 480px)').matches;

            recaptchaWidgetId = grecaptcha.render('recaptchaContainer', {
                sitekey: '@siteKey',
                size: isSmall ? 'compact' : 'normal',
                callback: function () { showCaptchaError(''); },
                'expired-callback': function () {
                    showCaptchaError('The reCAPTCHA expired. Please tick "I\'m not a robot" again.');
                }
            });
        };

        // Do not post the form without a reCAPTCHA answer (the server
        // checks it again with Google — this only gives a quick message).
        document.addEventListener('DOMContentLoaded', function () {
            const container = document.getElementById('recaptchaContainer');
            const form = container ? container.closest('form') : null;
            if (!form) return;

            form.addEventListener('submit', function (e) {
                let answer = '';
                try {
                    if (window.grecaptcha && recaptchaWidgetId !== null)
                        answer = grecaptcha.getResponse(recaptchaWidgetId);
                } catch (_) { }

                if (!answer) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    showCaptchaError(window.grecaptcha
                        ? 'Please tick "I\'m not a robot" before signing in.'
                        : 'The reCAPTCHA could not load. Check your internet connection and refresh the page.');
                    container.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }, true);
        });
    </script>

    <script src="https://www.google.com/recaptcha/api.js?onload=onRecaptchaLoad&render=explicit" async defer></script>
}
